/-- **Each of the 12 traps is a trap**, from the kernel check of each. -/
theorem farWalls_check : farWalls.all WTrap.check = true := by
  simp only [farWalls, List.all_cons, List.all_nil, Bool.and_true,
    far12_41_check, far12_42_check, far12_43_check, far12_44_check, far12_45_check, far12_46_check, far12_47_check,

    (h : ∀ t : Nat, T ≤ t → Rule30Prize.center t = (wordOf 17 0b01010111111111111).getD ((t + shift) % 17) false) :
    False :=
  column_not_01010111111111111 single 0 rfl (fun x hx => decide_eq_false (by omega)) 0 T shift fun t ht => by
    rw [evolve_single_center, h t ht]


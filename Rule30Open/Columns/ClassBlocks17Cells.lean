/-- **No column repeats 01010111111111111.** In the orbit of a row with a leftmost 1, no column repeats the block
`01010111111111111`, from any time `T` on and read from any phase. -/
theorem column_not_01010111111111111 (init : Int → Bool) (m : Int) (hm : init m = true)
    (hz : ∀ x : Int, x < m → init x = false) (k : Int) (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → evolve init t k = (wordOf 17 0b01010111111111111).getD ((t + shift) % 17) false) : False :=
  class_column init m hm hz cls01010111111111111 cls01010111111111111_valid k T shift fun t ht => by
    rw [h t ht]
    show _ = bit (wordOf 17 0b01010111111111111) ((t + shift) % (wordOf 17 0b01010111111111111).length)
    rw [bit_eq_getD, Rule30StripCertificateTable.wordOf_length]

/-- **The center column does not repeat 01010111111111111**, from any time `T` on and read from any phase. -/

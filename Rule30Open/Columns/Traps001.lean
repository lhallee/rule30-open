theorem trap001c_not_absorption_some : ¬ WTrap.AbsorptionSome [t001W, trap001fifteen, trap001b] := by
  refine not_absorption_some_fwd _ trap001c trap001c_closed (by decide) ?_
  simp only [List.mem_cons, List.not_mem_nil, or_false]
  rintro C (rfl | rfl | rfl)
  · exact ⟨cert_trap001c_t001W, rfl, rfl, by decide, by decide,
      cert_trap001c_t001W_holds, cert_trap001c_t001W_avoids⟩
  · exact ⟨cert_trap001c_trap001fifteen, rfl, rfl, by decide, by decide,
      cert_trap001c_trap001fifteen_holds, cert_trap001c_trap001fifteen_avoids⟩
  · exact ⟨cert_trap001c_trap001b, rfl, rfl, by decide, by decide,
      cert_trap001c_trap001b_holds, cert_trap001c_trap001b_avoids⟩

/-- **Entry into `t001` or `trap001fifteen` is false**: the right half of state 0 of `trap001c` enters neither. -/
theorem traps001_pair_not_absorption : ¬ WTrap.AbsorptionSome [t001W, trap001fifteen] := fun h =>
  trap001c_not_absorption_some (h.mono (by
    intro C hC
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hC ⊢
    rcases hC with rfl | rfl
    · exact Or.inl rfl
    · exact Or.inr (Or.inl rfl)))

/-- The four traps for `001`. -/
def traps001 : List WTrap := [t001W, trap001fifteen, trap001b, trap001c]

/-- **`001` reduced to entry into one of the four traps.** -/
theorem traps001_excludes (hA : WTrap.AbsorptionSome traps001) :
    ¬ Rule30StripCertificates.EventuallyWord Rule30EtherThree.w001 := by
  refine absorption_some_excludes _ traps001 ?_ ?_ hA <;>
    simp only [traps001, List.mem_cons, List.not_mem_nil, or_false] <;> rintro C (rfl | rfl | rfl | rfl)
  · rfl
  · rfl
  · rfl
  · rfl
  · exact t001W_check
  · exact trap001fifteen_check
  · exact trap001b_check
  · exact trap001c_check

/-- **Entry into some trap of the block** (a `Prop`): every finitely supported right half driven by the block, from
any phase, eventually has its first cells in a state of some checked trap of the block, with the label of the right
phase. No list of traps, however long, is needed. -/
def WTrap.AbsorptionAny (b : List Bool) : Prop :=
  ∀ (x : Nat → Bool) (n : Nat), (∀ p, n < p → x p = false) → ∀ φ : Nat, ∃ C : WTrap, C.b = b ∧ C.check = true ∧
    ∃ t1 i, i < C.n ∧ (t1 + φ) % C.b.length = C.lab i % C.b.length ∧
      Rule30EtherThree.EncF (Rule30Ether.drv (fun t => C.b.getD ((t + φ) % C.b.length) false) x) C.K t1 0 (C.st i)

/-- **Entry into some checked trap of the block excludes it** as a tail of the center column, for every transient, in
the kit's form `Rule30StripCertificates.EventuallyWord`. -/
theorem absorption_any_excludes (b : List Bool) (hA : WTrap.AbsorptionAny b) :
    ¬ Rule30StripCertificates.EventuallyWord b := by
  rintro ⟨T, hT⟩
  have hfin : ∀ p, T < p → (fun p : Nat => Rule30Jen.cell T (p : Int)) p = false :=
    fun p hp => Rule30Diagonals.cell_eq_false_of_gt T p (by omega)
  obtain ⟨C, hCb, hC, h⟩ := hA (fun p => Rule30Jen.cell T (p : Int)) T hfin 0
  exact entry_excludes C hC T (by rw [hCb]; exact hT) h

/-- **`001` reduced to entry into some trap of `001`.** -/
theorem not_eventually_001_of_absorption_any (hA : WTrap.AbsorptionAny Rule30EtherThree.w001) :
    ¬ Rule30StripCertificates.EventuallyWord Rule30EtherThree.w001 :=
  absorption_any_excludes _ hA

end Rule30Open

/-!
# Four traps for `001`, pairwise apart, and the kit's `AbsorptionT t001` is false

The kit reduces the word `001` to entry into its trap `t001` (`Rule30EtherThree.AbsorptionT`), 47 cells with labels
modulo 21, and states that entry as open. Here are three more traps for `001`, each a set of windows that no move
leaves, with the cell beside the center a function of the label at the white phases: `trap001fifteen` of
[WordTraps](WordTraps.md), 52 cells with labels modulo 15, and `trap001b` and `trap001c`, 144 and 304 cells with labels
modulo 21, the locks of two blocks of period 21 carried to the center. No state of any of the four, cut to the width
of another, is a state of the other whose label reads the same phase. A right half that starts in one stays in it and
never enters another, so entry into any one of them, or into one of any three, is false, the kit's `AbsorptionT t001`
among them. Entry into one of the four, or into some checked trap of `001`, still excludes `001`.

* `t001W`, `absorptionT_t001_iff`: the kit's trap with its own packed tables, read as a trap of WordTraps, and the
  kit's `AbsorptionT t001` as its `WTrap.Absorption`, by definition.
* `not_absorptionT_t001`, `trap001fifteen_not_absorption`: entry into `t001` alone, and into `trap001fifteen` alone, is
  false, by `not_absorption_wide` and `not_absorption` of MissedTraps.
* `never_enters_fwd`, `not_absorption_some_fwd`: a closed set that avoids, for each trap of a list, a set of windows
  holding that trap's states cut to it refutes entry into one of them (`WTrap.AbsorptionSome` of TrapPairs).
  `WTrap.AbsorptionSome.mono`: entry into one of a list gives entry into one of any list that contains it.
* `trap001b`, `trap001c` with their checks; the sets `cert_<S>_<C>` with `_holds` and `_avoids`; and
  `<S>_not_absorption_some`: for each of the four, entry into one of the other three is false.
  `traps001_pair_not_absorption`: entry into `t001` or `trap001fifteen` is false.
* `traps001`, `traps001_excludes`: entry into one of the four excludes `001`. `WTrap.AbsorptionAny`,
  `absorption_any_excludes`: entry into some checked trap of a block, the weakest hypothesis of the kind, excludes the
  block; `not_eventually_001_of_absorption_any` for `001`.

The natural-language argument is `Traps001.md`, beside this file.
-/

@[expose] public section

-- Sequential elaboration: the kernel checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Rule30Open

open Ruliology.CellularAutomata BitGame

/-- The kit's trap `t001` as a trap of WordTraps: the block `001`, 47 cells, labels modulo 21, and the kit's packed
tables of windows, labels and successors. -/
def t001W : WTrap :=
  { b := Rule30EtherThree.w001, K := 47, m := 21, n := Rule30EtherThree.t001_n, lb := Rule30EtherThree.t001_lb,
    ib := Rule30EtherThree.t001_ib, u := Rule30EtherThree.t001_u, R := Rule30EtherThree.t001_R,
    L := Rule30EtherThree.t001_L, S := Rule30EtherThree.t001_S }

/-- **The kit's statement is entry into `t001W`**, by definition. -/
theorem absorptionT_t001_iff : Rule30EtherThree.AbsorptionT Rule30EtherThree.t001 ↔ t001W.Absorption := Iff.rfl

theorem t001W_check : t001W.check = true := by decide +kernel

theorem t001W_closed : t001W.closedCheck = true := by decide +kernel

theorem trap001fifteen_closed : trap001fifteen.closedCheck = true := by decide +kernel

/-- No state of `trap001fifteen`, cut to 47 cells, is a state of `t001` whose label reads the same phase. -/
theorem fifteen_apart_t001 : trap001fifteen.apartWide t001W = true := by decide +kernel

/-- No state of `trap001fifteen`, cut to 47 cells, is a state of `t001` whose label reads the same phase: the same
separation in the form `not_absorption` takes, with `t001` the closed set. -/
theorem t001_apart_fifteen : t001W.apart trap001fifteen = true := by decide +kernel

/-- **The kit's `AbsorptionT t001` is false.** The right half whose first 52 cells are state 0 of `trap001fifteen`,
white beyond, driven by `001` from the phase of that state's label, keeps them in `trap001fifteen` and never has its
first 47 cells in a state of `t001`. -/
theorem not_absorptionT_t001 : ¬ Rule30EtherThree.AbsorptionT Rule30EtherThree.t001 := fun h =>
  not_absorption_wide t001W trap001fifteen trap001fifteen_closed rfl (by decide) fifteen_apart_t001 (by decide)
    (absorptionT_t001_iff.mp h)

/-- **Entry into `trap001fifteen` is false.** The right half whose first 47 cells are state 0 of `t001` never enters
it. -/
theorem trap001fifteen_not_absorption : ¬ trap001fifteen.Absorption :=
  not_absorption trap001fifteen t001W t001W_closed rfl (by decide) t001_apart_fifteen (by decide)

/-- **The right half of state 0 of a closed set never enters a trap whose states, cut to a set of windows, it
avoids**: the step of `not_absorption_fwd` for one right half, `x`, and one drive, `c`, given by their values. -/
theorem never_enters_fwd (C S : WTrap) (T : WinSet) (hS : S.closedCheck = true) (hb : S.b = C.b)
    (hTb : T.b = C.b) (hTS : T.K ≤ S.K) (hTC : T.K ≤ C.K) (hin : T.holds C = true) (hav : T.avoids S = true)
    (h0 : 0 < S.n) (x c : Nat → Bool) (hx : ∀ q, x q = (decide (1 ≤ q) && (S.st 0).testBit (q - 1)))
    (hc : ∀ t, c t = C.b.getD ((t + S.lab 0) % C.b.length) false) (t1 i : Nat) (hi : i < C.n)
    (hph : (t1 + S.lab 0) % C.b.length = C.lab i % C.b.length)
    (hr : Rule30EtherThree.EncF (Rule30Ether.drv c x) C.K t1 0 (C.st i)) : False := by
  unfold WTrap.closedCheck at hS
  rw [Bool.and_eq_true, decide_eq_true_eq] at hS
  obtain ⟨hm, hall⟩ := hS
  have hdvd : S.b.length ∣ S.m := Nat.dvd_of_mod_eq_zero hm
  have hok : ∀ j, j < S.n → S.lab j < S.m ∧ S.edgeOK j false = true ∧ S.edgeOK j true = true := by
    intro j hj
    have h := Rule30EtherThree.allBelowT_spec hall j hj
    unfold WTrap.closedOK at h
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    exact ⟨h.1.1, h.1.2, h.2⟩
  have hedge : ∀ j, j < S.n → ∀ z : Bool, S.nxt j z < S.n ∧
      S.st (S.nxt j z) = GameMask.move S.K (col S.b (S.lab j)) z (S.st j) ∧
      S.lab (S.nxt j z) = (S.lab j + 1) % S.m := by
    intro j hj z
    have h : S.edgeOK j z = true := by
      cases z
      · exact (hok j hj).2.1
      · exact (hok j hj).2.2
    unfold WTrap.edgeOK at h
    simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
    exact ⟨h.1.1, h.1.2, h.2⟩
  have hlt : ∀ j, S.st j < 2 ^ S.K := fun j => Nat.mod_lt _ (Nat.two_pow_pos _)
  -- The first `S.K` cells of the half stay in `S`.
  have inv : ∀ s, ∃ j, j < S.n ∧ Rule30EtherThree.EncF (Rule30Ether.drv c x) S.K s 0 (S.st j) ∧
      S.lab j = (S.lab 0 + s) % S.m := by
    intro s
    induction s with
    | zero =>
      refine ⟨0, h0, ⟨hlt 0, fun k hk => ?_⟩, by rw [Nat.add_zero, Nat.mod_eq_of_lt (hok 0 h0).1]⟩
      rw [Rule30Ether.drv_init c x (0 + 1 + k) (by omega), hx, decide_eq_true (by omega), Bool.true_and,
        show 0 + 1 + k - 1 = k by omega]
    | succ s ih =>
      obtain ⟨j, hj, henc, hlab⟩ := ih
      obtain ⟨hn, hst, hl⟩ := hedge j hj (Rule30Ether.drv c x s (0 + 1 + S.K))
      refine ⟨_, hn, ?_, ?_⟩
      · have hcol : col S.b (S.lab j) = Rule30Ether.drv c x s 0 := by
          rw [Rule30Ether.drv_col0, hc]
          unfold col
          rw [bit_eq_getD, hlab, Nat.mod_mod_of_dvd _ hdvd, hb, Nat.add_comm (S.lab 0) s]
        rw [hst, GameMask.move_eq, hcol]
        exact Rule30EtherThree.encF_step (Rule30Ether.drv_isR30 c x) henc
      · rw [hl, hlab, Nat.mod_add_mod, Nat.add_assoc]
  obtain ⟨j, hj, henc, hlab⟩ := inv t1
  -- The state of the trap and that state of `S`, both cut to `T.K` cells, agree, with labels of the same phase.
  have hcut : C.st i % 2 ^ T.K = S.st j % 2 ^ T.K := by
    apply Nat.eq_of_testBit_eq
    intro k
    rw [Nat.testBit_mod_two_pow, Nat.testBit_mod_two_pow]
    by_cases hk : k < T.K
    · rw [decide_eq_true hk, Bool.true_and, Bool.true_and, hr.2 k (by omega), henc.2 k (by omega)]
    · rw [decide_eq_false hk, Bool.false_and, Bool.false_and]
  have hphase : C.lab i % T.b.length = S.lab j % T.b.length := by
    rw [hTb, hlab, Nat.mod_mod_of_dvd _ (by rw [← hb]; exact hdvd), ← hph, Nat.add_comm t1 (S.lab 0)]
  obtain ⟨k, hk, hwin⟩ := T.mem_spec (Rule30EtherThree.allBelowT_spec hin i hi)
  rw [hcut, hphase] at hwin
  rw [hphase] at hk
  have h := Rule30EtherThree.allBelowT_spec (Rule30EtherThree.allBelowT_spec hav j hj) k hk
  simp [hwin] at h

/-- **A closed set that avoids every trap of a list refutes entry into one of them.** If `S` is a closed set of
windows and, for each trap `C` of the list, some set of windows no wider than either holds the states of `C` cut to
it and is avoided by `S`, the right half whose first `S.K` cells are state `0` of `S`, white beyond, driven from the
phase of that state's label, never enters any of them. -/
theorem not_absorption_some_fwd (Cs : List WTrap) (S : WTrap) (hS : S.closedCheck = true) (h0 : 0 < S.n)
    (hcert : ∀ C ∈ Cs, ∃ T : WinSet, S.b = C.b ∧ T.b = C.b ∧ T.K ≤ S.K ∧ T.K ≤ C.K ∧ T.holds C = true ∧
      T.avoids S = true) : ¬ WTrap.AbsorptionSome Cs := by
  intro hA
  have hlt : S.st 0 < 2 ^ S.K := Nat.mod_lt _ (Nat.two_pow_pos _)
  have hfin : ∀ q, S.K < q → (fun q => decide (1 ≤ q) && (S.st 0).testBit (q - 1)) q = false := by
    intro q hq
    show (decide (1 ≤ q) && (S.st 0).testBit (q - 1)) = false
    rw [Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le hlt (Nat.pow_le_pow_right (by decide) (by omega))),
      Bool.and_false]
  obtain ⟨C, hC, t1, i, hi, hph, hr⟩ := hA _ S.K hfin (S.lab 0)
  obtain ⟨T, hb, hTb, hTS, hTC, hin, hav⟩ := hcert C hC
  exact never_enters_fwd C S T hS hb hTb hTS hTC hin hav h0 _ _ (fun _ => rfl) (fun _ => rfl) t1 i hi hph hr

/-- **Entry into one of a list gives entry into one of any list that contains it.** -/
theorem WTrap.AbsorptionSome.mono {Cs Ds : List WTrap} (h : ∀ C ∈ Cs, C ∈ Ds) (hA : WTrap.AbsorptionSome Cs) :
    WTrap.AbsorptionSome Ds := by
  intro x n hx φ
  obtain ⟨C, hC, e⟩ := hA x n hx φ
  exact ⟨C, h C hC, e⟩


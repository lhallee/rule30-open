/-- **No column repeats 000000000100000001.** In the orbit of a row with a leftmost 1, no column repeats the block
`000000000100000001`, from any time `T` on and read from any phase. -/
theorem column_not_000000000100000001 (init : Int → Bool) (m : Int) (hm : init m = true)
    (hz : ∀ x : Int, x < m → init x = false) (k : Int) (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → evolve init t k = (wordOf 18 0b000000000100000001).getD ((t + shift) % 18) false) : False :=
  class_column init m hm hz cls000000000100000001 cls000000000100000001_valid k T shift fun t ht => by
    rw [h t ht]
    show _ = bit (wordOf 18 0b000000000100000001) ((t + shift) % (wordOf 18 0b000000000100000001).length)
    rw [bit_eq_getD, Rule30StripCertificateTable.wordOf_length]

/-- **The center column does not repeat 000000000100000001**, from any time `T` on and read from any phase. -/
theorem center_not_000000000100000001 (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → Rule30Prize.center t = (wordOf 18 0b000000000100000001).getD ((t + shift) % 18) false) :
    False :=
  column_not_000000000100000001 single 0 rfl (fun x hx => decide_eq_false (by omega)) 0 T shift fun t ht => by
    rw [evolve_single_center, h t ht]

/-- The same in the kit's form: `000000000100000001` is not an `EventuallyWord` of the center column. -/
theorem not_eventually_000000000100000001 : ¬ Rule30StripCertificates.EventuallyWord (wordOf 18 0b000000000100000001) :=
  class_not_eventuallyWord cls000000000100000001 cls000000000100000001_valid


theorem mem_gameMasks16 {e : Nat × Nat} (he : e ∈ gameBlocks16) : ∃ g ∈ gameMasks16, g.block = wordOf e.1 e.2 := by
  have hm : wordOf e.1 e.2 ∈ gameMasks16.map GameMask.block := by
    rw [gameMasks16_blocks]
    exact List.mem_map_of_mem (f := fun e : Nat × Nat => wordOf e.1 e.2) he
  exact List.mem_map.mp hm

/-- Official form: **the center column does not repeat any of the 97 blocks from some time on**, in any
rotation. -/
theorem center_not_gameBlocks16 (e : Nat × Nat) (he : e ∈ gameBlocks16) (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → Rule30Prize.center t = (wordOf e.1 e.2).getD ((t + shift) % e.1) false) : False := by
  obtain ⟨g, hg, hb⟩ := mem_gameMasks16 he
  refine mask_column single 0 rfl (fun x hx => decide_eq_false (by omega)) g
    (List.all_eq_true.mp gameMasks16_check g hg) 0 T shift fun t ht => ?_
  rw [evolve_single_center, h t ht]
  show _ = bit g.block ((t + shift) % g.block.length)
  rw [bit_eq_getD, hb, Rule30StripCertificateTable.wordOf_length]

/-- The same in the kit's form: none of the 97 blocks is an `EventuallyWord` of the center column. -/
theorem not_eventually_gameBlocks16 (e : Nat × Nat) (he : e ∈ gameBlocks16) :
    ¬ Rule30StripCertificates.EventuallyWord (wordOf e.1 e.2) := by
  obtain ⟨g, hg, hb⟩ := mem_gameMasks16 he
  rw [← hb]
  exact mask_not_eventuallyWord g (List.all_eq_true.mp gameMasks16_check g hg)


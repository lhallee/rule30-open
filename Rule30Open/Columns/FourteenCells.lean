  · exact fourteen_absorption fourteenCover0001_2 x hx
  · exact fourteen_absorption fourteenCover0001_3 x hx

/-- **Every right half white on cells 15 to 1446 enters the family under `0011`**, in every phase, whatever its
first fourteen cells and its cells beyond 1446. -/
theorem fourteen_0011 (φ : Nat) (x : Nat → Bool) (hx : ∀ p, 14 < p → p ≤ 1446 → x p = false) :
    ∃ a ∈ A0011, ∃ t1, InFamily (drv (fun t => wordAt w0011 (t + φ)) x) a.1 (a.2 + φ) t1 := by
  refine gap_phase ?_
  rcases (show φ % 4 = 0 ∨ φ % 4 = 1 ∨ φ % 4 = 2 ∨ φ % 4 = 3 by omega) with h | h | h | h <;> rw [h]
  · exact fourteen_absorption fourteenCover0011_0 x hx
  · exact fourteen_absorption fourteenCover0011_1 x hx
  · exact fourteen_absorption fourteenCover0011_2 x hx
  · exact fourteen_absorption fourteenCover0011_3 x hx

/-- **Every right half white on cells 15 to 560 enters the family under `0111`**, in every phase, whatever its
first fourteen cells and its cells beyond 560. -/
theorem fourteen_0111 (φ : Nat) (x : Nat → Bool) (hx : ∀ p, 14 < p → p ≤ 560 → x p = false) :
    ∃ a ∈ A0111, ∃ t1, InFamily (drv (fun t => wordAt w0111 (t + φ)) x) a.1 (a.2 + φ) t1 := by
  refine gap_phase ?_
  rcases (show φ % 4 = 0 ∨ φ % 4 = 1 ∨ φ % 4 = 2 ∨ φ % 4 = 3 by omega) with h | h | h | h <;> rw [h]
  · exact fourteen_absorption fourteenCover0111_0 x hx
  · exact fourteen_absorption fourteenCover0111_1 x hx
  · exact fourteen_absorption fourteenCover0111_2 x hx
  · exact fourteen_absorption fourteenCover0111_3 x hx

/-- **No finite configuration whose cells 15 to 750 are white has a center column that repeats `0001`**, in any
phase, whatever its left half, its first fourteen cells and its cells beyond 750. -/
theorem fourteenRight_0001 (φ : Nat) : GapRight w0001 14 750 φ :=
  gapRight_of_absorption A0001_ok ⟨3, rfl⟩ (fourteen_0001 φ)

/-- **No finite configuration whose right half has at most fourteen cells has a center column that repeats `0001`.** -/
theorem smallFourteen_0001 (φ : Nat) : SmallRight w0001 14 φ := smallRight_of_gapRight (fourteenRight_0001 φ)

/-- **No finite configuration whose cells 15 to 1446 are white has a center column that repeats `0011`**, in any
phase, whatever its left half, its first fourteen cells and its cells beyond 1446. -/
theorem fourteenRight_0011 (φ : Nat) : GapRight w0011 14 1446 φ :=
  gapRight_of_absorption A0011_ok ⟨3, rfl⟩ (fourteen_0011 φ)

/-- **No finite configuration whose right half has at most fourteen cells has a center column that repeats `0011`.** -/
theorem smallFourteen_0011 (φ : Nat) : SmallRight w0011 14 φ := smallRight_of_gapRight (fourteenRight_0011 φ)

/-- **No finite configuration whose cells 15 to 560 are white has a center column that repeats `0111`**, in any
phase, whatever its left half, its first fourteen cells and its cells beyond 560. -/
theorem fourteenRight_0111 (φ : Nat) : GapRight w0111 14 560 φ :=
  gapRight_of_absorption A0111_ok ⟨3, rfl⟩ (fourteen_0111 φ)

/-- **No finite configuration whose right half has at most fourteen cells has a center column that repeats `0111`.** -/
theorem smallFourteen_0111 (φ : Nat) : SmallRight w0111 14 φ := smallRight_of_gapRight (fourteenRight_0111 φ)

end Rule30Open

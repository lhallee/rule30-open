module

public import Rule30Open.Columns.WordTraps

/-!
# Seven checked traps that some finitely supported right half never enters

A trap of [WordTraps](WordTraps.md) reduces its block to entry (`WTrap.Absorption`): every finitely supported right
half driven by the block, from any phase, eventually has its first cells in a state of the trap. That fails when some
node of the finite game cannot reach the trap: the nodes that cannot form a set that no move leaves, and a right half
that starts there stays there. Seven of the traps found for blocks of periods 13 to 15 are of this kind: the natural
traps of `0001101101011`, `0010010010111`, `0010101111111` and `00001101111001`, and the census traps, bottom
components of the locked windows of 16 cells, of `0000010111001`, `000001010110101` and `001001111010111`. Here each
is checked as a trap and its entry refuted.

* `WTrap.closedCheck`, `WTrap.apart`: a closed set of windows (the moves of every state, under both values of the cell
  beyond, go to states, with no condition on the first cell), and its separation from a trap (no state of the trap,
  cut to the set's width, is a state of the set whose label reads the same phase).
* `not_absorption`: a closed set for the block of a trap, no wider than it and apart from it, refutes entry into it.
  The right half whose first cells are the set's state `0`, white beyond, driven from the phase of that state's label,
  keeps its first cells in the set, whatever the cells beyond them do.
* `nat<block>`, `cen<block>`, with `_check`: the seven traps. `miss<block>`, with `_closed` and `_apart`: for each, the
  least strongly connected set that no move leaves among the nodes of the game that cannot reach the trap cut to the
  least width at which such nodes exist, of 7 to 13 cells and 128 to 2,446 states.
* `missedTraps`, `missedTraps_check`, `missedTraps_blocks`, `missedTraps_not_absorption`: the list, its checks, its
  blocks, and the refutation of entry into each.

The tables come from `python -m computations.lock_chain --lean-missed`. The natural-language argument is
`MissedTraps.md`, beside this file.
-/

@[expose] public section

-- Sequential elaboration: the kernel checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Rule30Open

open Ruliology.CellularAutomata BitGame

namespace WTrap

variable (C : WTrap)

/-- The moves of state `i` go to states, one label later, with no condition on the first cell. -/
def closedOK (i : Nat) : Bool :=
  decide (C.lab i < C.m) && C.edgeOK i false && C.edgeOK i true

/-- **A closed set of windows**: labels modulo a multiple of the period, and the moves of every state, under both
values of the cell beyond, go to states. -/
def closedCheck : Bool :=
  decide (C.m % C.b.length = 0) && Rule30EtherThree.allBelowT C.closedOK C.n

/-- No state of the trap `D`, cut to the first `C.K` cells, is a state of `C` whose label reads the same phase. -/
def apart (D : WTrap) : Bool :=
  Rule30EtherThree.allBelowT (fun i => Rule30EtherThree.allBelowT (fun j =>
    !(D.st i % 2 ^ C.K == C.st j && D.lab i % D.b.length == C.lab j % C.b.length)) C.n) D.n

end WTrap

/-- **A closed set apart from a trap refutes entry into it.** If `S` is a closed set of windows for the block of the
trap `C`, no wider than it and apart from it, the right half whose first `S.K` cells are state `0` of `S`, white
beyond, driven by the block from the phase of that state's label, keeps its first `S.K` cells in `S` and never enters
`C`. -/
theorem not_absorption (C S : WTrap) (hS : S.closedCheck = true) (hb : S.b = C.b) (hK : S.K ≤ C.K)
    (hap : S.apart C = true) (h0 : 0 < S.n) : ¬ C.Absorption := by
  intro hA
  unfold WTrap.closedCheck at hS
  rw [Bool.and_eq_true, decide_eq_true_eq] at hS
  obtain ⟨hm, hall⟩ := hS
  have hdvd : S.b.length ∣ S.m := Nat.dvd_of_mod_eq_zero hm
  have hok : ∀ j, j < S.n → S.lab j < S.m ∧ S.edgeOK j false = true ∧ S.edgeOK j true = true := by
    intro j hj
    have h := Rule30EtherThree.allBelowT_spec hall j hj
    unfold WTrap.closedOK at h
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    exact ⟨h.1.1, h.1.2, h.2⟩
  have hedge : ∀ j, j < S.n → ∀ z : Bool, S.nxt j z < S.n ∧
      S.st (S.nxt j z) = GameMask.move S.K (col S.b (S.lab j)) z (S.st j) ∧
      S.lab (S.nxt j z) = (S.lab j + 1) % S.m := by
    intro j hj z
    have h : S.edgeOK j z = true := by
      cases z
      · exact (hok j hj).2.1
      · exact (hok j hj).2.2
    unfold WTrap.edgeOK at h
    simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
    exact ⟨h.1.1, h.1.2, h.2⟩
  have hlt : ∀ j, S.st j < 2 ^ S.K := fun j => Nat.mod_lt _ (Nat.two_pow_pos _)
  -- The right half: state `0` of `S`, white beyond.
  let x : Nat → Bool := fun q => decide (1 ≤ q) && (S.st 0).testBit (q - 1)
  have hfin : ∀ q, S.K < q → x q = false := by
    intro q hq
    show (decide (1 ≤ q) && (S.st 0).testBit (q - 1)) = false
    rw [Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le (hlt 0) (Nat.pow_le_pow_right (by decide) (by omega))),
      Bool.and_false]
  obtain ⟨t1, i, hi, hph, hr⟩ := hA x S.K hfin (S.lab 0)
  let c : Nat → Bool := fun t => C.b.getD ((t + S.lab 0) % C.b.length) false
  -- Its first `S.K` cells stay in `S`.
  have inv : ∀ s, ∃ j, j < S.n ∧ Rule30EtherThree.EncF (Rule30Ether.drv c x) S.K s 0 (S.st j) ∧
      S.lab j = (S.lab 0 + s) % S.m := by
    intro s
    induction s with
    | zero =>
      refine ⟨0, h0, ⟨hlt 0, fun k hk => ?_⟩, by rw [Nat.add_zero, Nat.mod_eq_of_lt (hok 0 h0).1]⟩
      rw [Rule30Ether.drv_init c x (0 + 1 + k) (by omega)]
      show _ = (decide (1 ≤ 0 + 1 + k) && (S.st 0).testBit (0 + 1 + k - 1))
      rw [decide_eq_true (by omega), Bool.true_and, show 0 + 1 + k - 1 = k by omega]
    | succ s ih =>
      obtain ⟨j, hj, henc, hlab⟩ := ih
      obtain ⟨hn, hst, hl⟩ := hedge j hj (Rule30Ether.drv c x s (0 + 1 + S.K))
      refine ⟨_, hn, ?_, ?_⟩
      · have hcol : col S.b (S.lab j) = Rule30Ether.drv c x s 0 := by
          rw [Rule30Ether.drv_col0]
          show col S.b (S.lab j) = C.b.getD ((s + S.lab 0) % C.b.length) false
          unfold col
          rw [bit_eq_getD, hlab, Nat.mod_mod_of_dvd _ hdvd, hb, Nat.add_comm (S.lab 0) s]
        rw [hst, GameMask.move_eq, hcol]
        exact Rule30EtherThree.encF_step (Rule30Ether.drv_isR30 c x) henc
      · rw [hl, hlab, Nat.mod_add_mod, Nat.add_assoc]
  obtain ⟨j, hj, henc, hlab⟩ := inv t1
  -- The state of the trap, cut to `S.K` cells, is that state of `S`, with a label of the same phase.
  have hcut : C.st i % 2 ^ S.K = S.st j := by
    apply Nat.eq_of_testBit_eq
    intro k
    by_cases hk : k < S.K
    · rw [Nat.testBit_mod_two_pow, decide_eq_true hk, Bool.true_and, hr.2 k (by omega), henc.2 k hk]
    · rw [Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le (Nat.mod_lt _ (Nat.two_pow_pos _))
          (Nat.pow_le_pow_right (by decide) (by omega))),
        Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le (hlt j) (Nat.pow_le_pow_right (by decide) (by omega)))]
  have hphase : C.lab i % C.b.length = S.lab j % S.b.length := by
    rw [hlab, Nat.mod_mod_of_dvd _ hdvd, hb, ← hph, Nat.add_comm t1 (S.lab 0)]
  have h := Rule30EtherThree.allBelowT_spec (Rule30EtherThree.allBelowT_spec hap i hi) j hj
  simp [hcut, hphase] at h


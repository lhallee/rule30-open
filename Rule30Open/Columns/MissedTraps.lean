/-- **Entry into each of the seven fails.** For each trap of `missedTraps`, some finitely supported right half driven
by its block, from some phase, never has its first cells in a state of the trap. -/
theorem missedTraps_not_absorption : ∀ C ∈ missedTraps, ¬ C.Absorption := by
  simp only [missedTraps, List.mem_cons, List.not_mem_nil, or_false]
  rintro C (rfl | rfl | rfl | rfl | rfl | rfl | rfl)
  · exact nat0001101101011_not_absorption
  · exact nat0010010010111_not_absorption
  · exact nat0010101111111_not_absorption
  · exact nat00001101111001_not_absorption
  · exact cen0000010111001_not_absorption
  · exact cen000001010110101_not_absorption
  · exact cen001001111010111_not_absorption


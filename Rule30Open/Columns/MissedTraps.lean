def missedTraps : List WTrap := [nat0001101101011, nat0010010010111, nat0010101111111, nat00001101111001, cen0000010111001, cen000001010110101, cen001001111010111]

/-- **Each of the seven is a trap.** -/
theorem missedTraps_check : missedTraps.all WTrap.check = true := by
  simp only [missedTraps, List.all_cons, List.all_nil, Bool.and_true, nat0001101101011_check, nat0010010010111_check, nat0010101111111_check, nat00001101111001_check, cen0000010111001_check, cen000001010110101_check, cen001001111010111_check]

/-- The blocks of the traps, each as its least rotation. -/
theorem missedTraps_blocks : missedTraps.map WTrap.b =
    [[false, false, false, true, true, false, true, true, false, true, false, true, true],

module

public import Rule30Open.Foundations.Evolve
public import Ruliology.CellularAutomata.Rule30EtherThree

/-!
# Under the center column `001`, column 1 at the second white step has no `010`, `101` or `1001`

Let the center column repeat the block `001` and look at the right half it drives (the kit's `Rule30Ether.drv`), from
any initial right half, finite or not. At the second white step of each period, the white step just before the black
one, column 1 never reads `010`, `101` or `1001` with the last reading at time 46 or later: its runs of 1s have length
at least 2 and its runs of 0s length at least 3.

* `rankTabs`, `rk`, `nodeOK`, `partOK`: a rank certificate over the states (phase, window of columns 1..13, last three
  readings at the second white steps). Rank 0 states go to rank 0 states for both values of column 14 and complete no
  forbidden word; a state of positive rank goes to states of smaller rank. Ranks are at most 46. `ok_p_s`, `parts_ok`:
  the kernel checks of the 24 parts.
* `ThreeRuns.rank_bound`: along the driven right half, the rank at time `t` is at most `46 - t`.
* `no_010_time`, `no_101_time`, `no_1001_time`: the forbidden words, stated for the times of the readings.
* `three_runs`: the same for the readings `reading R ph i` of column 1 at the `i`-th second white step, `i ≥ 14`.
* `ThreeRuns.evolve_eq_drv`, `three_runs_evolve`: for every row whose center column repeats `001` from time `T`,
  the readings of column 1 at the times `T + 3 i + 1`, `i ≥ 14`, avoid the three words.

The natural-language argument is `ThreeRuns.md`, beside this file.
-/

@[expose] public section

namespace Rule30Open

open Ruliology.CellularAutomata Rule30Ether Rule30EtherThree Rule30StripCertificates

/-! The certificate and the helpers live in `ThreeRuns`; the headline theorems are in `Rule30Open`. -/

namespace ThreeRuns

/-! ### The certificate: the attractor ranks of the greatest closed good set, rank 0 for the set itself -/

/-- Rank tables: entry `8 * p + s` packs the rank of window `w` in bits `6 w .. 6 w + 5`. -/
def rankTabs : List Nat := [
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  
]

/-! ### States, the step and the check -/

/-- The rank of the state with phase `p`, last readings `s` and window `w`: bits `6 w .. 6 w + 5` of table `8 p + s`. -/
def rk (p s w : Nat) : Nat := (rankTabs.getD (8 * p + s) 0 >>> (6 * w)) % 64

/-- The reading `b` after the readings `s` (newest in bit 0) completes `010`, `101` or `1001`. -/
def badB (s : Nat) (b : Bool) : Bool :=
  (!s.testBit 1 && s.testBit 0 && !b) || (s.testBit 1 && !s.testBit 0 && b) ||
    (s.testBit 2 && !s.testBit 1 && !s.testBit 0 && b)

/-- The last three readings after a step from phase `p` with window `w`: at phase 1 column 1 is read. -/
def sNext (p s w : Nat) : Nat := bif p == 1 then (2 * s + (w.testBit 0).toNat) % 8 else s

/-- The window of columns 1..13 after a step from phase `p` (the center is black at phase 2), with column 14 equal to
`z`. -/
def wNext (p w : Nat) (z : Bool) : Nat := stripStep 13 (p == 2) z w

/-- The certificate at one state: ranks are at most 46; a state of rank 0 goes to states of rank 0 and completes no
forbidden word; a state of positive rank goes to states of smaller rank. -/
def nodeOK (p s w : Nat) : Bool :=
  let r := rk p s w
  let r0 := rk ((p + 1) % 3) (sNext p s w) (wNext p w false)
  let r1 := rk ((p + 1) % 3) (sNext p s w) (wNext p w true)
  decide (r ≤ 46) && (r != 0 || (r0 == 0 && r1 == 0 && !(p == 1 && badB s (w.testBit 0)))) &&
    (r == 0 || (decide (r0 < r) && decide (r1 < r)))

/-- The certificate at every window, for the phase `p` and the readings `s`. -/
def partOK (p s : Nat) : Bool := allBelowT (fun w => nodeOK p s w) 8192

/-! ### The kernel checks, one per phase and readings -/

theorem ok_0_0 : partOK 0 0 = true := by decide +kernel
theorem ok_0_1 : partOK 0 1 = true := by decide +kernel
theorem ok_0_2 : partOK 0 2 = true := by decide +kernel
theorem ok_0_3 : partOK 0 3 = true := by decide +kernel
theorem ok_0_4 : partOK 0 4 = true := by decide +kernel
theorem ok_0_5 : partOK 0 5 = true := by decide +kernel
theorem ok_0_6 : partOK 0 6 = true := by decide +kernel
theorem ok_0_7 : partOK 0 7 = true := by decide +kernel
theorem ok_1_0 : partOK 1 0 = true := by decide +kernel
theorem ok_1_1 : partOK 1 1 = true := by decide +kernel
theorem ok_1_2 : partOK 1 2 = true := by decide +kernel
theorem ok_1_3 : partOK 1 3 = true := by decide +kernel
theorem ok_1_4 : partOK 1 4 = true := by decide +kernel
theorem ok_1_5 : partOK 1 5 = true := by decide +kernel
theorem ok_1_6 : partOK 1 6 = true := by decide +kernel
theorem ok_1_7 : partOK 1 7 = true := by decide +kernel
theorem ok_2_0 : partOK 2 0 = true := by decide +kernel
theorem ok_2_1 : partOK 2 1 = true := by decide +kernel
theorem ok_2_2 : partOK 2 2 = true := by decide +kernel
theorem ok_2_3 : partOK 2 3 = true := by decide +kernel
theorem ok_2_4 : partOK 2 4 = true := by decide +kernel
theorem ok_2_5 : partOK 2 5 = true := by decide +kernel
theorem ok_2_6 : partOK 2 6 = true := by decide +kernel
theorem ok_2_7 : partOK 2 7 = true := by decide +kernel

theorem parts_ok : ∀ p s, p < 3 → s < 8 → partOK p s = true
  | 0, 0, _, _ => ok_0_0
  | 0, 1, _, _ => ok_0_1
  | 0, 2, _, _ => ok_0_2
  | 0, 3, _, _ => ok_0_3
  | 0, 4, _, _ => ok_0_4
  | 0, 5, _, _ => ok_0_5
  | 0, 6, _, _ => ok_0_6
  | 0, 7, _, _ => ok_0_7
  | 1, 0, _, _ => ok_1_0
  | 1, 1, _, _ => ok_1_1
  | 1, 2, _, _ => ok_1_2
  | 1, 3, _, _ => ok_1_3
  | 1, 4, _, _ => ok_1_4
  | 1, 5, _, _ => ok_1_5
  | 1, 6, _, _ => ok_1_6
  | 1, 7, _, _ => ok_1_7
  | 2, 0, _, _ => ok_2_0
  | 2, 1, _, _ => ok_2_1
  | 2, 2, _, _ => ok_2_2
  | 2, 3, _, _ => ok_2_3
  | 2, 4, _, _ => ok_2_4
  | 2, 5, _, _ => ok_2_5
  | 2, 6, _, _ => ok_2_6
  | 2, 7, _, _ => ok_2_7
  | p + 3, _, h, _ => absurd h (by omega)
  | _, s + 8, _, h => absurd h (by omega)

theorem node_ok {p s w : Nat} (hp : p < 3) (hs : s < 8) (hw : w < 2 ^ 13) : nodeOK p s w = true :=
  allBelowT_spec (parts_ok p s hp hs) w (by have : (2 : Nat) ^ 13 = 8192 := rfl; omega)

theorem node_facts {p s w : Nat} (h : nodeOK p s w = true) (z : Bool) :
    rk p s w ≤ 46 ∧
      (rk p s w = 0 → rk ((p + 1) % 3) (sNext p s w) (wNext p w z) = 0 ∧
        (p = 1 → badB s (w.testBit 0) = false)) ∧
      (rk p s w ≠ 0 → rk ((p + 1) % 3) (sNext p s w) (wNext p w z) < rk p s w) := by
  unfold nodeOK at h
  simp only [Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq, bne_iff_ne, ne_eq, beq_iff_eq,
    Bool.not_eq_true'] at h
  obtain ⟨⟨h46, hA⟩, hB⟩ := h
  refine ⟨h46, fun h0 => ?_, fun h0 => ?_⟩
  · rcases hA with hA | ⟨⟨r0, r1⟩, hbad⟩
    · exact absurd h0 hA
    · refine ⟨by cases z <;> assumption, fun hp => ?_⟩
      subst hp
      simpa using hbad
  · rcases hB with hB | ⟨r0, r1⟩
    · exact absurd hB h0
    · cases z <;> assumption

/-! ### The driven right half and its states -/

/-- The center column `001` read from phase `ph`: black exactly at the steps `t` with `(t + ph) % 3 = 2`. -/
def ctr (ph t : Nat) : Bool := wordAt3 w001 (t + ph)

theorem ctr_eq (ph t : Nat) : ctr ph t = ((t + ph) % 3 == 2) := by
  have h : (t + ph) % 3 < 3 := Nat.mod_lt _ (by decide)
  unfold ctr wordAt3
  generalize (t + ph) % 3 = m at h ⊢
  revert m
  decide

/-- The first `n` values of `f` as bits. -/
def pack (f : Nat → Bool) : Nat → Nat
  | 0 => 0
  | n + 1 => pack f n ||| ((f n).toNat <<< n)

theorem testBit_pack (f : Nat → Bool) : ∀ n i, (pack f n).testBit i = (decide (i < n) && f i)
  | 0, i => by simp [pack]
  | n + 1, i => by
    rw [pack, Nat.testBit_or, Nat.testBit_shiftLeft, testBit_toNat, testBit_pack f n i]
    rcases Nat.lt_trichotomy i n with h | h | h
    · simp [h, show ¬ n ≤ i by omega, show i < n + 1 by omega]
    · subst h; simp
    · simp [show ¬ i < n by omega, show i - n ≠ 0 by omega, show ¬ i < n + 1 by omega]

theorem pack_lt (f : Nat → Bool) (n : Nat) : pack f n < 2 ^ n :=
  Nat.lt_pow_two_of_testBit _ fun i hi => by
    rw [testBit_pack, decide_eq_false (by omega), Bool.false_and]

/-- The windows of columns `1..13` of `F`, step by step. -/
def win (F : Nat → Nat → Bool) : Nat → Nat
  | 0 => pack (fun i => F 0 (i + 1)) 13
  | t + 1 => stripStep 13 (F t 0) (F t 14) (win F t)

theorem win_enc {F : Nat → Nat → Bool} (hF : IsR30 F) : ∀ t, EncF F 13 t 0 (win F t)
  | 0 => ⟨pack_lt _ _, fun i hi => by
      show (pack (fun i => F 0 (i + 1)) 13).testBit i = F 0 (0 + 1 + i)
      rw [testBit_pack, decide_eq_true hi, Bool.true_and, show 0 + 1 + i = i + 1 by omega]⟩
  | t + 1 => encF_step hF (win_enc hF t)

/-- The last three readings of column 1 at the second white steps (newest in bit 0), starting from `0`. -/
def suf (ph : Nat) (F : Nat → Nat → Bool) : Nat → Nat
  | 0 => 0
  | t + 1 => sNext ((t + ph) % 3) (suf ph F t) (win F t)

theorem suf_lt (ph : Nat) (F : Nat → Nat → Bool) : ∀ t, suf ph F t < 8
  | 0 => Nat.zero_lt_succ _
  | t + 1 => by
    show sNext _ _ _ < 8
    unfold sNext
    cases ((t + ph) % 3 == 1)
    · exact suf_lt ph F t
    · exact Nat.mod_lt _ (by decide)

section Driven

variable (R : Nat → Bool) (ph : Nat)

theorem win_succ (t : Nat) :
    win (drv (ctr ph) R) (t + 1) = wNext ((t + ph) % 3) (win (drv (ctr ph) R) t) (drv (ctr ph) R t 14) := by
  show stripStep 13 (drv (ctr ph) R t 0) _ _ = stripStep 13 _ _ _
  rw [drv_col0, ctr_eq]

theorem state_ok (t : Nat) :
    nodeOK ((t + ph) % 3) (suf ph (drv (ctr ph) R) t) (win (drv (ctr ph) R) t) = true :=
  node_ok (Nat.mod_lt _ (by decide)) (suf_lt _ _ _) (win_enc (drv_isR30 _ _) t).1

/-- **Rank bound.** Along the driven right half the rank at time `t` is at most `46 - t`. -/
theorem rank_bound : ∀ t, rk ((t + ph) % 3) (suf ph (drv (ctr ph) R) t) (win (drv (ctr ph) R) t) ≤ 46 - t
  | 0 => (node_facts (state_ok R ph 0) false).1
  | t + 1 => by
    have ih := rank_bound t
    have hf := node_facts (state_ok R ph t) (drv (ctr ph) R t 14)
    rw [← win_succ] at hf
    have hp : (t + 1 + ph) % 3 = ((t + ph) % 3 + 1) % 3 := by omega
    have hs : suf ph (drv (ctr ph) R) (t + 1) =
        sNext ((t + ph) % 3) (suf ph (drv (ctr ph) R) t) (win (drv (ctr ph) R) t) := rfl
    rw [hp, hs]
    by_cases h0 : rk ((t + ph) % 3) (suf ph (drv (ctr ph) R) t) (win (drv (ctr ph) R) t) = 0
    · rw [(hf.2.1 h0).1]; exact Nat.zero_le _
    · have := hf.2.2 h0; omega

/-- From time 46 on, no reading at the second white steps completes a forbidden word. -/
theorem no_bad (t : Nat) (ht : 46 ≤ t) (hp : (t + ph) % 3 = 1) :
    badB (suf ph (drv (ctr ph) R) t) (drv (ctr ph) R t 1) = false := by
  have h0 := rank_bound R ph t
  have hf := node_facts (state_ok R ph t) false
  have hb := (hf.2.1 (by omega)).2 hp
  rwa [encF_head (win_enc (drv_isR30 _ _) t) (by decide)] at hb

/-- The readings move one place at each second white step. -/
theorem suf_three (t : Nat) (hp : (t + ph) % 3 = 1) :
    suf ph (drv (ctr ph) R) (t + 3) = (2 * suf ph (drv (ctr ph) R) t + (drv (ctr ph) R t 1).toNat) % 8 := by
  show sNext ((t + 2 + ph) % 3) (sNext ((t + 1 + ph) % 3) (sNext ((t + ph) % 3) _ _) _) _ = _
  rw [show (t + 2 + ph) % 3 = 0 by omega, show (t + 1 + ph) % 3 = 2 by omega, hp]
  unfold sNext
  rw [encF_head (win_enc (drv_isR30 _ _) t) (by decide)]
  rfl

end Driven

/-! ### The forbidden words -/

/-- One more reading. -/
def push (s : Nat) (a : Bool) : Nat := (2 * s + a.toNat) % 8

theorem bad_010 : ∀ s, s < 8 → badB (push (push s false) true) false = true := by decide
theorem bad_101 : ∀ s, s < 8 → badB (push (push s true) false) true = true := by decide
theorem bad_1001 : ∀ s, s < 8 → badB (push (push (push s true) false) false) true = true := by decide

end ThreeRuns

open ThreeRuns

section Driven

variable (R : Nat → Bool) (ph : Nat)

/-- **No `010`.** At the second white steps, column 1 never reads `0, 1, 0` with the first reading at time `40` or
later. -/
theorem no_010_time (u : Nat) (hu : 40 ≤ u) (hp : (u + ph) % 3 = 1) :
    ¬ (drv (ctr ph) R u 1 = false ∧ drv (ctr ph) R (u + 3) 1 = true ∧ drv (ctr ph) R (u + 6) 1 = false) := by
  rintro ⟨h1, h2, h3⟩
  have hb := no_bad R ph (u + 3 + 3) (by omega) (by omega)
  rw [suf_three R ph (u + 3) (by omega), suf_three R ph u hp, h1, h2,
    show u + 3 + 3 = u + 6 by omega, h3] at hb
  rw [show (2 * ((2 * suf ph (drv (ctr ph) R) u + false.toNat) % 8) + true.toNat) % 8 =
    push (push (suf ph (drv (ctr ph) R) u) false) true from rfl, bad_010 _ (suf_lt _ _ _)] at hb
  exact absurd hb (by decide)

/-- **No `101`.** -/
theorem no_101_time (u : Nat) (hu : 40 ≤ u) (hp : (u + ph) % 3 = 1) :
    ¬ (drv (ctr ph) R u 1 = true ∧ drv (ctr ph) R (u + 3) 1 = false ∧ drv (ctr ph) R (u + 6) 1 = true) := by
  rintro ⟨h1, h2, h3⟩
  have hb := no_bad R ph (u + 3 + 3) (by omega) (by omega)
  rw [suf_three R ph (u + 3) (by omega), suf_three R ph u hp, h1, h2,
    show u + 3 + 3 = u + 6 by omega, h3] at hb
  rw [show (2 * ((2 * suf ph (drv (ctr ph) R) u + true.toNat) % 8) + false.toNat) % 8 =
    push (push (suf ph (drv (ctr ph) R) u) true) false from rfl, bad_101 _ (suf_lt _ _ _)] at hb
  exact absurd hb (by decide)

/-- **No `1001`.** -/
theorem no_1001_time (u : Nat) (hu : 37 ≤ u) (hp : (u + ph) % 3 = 1) :
    ¬ (drv (ctr ph) R u 1 = true ∧ drv (ctr ph) R (u + 3) 1 = false ∧ drv (ctr ph) R (u + 6) 1 = false ∧
      drv (ctr ph) R (u + 9) 1 = true) := by
  rintro ⟨h1, h2, h3, h4⟩
  have hb := no_bad R ph (u + 3 + 3 + 3) (by omega) (by omega)
  rw [suf_three R ph (u + 3 + 3) (by omega), suf_three R ph (u + 3) (by omega), suf_three R ph u hp, h1, h2,
    show u + 3 + 3 = u + 6 by omega, h3, show u + 6 + 3 = u + 9 by omega, h4] at hb
  rw [show (2 * ((2 * ((2 * suf ph (drv (ctr ph) R) u + true.toNat) % 8) + false.toNat) % 8) + false.toNat) % 8 =
    push (push (push (suf ph (drv (ctr ph) R) u) true) false) false from rfl,
    bad_1001 _ (suf_lt _ _ _)] at hb
  exact absurd hb (by decide)

end Driven

/-! ### The readings as a sequence -/

namespace ThreeRuns

/-- A sequence of bits has no factor `010`, `101` or `1001` from index `i0` on: its runs of 1s have length at least
2 and its runs of 0s length at least 3. -/
def NoShortRuns (b : Nat → Bool) (i0 : Nat) : Prop :=
  ∀ i, i0 ≤ i → ¬ (b i = false ∧ b (i + 1) = true ∧ b (i + 2) = false) ∧
    ¬ (b i = true ∧ b (i + 1) = false ∧ b (i + 2) = true) ∧
    ¬ (b i = true ∧ b (i + 1) = false ∧ b (i + 2) = false ∧ b (i + 3) = true)

/-- Column 1 of the right half driven by `001` from phase `ph`, at the `i`-th second white step (the steps
`t` with `(t + ph) % 3 = 1`). -/
def reading (R : Nat → Bool) (ph i : Nat) : Bool := drv (ctr ph) R (3 * i + (4 - ph % 3) % 3) 1

end ThreeRuns

/-- **Three runs.** For every right half `R` and phase `ph`, the readings of column 1 at the second white steps have
no factor `010`, `101` or `1001` from the 14th on. -/
theorem three_runs (R : Nat → Bool) (ph : Nat) : NoShortRuns (reading R ph) 14 := by
  intro i hi
  have hp : (3 * i + (4 - ph % 3) % 3 + ph) % 3 = 1 := by omega
  have e1 : reading R ph (i + 1) = drv (ctr ph) R (3 * i + (4 - ph % 3) % 3 + 3) 1 := by
    unfold reading; rw [show 3 * (i + 1) + (4 - ph % 3) % 3 = 3 * i + (4 - ph % 3) % 3 + 3 by omega]
  have e2 : reading R ph (i + 2) = drv (ctr ph) R (3 * i + (4 - ph % 3) % 3 + 6) 1 := by
    unfold reading; rw [show 3 * (i + 2) + (4 - ph % 3) % 3 = 3 * i + (4 - ph % 3) % 3 + 6 by omega]
  have e3 : reading R ph (i + 3) = drv (ctr ph) R (3 * i + (4 - ph % 3) % 3 + 9) 1 := by
    unfold reading; rw [show 3 * (i + 3) + (4 - ph % 3) % 3 = 3 * i + (4 - ph % 3) % 3 + 9 by omega]
  rw [e1, e2, e3]
  exact ⟨no_010_time R ph _ (by omega) hp, no_101_time R ph _ (by omega) hp, no_1001_time R ph _ (by omega) hp⟩

/-! ### Every row whose center column repeats `001` -/

namespace ThreeRuns

/-- From time `T` on, a row whose center column repeats `001` from `T` has the right half driven by `001` from phase
`0`, started from its own right half at time `T`. -/
theorem evolve_eq_drv (init : Int → Bool) (T : Nat)
    (h : ∀ t, T ≤ t → evolve init t 0 = wordAt3 w001 (t - T)) :
    ∀ t p : Nat, evolve init (T + t) (p : Int) = drv (ctr 0) (fun p => evolve init T (p : Int)) t p
  | 0, 0 => by
    rw [drv_col0]
    show evolve init (T + 0) 0 = wordAt3 w001 (0 + 0)
    rw [Nat.add_zero, h T (Nat.le_refl T), Nat.sub_self]
  | 0, p + 1 => by rw [drv_init _ _ _ (by omega)]; rfl
  | t + 1, 0 => by
    rw [drv_col0]
    show evolve init (T + (t + 1)) 0 = wordAt3 w001 (t + 1 + 0)
    rw [h (T + (t + 1)) (by omega), show T + (t + 1) - T = t + 1 + 0 by omega]
  | t + 1, q + 1 => by
    rw [show T + (t + 1) = (T + t) + 1 by omega]
    show rule30 (evolve init (T + t) (((q + 1 : Nat) : Int) - 1)) (evolve init (T + t) ((q + 1 : Nat) : Int))
        (evolve init (T + t) (((q + 1 : Nat) : Int) + 1)) =
      Rule30Jen.rule (drv _ _ t q) (drv _ _ t (q + 1)) (drv _ _ t (q + 2))
    rw [← evolve_eq_drv init T h t q, ← evolve_eq_drv init T h t (q + 1), ← evolve_eq_drv init T h t (q + 2),
      show ((q + 1 : Nat) : Int) - 1 = ((q : Nat) : Int) by omega,
      show ((q + 1 : Nat) : Int) + 1 = ((q + 2 : Nat) : Int) by omega]
    rfl

end ThreeRuns

/-- **Three runs for every row.** If the center column of a row repeats `001` from time `T` (black at the times
`T + 3 i + 2`), then column 1 at the times `T + 3 i + 1` has no factor `010`, `101` or `1001` from `i = 14` on. -/
theorem three_runs_evolve (init : Int → Bool) (T : Nat)
    (h : ∀ t, T ≤ t → evolve init t 0 = wordAt3 w001 (t - T)) :
    NoShortRuns (fun i => evolve init (T + 3 * i + 1) 1) 14 := by
  have e : (fun i => evolve init (T + 3 * i + 1) 1) = reading (fun p => evolve init T (p : Int)) 0 := by
    funext i
    rw [show T + 3 * i + 1 = T + (3 * i + 1) by omega]
    exact evolve_eq_drv init T h (3 * i + 1) 1
  rw [e]
  exact three_runs _ 0

end Rule30Open

  exact ⟨by omega, by omega, fun j φ hj hφ => cls0000000011011001_levels j (by omega) φ (by omega),
    fun φ hφ => cls0000000011011001_f φ (by omega)⟩

/-- **No column repeats 0000000011011001.** In the orbit of a row with a leftmost 1, no column repeats the block
`0000000011011001`, from any time `T` on and read from any phase. -/
theorem column_not_0000000011011001 (init : Int → Bool) (m : Int) (hm : init m = true)
    (hz : ∀ x : Int, x < m → init x = false) (k : Int) (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → evolve init t k = (wordOf 16 0b0000000011011001).getD ((t + shift) % 16) false) : False :=
  class_column init m hm hz cls0000000011011001 cls0000000011011001_valid k T shift fun t ht => by
    rw [h t ht]
    show _ = bit (wordOf 16 0b0000000011011001) ((t + shift) % (wordOf 16 0b0000000011011001).length)
    rw [bit_eq_getD, Rule30StripCertificateTable.wordOf_length]

/-- **The center column does not repeat 0000000011011001**, from any time `T` on and read from any phase. -/
theorem center_not_0000000011011001 (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → Rule30Prize.center t = (wordOf 16 0b0000000011011001).getD ((t + shift) % 16) false) :
    False :=
  column_not_0000000011011001 single 0 rfl (fun x hx => decide_eq_false (by omega)) 0 T shift fun t ht => by
    rw [evolve_single_center, h t ht]

/-- The same in the kit's form: `0000000011011001` is not an `EventuallyWord` of the center column. -/
theorem not_eventually_0000000011011001 : ¬ Rule30StripCertificates.EventuallyWord (wordOf 16 0b0000000011011001) :=
  class_not_eventuallyWord cls0000000011011001 cls0000000011011001_valid


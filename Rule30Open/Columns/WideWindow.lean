module

public import Rule30Open.Columns.LongWindow

/-!
# An eventual period of the center column needs `T + P ≥ 262125`

[LongWindow](LongWindow.md) proves `T + P ≥ 65518` from the first 65,536 center cells. Here the window has 262,144
cells: the factor of length 20 at time 262124 occurs at no earlier time (`wideFactor_new`), so no eventual period has
`T + P ≤ 262124` (`transient_add_period_ge_262125`).

The kernel runs the 262,144 steps in sixteen parts of 16,384 (`wideRun0` to `wideRun15`), each from a given packed row
to the next, collecting the part's 16,384 center cells as it goes (`runRel`, `runRel_fst`, `runRel_snd`); the factor is
compared with every earlier position in sixteen parts of 16,384 positions (`wideFactor0` to `wideFactor15`). No single
kernel computation holds the whole run.

The natural-language argument is `WideWindow.md`, beside this file.
-/

@[expose] public section

-- Sequential elaboration: the kernel checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Rule30Open

open Ruliology.CellularAutomata
open Rule30Jen Rule30Prize Rule30Window

/-- `n` steps of a packed row, collecting bit `K` of the row `i` steps on as bit `j + i` of the accumulator; the final
row and the accumulator are returned. The `Nat.ble 0` test forces each step's values. -/
def runRel (K : Nat) : Nat → Nat → Nat → Nat → Nat × Nat
  | 0, _, r, acc => (r, acc)
  | n + 1, j, r, acc =>
    if (Nat.ble 0 (if r.testBit K then acc ||| (1 <<< j) else acc) && Nat.ble 0 (stepRow r)) = true
    then runRel K n (j + 1) (stepRow r) (if r.testBit K then acc ||| (1 <<< j) else acc)
    else (0, 0)

theorem ble_zero_and (a b : Nat) : (Nat.ble 0 a && Nat.ble 0 b) = true := by
  rw [Bool.and_eq_true, Nat.ble_eq, Nat.ble_eq]
  exact ⟨Nat.zero_le a, Nat.zero_le b⟩

/-- The row `runRel` returns is the row `n` steps on. -/
theorem runRel_fst (K : Nat) : ∀ n j r acc, (runRel K n j r acc).1 = steps n r
  | 0, _, _, _ => rfl
  | n + 1, j, r, acc => by
    unfold runRel
    rw [ite_eq_left (ble_zero_and _ _)]
    exact runRel_fst K n (j + 1) (stepRow r) _

/-- The accumulator `runRel` returns: bit `j + i` is bit `K` of the row `i` steps on. -/
theorem runRel_snd (K : Nat) : ∀ n j r acc, (∀ i, j ≤ i → acc.testBit i = false) → ∀ i,
    (runRel K n j r acc).2.testBit i =
      if i < j then acc.testBit i else if i < j + n then (steps (i - j) r).testBit K else false := by
  intro n
  induction n with
  | zero =>
    intro j r acc hacc i
    show acc.testBit i = _
    by_cases h : i < j
    · rw [ite_eq_left h]
    · rw [ite_eq_right h, ite_eq_right (show ¬ i < j + 0 by omega), hacc i (by omega)]
  | succ n ih =>
    intro j r acc hacc i
    unfold runRel
    rw [ite_eq_left (ble_zero_and _ _)]
    have hbit : ∀ m, (acc ||| (1 <<< j)).testBit m = (acc.testBit m || decide (j = m)) := by
      intro m
      rw [Nat.testBit_or, Nat.shiftLeft_eq, Nat.one_mul, Nat.testBit_two_pow]
    have hacc' : ∀ i, j + 1 ≤ i → (if r.testBit K then acc ||| (1 <<< j) else acc).testBit i = false := by
      intro i hi
      split
      · rw [hbit, hacc i (by omega), decide_eq_false (by omega)]
        rfl
      · exact hacc i (by omega)
    rw [ih (j + 1) (stepRow r) _ hacc' i]
    by_cases h1 : i < j
    · rw [ite_eq_left (show i < j + 1 by omega), ite_eq_left h1]
      split
      · rw [hbit, decide_eq_false (by omega), Bool.or_false]
      · rfl
    · by_cases h2 : i = j
      · subst h2
        rw [ite_eq_left (show i < i + 1 by omega), ite_eq_right (show ¬ i < i by omega),
          ite_eq_left (show i < i + (n + 1) by omega), Nat.sub_self]
        show _ = r.testBit K
        split
        · next hr => rw [hbit, hacc i (Nat.le_refl i), decide_eq_true rfl, hr]; rfl
        · next hr =>
          rw [hacc i (Nat.le_refl i)]
          cases h : r.testBit K
          · rfl
          · exact absurd h hr
      · rw [ite_eq_right (show ¬ i < j + 1 by omega), ite_eq_right h1]
        by_cases h3 : i < j + 1 + n
        · rw [ite_eq_left h3, ite_eq_left (show i < j + (n + 1) by omega),
            show i - j = (i - (j + 1)) + 1 by omega]
          rfl
        · rw [ite_eq_right h3, ite_eq_right (show ¬ i < j + (n + 1) by omega)]

/-- A part of the run: from the row at time `t0`, the row `n` steps on. -/
theorem row_of_run {K n t0 W V : Nat} (hW : row K t0 = W) (h : (runRel K n 0 W 0).1 = V) :
    row K (t0 + n) = V := by
  rw [runRel_fst] at h
  rw [← steps_row, hW]
  exact h

/-- A part of the run read off the center cells: bit `K` of the row at time `i` is bit `i` of `C`. -/
theorem bit_of_run {K n t0 W C : Nat} (hW : row K t0 = W)
    (h : (runRel K n 0 W 0).2 = (C >>> t0) % 2 ^ n) (i : Nat) (h1 : t0 ≤ i) (h2 : i < t0 + n) :
    (row K i).testBit K = C.testBit i := by
  have e := congrArg (fun x => x.testBit (i - t0)) h
  rw [runRel_snd K n 0 W 0 (fun _ _ => Nat.zero_testBit _), ite_eq_right (show ¬ i - t0 < 0 by omega),
    ite_eq_left (show i - t0 < 0 + n by omega), Nat.sub_zero, ← hW, steps_row,
    show t0 + (i - t0) = i by omega] at e
  rw [e, Nat.testBit_mod_two_pow, Nat.testBit_shiftRight, decide_eq_true (by omega), Bool.true_and,
    show t0 + (i - t0) = i by omega]


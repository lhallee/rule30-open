theorem wideFactor15 : (List.range 16364).all (fun j => !Nat.beq ((wideSeg 15 >>> j) % 2 ^ 20) wideLast) = true := by
  decide +kernel

/-- **The factor of length 20 at time 262124 occurs at no earlier time.** -/
theorem wideFactor_new (j : Nat) (hj : j < 262124) : (wideBits >>> j) % 2 ^ 20 ≠ wideLast := by
  have e := seg_factor (j / 16384) (j % 16384) (Nat.mod_lt _ (by omega))
  rw [show 16384 * (j / 16384) + j % 16384 = j by omega] at e
  rw [e]
  have hq : j / 16384 < 16 := by omega
  have hr : j % 16384 < 16384 := Nat.mod_lt _ (by omega)
  have h15 : j / 16384 = 15 → j % 16384 < 16364 := by omega
  generalize j / 16384 = q at hq h15 ⊢
  generalize j % 16384 = r at hr h15 ⊢
  match q, hq with
  | 0, _ => exact wide_part wideFactor0 hr
  | 1, _ => exact wide_part wideFactor1 hr
  | 2, _ => exact wide_part wideFactor2 hr
  | 3, _ => exact wide_part wideFactor3 hr
  | 4, _ => exact wide_part wideFactor4 hr
  | 5, _ => exact wide_part wideFactor5 hr
  | 6, _ => exact wide_part wideFactor6 hr
  | 7, _ => exact wide_part wideFactor7 hr
  | 8, _ => exact wide_part wideFactor8 hr
  | 9, _ => exact wide_part wideFactor9 hr
  | 10, _ => exact wide_part wideFactor10 hr
  | 11, _ => exact wide_part wideFactor11 hr
  | 12, _ => exact wide_part wideFactor12 hr
  | 13, _ => exact wide_part wideFactor13 hr
  | 14, _ => exact wide_part wideFactor14 hr
  | 15, _ => exact wide_part wideFactor15 (h15 rfl)
  | _ + 16, h => exact absurd h (by omega)

/-- **An eventual period needs `T + P ≥ 262125`**: if `c (t + P) = c t` for all `t ≥ T`, with `P > 0`, then
`T + P ≥ 262125`. -/
theorem transient_add_period_ge_262125 (T P : Nat) (hP : 0 < P)
    (h : ∀ t, T ≤ t → center (t + P) = center t) : 262125 ≤ T + P := by
  refine Nat.le_of_not_lt fun hlt => ?_
  apply wideFactor_new (262124 - P) (by omega)
  unfold wideLast
  apply Nat.eq_of_testBit_eq
  intro k
  rw [Nat.testBit_mod_two_pow, Nat.testBit_mod_two_pow, Nat.testBit_shiftRight, Nat.testBit_shiftRight]
  by_cases hk : k < 20
  · rw [decide_eq_true hk, Bool.true_and, Bool.true_and, ← center_eq_wide _ (by omega),
      ← center_eq_wide _ (by omega)]
    have hp := h (262124 - P + k) (by omega)
    rw [show 262124 - P + k + P = 262124 + k by omega] at hp
    exact hp.symm
  · rw [decide_eq_false hk, Bool.false_and, Bool.false_and]


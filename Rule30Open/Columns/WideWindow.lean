/-- **The first 262,144 center cells are the bits of `wideBits`.** -/
theorem center_eq_wide (t : Nat) (ht : t < 262144) : center t = wideBits.testBit t := by
  have hb : (row 262144 t).testBit 262144 = wideBits.testBit t := by
    by_cases h0 : t < 16384
    · exact bit_of_run (t0 := 0) rfl (congrArg Prod.snd wideRun0) t (by omega) (by omega)
    by_cases h1 : t < 32768
    · exact bit_of_run wideRow1 (congrArg Prod.snd wideRun1) t (by omega) (by omega)
    by_cases h2 : t < 49152
    · exact bit_of_run wideRow2 (congrArg Prod.snd wideRun2) t (by omega) (by omega)
    by_cases h3 : t < 65536
    · exact bit_of_run wideRow3 (congrArg Prod.snd wideRun3) t (by omega) (by omega)
    by_cases h4 : t < 81920
    · exact bit_of_run wideRow4 (congrArg Prod.snd wideRun4) t (by omega) (by omega)
    by_cases h5 : t < 98304
    · exact bit_of_run wideRow5 (congrArg Prod.snd wideRun5) t (by omega) (by omega)
    by_cases h6 : t < 114688
    · exact bit_of_run wideRow6 (congrArg Prod.snd wideRun6) t (by omega) (by omega)
    by_cases h7 : t < 131072
    · exact bit_of_run wideRow7 (congrArg Prod.snd wideRun7) t (by omega) (by omega)
    by_cases h8 : t < 147456
    · exact bit_of_run wideRow8 (congrArg Prod.snd wideRun8) t (by omega) (by omega)
    by_cases h9 : t < 163840
    · exact bit_of_run wideRow9 (congrArg Prod.snd wideRun9) t (by omega) (by omega)
    by_cases h10 : t < 180224
    · exact bit_of_run wideRow10 (congrArg Prod.snd wideRun10) t (by omega) (by omega)
    by_cases h11 : t < 196608
    · exact bit_of_run wideRow11 (congrArg Prod.snd wideRun11) t (by omega) (by omega)
    by_cases h12 : t < 212992
    · exact bit_of_run wideRow12 (congrArg Prod.snd wideRun12) t (by omega) (by omega)
    by_cases h13 : t < 229376
    · exact bit_of_run wideRow13 (congrArg Prod.snd wideRun13) t (by omega) (by omega)
    by_cases h14 : t < 245760
    · exact bit_of_run wideRow14 (congrArg Prod.snd wideRun14) t (by omega) (by omega)
    · exact bit_of_run wideRow15 wideRun15 t (by omega) (by omega)
  rw [← hb, row_testBit 262144 t (by omega) 262144]
  simp [center]

/-! ### The new factor -/

/-- The factor of length 20 at time 262124. -/
def wideLast : Nat := (wideBits >>> 262124) % 2 ^ 20

/-- The cells at times `16384 q` to `16384 q + 16403`, which part `q` of the factor check reads. -/
def wideSeg (q : Nat) : Nat := (wideBits >>> (16384 * q)) % 2 ^ 16404

set_option exponentiation.threshold 16404 in
theorem seg_factor (q j : Nat) (hj : j < 16384) :
    (wideBits >>> (16384 * q + j)) % 2 ^ 20 = (wideSeg q >>> j) % 2 ^ 20 := by
  apply Nat.eq_of_testBit_eq
  intro k
  unfold wideSeg
  rw [Nat.testBit_mod_two_pow, Nat.testBit_mod_two_pow, Nat.testBit_shiftRight, Nat.testBit_shiftRight,
    Nat.testBit_mod_two_pow, Nat.testBit_shiftRight]
  by_cases hk : k < 20
  · rw [decide_eq_true hk, Bool.true_and, Bool.true_and, decide_eq_true (by omega), Bool.true_and,
      Nat.add_assoc]
  · rw [decide_eq_false hk, Bool.false_and, Bool.false_and]

theorem wide_part {q n j : Nat}
    (h : (List.range n).all (fun j => !Nat.beq ((wideSeg q >>> j) % 2 ^ 20) wideLast) = true) (hj : j < n) :
    (wideSeg q >>> j) % 2 ^ 20 ≠ wideLast := by
  intro e
  have hall := List.all_eq_true.1 h j (List.mem_range.2 hj)
  rw [e] at hall
  simp at hall

theorem wideFactor0 : (List.range 16384).all (fun j => !Nat.beq ((wideSeg 0 >>> j) % 2 ^ 20) wideLast) = true := by
  decide +kernel


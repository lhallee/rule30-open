module

public import Rule30Open.Columns.WordTraps

/-!
# The period-four certificates as traps

For each of the three words of least period four, the finding `period-four-certificate` computes the greatest family of
windows of the right half, one set per phase, that the driven rule never leaves whatever the cell beyond does, and on
which column 1 is fixed at the white phases: at width 16 for `0001` and 14 for `0011` and `0111`. Each comes from one
assignment of column 1 at the white phases. Here they are labelled traps `WTrap` of `WordTraps`, checked by the kernel,
with the same reduction: if every finitely supported right half driven by the word enters its certificate, the center
column does not eventually repeat the word.

* `cert0001`, `cert0011`, `cert0111`, with `cert0001_check`, `cert0011_check`, `cert0111_check`: 2,611 states of 16
  cells, and 1,915 and 4,898 states of 14 cells, labels modulo 4.
* `not_eventually_0001_of_certificate`, `not_eventually_0011_of_certificate`, `not_eventually_0111_of_certificate`:
  entry into the certificate excludes the word.

The natural-language argument is `PeriodFourCertificate.md`, beside this file. The tables come from
`python -m computations.lock_certificate --lean`.
-/

@[expose] public section

namespace Rule30Open

open Ruliology.CellularAutomata

/-- The block `0001`: 16 cells, labels modulo 4, 2611 states. -/
def cert0001 : WTrap :=
  { b := [false, false, false, true], K := 16, m := 4, n := 2611, lb := 2, ib := 12,
    u := 4,
    R := ,
    L := ,
    S :=  }

theorem cert0001_check : cert0001.check = true := by decide +kernel

/-- The block `0011`: 14 cells, labels modulo 4, 1915 states. -/
def cert0011 : WTrap :=
  { b := [false, false, true, true], K := 14, m := 4, n := 1915, lb := 2, ib := 11,
    u := 3,
    R := ,
    L := ,
    S :=  }

theorem cert0011_check : cert0011.check = true := by decide +kernel

/-- The block `0111`: 14 cells, labels modulo 4, 4898 states. -/
def cert0111 : WTrap :=
  { b := [false, true, true, true], K := 14, m := 4, n := 4898, lb := 2, ib := 13,
    u := 0,
    R := ,
    L := ,
    S :=  }

theorem cert0111_check : cert0111.check = true := by decide +kernel

/-- **`0001` reduced to entry into its certificate**, 2,611 windows of 16 cells. -/
theorem not_eventually_0001_of_certificate (hA : cert0001.Absorption) :
    ¬ Rule30StripCertificates.EventuallyWord [false, false, false, true] :=
  absorption_excludes cert0001 cert0001_check hA

/-- **`0011` reduced to entry into its certificate**, 1,915 windows of 14 cells. -/
theorem not_eventually_0011_of_certificate (hA : cert0011.Absorption) :
    ¬ Rule30StripCertificates.EventuallyWord [false, false, true, true] :=
  absorption_excludes cert0011 cert0011_check hA

/-- **`0111` reduced to entry into its certificate**, 4,898 windows of 14 cells. -/
theorem not_eventually_0111_of_certificate (hA : cert0111.Absorption) :
    ¬ Rule30StripCertificates.EventuallyWord [false, true, true, true] :=
  absorption_excludes cert0111 cert0111_check hA

end Rule30Open

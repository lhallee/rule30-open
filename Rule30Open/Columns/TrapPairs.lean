  | 9, _ => pair0010101111111_0_9
  | 10, _ => pair0010101111111_0_10
  | 11, _ => pair0010101111111_0_11
  | _ + 12, h => absurd h (by omega)

/-- **The trap passes the check**, gathered from its 13 parts. -/
theorem pair0010101111111_0_check : pair0010101111111_0.check = true := by
  have hall := allRange_cover (by decide) pair0010101111111_0_parts pair0010101111111_0_12
  unfold WTrap.check
  rw [allBelowT_of_forall (fun i hi => hall i (by
    have : pair0010101111111_0.n = 1024 * 12 + 871 := rfl
    omega))]
  decide


module

public import Rule30Open.Columns.NaturalTrapsLarge

/-!
# Four blocks of periods 13 and 14 reduced to entry into one of two traps

A trap of [WordTraps](WordTraps.md) is a closed set of windows on which the cell beside the block's column is a
function of the phase at the white phases; once a right half driven by the block has its first cells in it, Jen's
theorem on adjacent columns is contradicted. Nothing in that argument needs one trap: entry into any of several checked
traps of the block, whichever a half reaches, excludes the block as well. Here that is proved, and applied to four
blocks whose locked windows of 16 cells have two bottom components with different values of the cell at the white
phases. Every node of the finite game can reach one of the two, but neither alone, so entry into one alone is false
([MissedTraps](MissedTraps.md) refutes it for one of each pair), while entry into one of the two is still open.

* `WTrap.AbsorptionSome`: every finitely supported right half driven by the block, from any phase, eventually has its
  first cells in a state of one of the traps of a list, with the label of the right phase, in the form of the kit's
  `AbsorptionT`.
* `entry_excludes`: the step of `absorption_excludes` after entry, for the right half of the time from which the center
  column repeats the block. `absorption_some_excludes`: entry into one of a list of checked traps of one block excludes
  the block as a tail of the center column, in the kit's form `EventuallyWord`.
* `pair<block>_0`, `pair<block>_1`, with `_check`: the two bottom components of each block, one of 13,159 states
  checked in parts. `pair<block>`: the two. `pair<block>_excludes`: the reduction of each block.

The tables come from `python -m computations.lock_chain --lean-pairs`. The natural-language argument is
`TrapPairs.md`, beside this file.
-/

@[expose] public section

-- Sequential elaboration: the kernel checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Rule30Open

open Ruliology.CellularAutomata BitGame

/-- **Entry into one of several traps** (a `Prop`, in the form of the kit's `AbsorptionT`): every finitely supported
right half driven by the block, from any phase, eventually has its first cells in a state of one of the traps `Cs`,
with the label of the right phase. -/
def WTrap.AbsorptionSome (Cs : List WTrap) : Prop :=
  ∀ (x : Nat → Bool) (n : Nat), (∀ p, n < p → x p = false) → ∀ φ : Nat, ∃ C ∈ Cs,
    ∃ t1 i, i < C.n ∧ (t1 + φ) % C.b.length = C.lab i % C.b.length ∧
      Rule30EtherThree.EncF (Rule30Ether.drv (fun t => C.b.getD ((t + φ) % C.b.length) false) x) C.K t1 0 (C.st i)

/-- **Entry of the half of time `T` excludes the block.** If the center column repeats the block of the checked trap
`C` from `T`, and the right half of time `T`, driven by the block from phase 0, enters `C`, contradiction: the step of
`absorption_excludes` after entry. -/
theorem entry_excludes (C : WTrap) (hC : C.check = true) (T : Nat)
    (hT : ∀ t, T ≤ t → Rule30Jen.cell t 0 = C.b.getD ((t - T) % C.b.length) false)
    (h : ∃ t1 i, i < C.n ∧ (t1 + 0) % C.b.length = C.lab i % C.b.length ∧
      Rule30EtherThree.EncF (Rule30Ether.drv (fun t => C.b.getD ((t + 0) % C.b.length) false)
        (fun p => Rule30Jen.cell T (p : Int))) C.K t1 0 (C.st i)) : False := by
  obtain ⟨hP, hK, -, -, -⟩ := C.facts hC
  have hc : (fun t => Rule30Jen.cell (T + t) 0) = (fun t => C.b.getD ((t + 0) % C.b.length) false) := by
    funext t
    rw [hT (T + t) (by omega)]
    congr 2
    omega
  obtain ⟨t1, i, hi, hph, hr⟩ := h
  rw [← hc] at hr
  have hcode : codeFrom single (T + t1) 1 C.K = C.st i := by
    apply Nat.eq_of_testBit_eq
    intro j
    rw [testBit_codeFrom, evolve_single_eq_cell]
    by_cases hj : j < C.K
    · rw [decide_eq_true hj, Bool.true_and, hr.2 j hj, show 0 + 1 + j = j + 1 by omega,
        ← Rule30Ether.cell_eq_drv T t1 (j + 1)]
      congr 1
      omega
    · rw [decide_eq_false hj, Bool.false_and]
      exact (Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le hr.1 (Nat.pow_le_pow_right (by decide) (by omega)))).symm
  have hLT : T ≤ C.b.length * T := Nat.le_mul_of_pos_left T hP
  refine center_wtrap C hC T (C.b.length * T - T) (fun t ht => ?_) (T + t1) i (by omega) hi ?_ hcode
  · rw [← evolve_single_center, evolve_single_eq_cell]
    show Rule30Jen.cell t 0 = _
    rw [hT t ht, show t + (C.b.length * T - T) = t - T + C.b.length * T by omega, Nat.add_mul_mod_self_left]
  · rw [← hph, show T + t1 + (C.b.length * T - T) = t1 + 0 + C.b.length * T by omega, Nat.add_mul_mod_self_left]

/-- **Entry into one of several checked traps excludes the block** as a tail of the center column, for every
transient, in the kit's form `Rule30StripCertificates.EventuallyWord`. -/
theorem absorption_some_excludes (b : List Bool) (Cs : List WTrap) (hb : ∀ C ∈ Cs, C.b = b)
    (hC : ∀ C ∈ Cs, C.check = true) (hA : WTrap.AbsorptionSome Cs) :
    ¬ Rule30StripCertificates.EventuallyWord b := by
  rintro ⟨T, hT⟩
  have hfin : ∀ p, T < p → (fun p : Nat => Rule30Jen.cell T (p : Int)) p = false :=
    fun p hp => Rule30Diagonals.cell_eq_false_of_gt T p (by omega)
  obtain ⟨C, hCm, h⟩ := hA (fun p => Rule30Jen.cell T (p : Int)) T hfin 0
  exact entry_excludes C (hC C hCm) T (by rw [hb C hCm]; exact hT) h


/-- **Entry into one of the two traps excludes `0001101101011`.** -/
theorem pair0001101101011_excludes (hA : WTrap.AbsorptionSome pair0001101101011) :
    ¬ Rule30StripCertificates.EventuallyWord [false, false, false, true, true, false, true, true, false, true, false, true, true] := by
  refine absorption_some_excludes _ pair0001101101011 ?_ ?_ hA <;>
    simp only [pair0001101101011, List.mem_cons, List.not_mem_nil, or_false] <;> rintro C (rfl | rfl)
  · rfl
  · rfl
  · exact pair0001101101011_0_check
  · exact pair0001101101011_1_check


module

public import Ruliology.CellularAutomata.Rule30Window

/-!
# An eventual period of the center column needs `T + P ≥ 65518`

If the center column had period `P` from time `T`, every factor starting at a time `t ≥ T` would occur again at `t + P`.
The factor of length 19 at time 65517 occurs at no earlier time among the first 65,536 center cells (`factor_new`), so
no eventual period has `T + P ≤ 65517` (`transient_add_period_ge_65518`). The kit's `Rule30FactorWindow` proves
`T + P ≥ 16359` from the first 16,384 cells, with all their factors of length 26 distinct.

The kernel computes the 65,536 cells in four parts of 16,384 steps (`chunk0` to `chunk3`), with the kit's packed rows
(`Rule30Window.row`, `centerLoop`, `centerLoop_spec`, `row_testBit`); the rows at the three checkpoints are given and
checked (`rowAt16384_eq`, `rowAt32768_eq`, `rowAt49152_eq`), so that no single kernel computation holds the whole run.

The natural-language argument is `LongWindow.md`, beside this file.
-/

@[expose] public section

-- Sequential elaboration: the kernel checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Rule30Open

open Ruliology.CellularAutomata
open Rule30Jen Rule30Prize Rule30Window

/-- `n` steps of a packed row. -/
def steps : Nat → Nat → Nat
  | 0, r => r
  | n + 1, r => steps n (stepRow r)

theorem steps_row (K : Nat) : ∀ n t, steps n (row K t) = row K (t + n)
  | 0, t => rfl
  | n + 1, t => by
    show steps n (stepRow (row K t)) = _
    rw [show stepRow (row K t) = row K (t + 1) from rfl, steps_row K n (t + 1), show t + 1 + n = t + (n + 1) by omega]

/-- The packed row at time 16384, the seed at bit 65536. -/
def rowAt16384 : Nat :=
   <<< 49152

/-- The packed row at time 32768, the seed at bit 65536. -/
def rowAt32768 : Nat :=
   <<< 32768

/-- The packed row at time 49152, the seed at bit 65536. -/
def rowAt49152 : Nat :=
   <<< 16384

/-- The center cells c(0) .. c(65535), bit t being c(t). -/
def bigBits : Nat :=
  

theorem steps16384_0 : steps 16384 (row 65536 0) = rowAt16384 := by decide +kernel

theorem steps16384_1 : steps 16384 rowAt16384 = rowAt32768 := by decide +kernel

theorem steps16384_2 : steps 16384 rowAt32768 = rowAt49152 := by decide +kernel

theorem rowAt16384_eq : row 65536 16384 = rowAt16384 := by
  rw [show (16384 : Nat) = 0 + 16384 from rfl, ← steps_row]; exact steps16384_0

theorem rowAt32768_eq : row 65536 32768 = rowAt32768 := by
  rw [show (32768 : Nat) = 16384 + 16384 from rfl, ← steps_row, rowAt16384_eq]; exact steps16384_1

theorem rowAt49152_eq : row 65536 49152 = rowAt49152 := by
  rw [show (49152 : Nat) = 32768 + 16384 from rfl, ← steps_row, rowAt32768_eq]; exact steps16384_2

theorem chunk0 : centerLoop 65536 16384 0 (row 65536 0) 0 = ((bigBits >>> 0) % 2 ^ 16384) <<< 0 := by
  decide +kernel

theorem chunk1 : centerLoop 65536 16384 16384 rowAt16384 0 = ((bigBits >>> 16384) % 2 ^ 16384) <<< 16384 := by
  decide +kernel

theorem chunk2 : centerLoop 65536 16384 32768 rowAt32768 0 = ((bigBits >>> 32768) % 2 ^ 16384) <<< 32768 := by
  decide +kernel

theorem chunk3 : centerLoop 65536 16384 49152 rowAt49152 0 = ((bigBits >>> 49152) % 2 ^ 16384) <<< 49152 := by
  decide +kernel

/-- A part of the run read off `bigBits`. -/
theorem chunk_bit {K n t0 B : Nat} (h : centerLoop K n t0 (row K t0) 0 = ((B >>> t0) % 2 ^ n) <<< t0)
    (i : Nat) (h1 : t0 ≤ i) (h2 : i < t0 + n) : (row K i).testBit K = B.testBit i := by
  have hs := centerLoop_spec K n t0 0 (fun _ _ => Nat.zero_testBit _) i
  rw [h, ite_eq_right (by omega), ite_eq_left h2] at hs
  rw [← hs, Nat.testBit_shiftLeft, Nat.testBit_mod_two_pow, Nat.testBit_shiftRight,
    decide_eq_true (show i ≥ t0 by omega), decide_eq_true (show i - t0 < n by omega), Bool.true_and,
    Bool.true_and, show t0 + (i - t0) = i by omega]

/-- **The first 65,536 center cells are the bits of `bigBits`.** -/
theorem center_eq_big (t : Nat) (ht : t < 65536) : center t = bigBits.testBit t := by
  have hb : (row 65536 t).testBit 65536 = bigBits.testBit t := by
    by_cases h1 : t < 16384
    · exact chunk_bit chunk0 t (by omega) (by omega)
    by_cases h2 : t < 32768
    · have h := chunk1
      rw [← rowAt16384_eq] at h
      exact chunk_bit h t (by omega) (by omega)
    by_cases h3 : t < 49152
    · have h := chunk2
      rw [← rowAt32768_eq] at h
      exact chunk_bit h t (by omega) (by omega)
    · have h := chunk3
      rw [← rowAt49152_eq] at h
      exact chunk_bit h t (by omega) (by omega)
  rw [← hb, row_testBit 65536 t (by omega) 65536]
  simp [center]

/-- The factor of length 19 at time 65517. -/
def lastFactor : Nat := (bigBits >>> 65517) % 2 ^ 19

/-- **The factor of length 19 at time 65517 occurs at no earlier time.** -/
theorem factor_new : (List.range 65517).all (fun j => !Nat.beq ((bigBits >>> j) % 2 ^ 19) lastFactor) = true := by
  decide +kernel

/-- **An eventual period needs `T + P ≥ 65518`**: if `c (t + P) = c t` for all `t ≥ T`, with `P > 0`, then
`T + P ≥ 65518`. -/
theorem transient_add_period_ge_65518 (T P : Nat) (hP : 0 < P)
    (h : ∀ t, T ≤ t → center (t + P) = center t) : 65518 ≤ T + P := by
  refine Nat.le_of_not_lt fun hlt => ?_
  have hall := List.all_eq_true.1 factor_new (65517 - P) (List.mem_range.2 (by omega))
  have e : (bigBits >>> (65517 - P)) % 2 ^ 19 = lastFactor := by
    unfold lastFactor
    apply Nat.eq_of_testBit_eq
    intro k
    rw [Nat.testBit_mod_two_pow, Nat.testBit_mod_two_pow, Nat.testBit_shiftRight, Nat.testBit_shiftRight]
    by_cases hk : k < 19
    · rw [decide_eq_true hk, Bool.true_and, Bool.true_and, ← center_eq_big _ (by omega),
        ← center_eq_big _ (by omega)]
      have hp := h (65517 - P + k) (by omega)
      rw [show 65517 - P + k + P = 65517 + k by omega] at hp
      exact hp.symm
    · rw [decide_eq_false hk, Bool.false_and, Bool.false_and]
  rw [e] at hall
  simp at hall

end Rule30Open

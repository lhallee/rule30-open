/-- **No column repeats 000000001011.** In the orbit of a row with a leftmost 1, no column repeats the block
`000000001011`, from any time `T` on and read from any phase. -/
theorem column_not_000000001011 (init : Int → Bool) (m : Int) (hm : init m = true)
    (hz : ∀ x : Int, x < m → init x = false) (k : Int) (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → evolve init t k = (wordOf 12 0b000000001011).getD ((t + shift) % 12) false) : False :=
  class_column init m hm hz cls000000001011 cls000000001011_valid k T shift fun t ht => by
    rw [h t ht]
    show _ = bit (wordOf 12 0b000000001011) ((t + shift) % (wordOf 12 0b000000001011).length)
    rw [bit_eq_getD, Rule30StripCertificateTable.wordOf_length]

/-- **The center column does not repeat 000000001011**, from any time `T` on and read from any phase. -/
theorem center_not_000000001011 (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → Rule30Prize.center t = (wordOf 12 0b000000001011).getD ((t + shift) % 12) false) :
    False :=
  column_not_000000001011 single 0 rfl (fun x hx => decide_eq_false (by omega)) 0 T shift fun t ht => by
    rw [evolve_single_center, h t ht]


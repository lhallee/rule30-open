module

public import Rule30Open.Columns.GameBlocks

/-!
# The finite game with cyclic classes, checked width by width, excludes 000000001011

The finite game of [FiniteGame](FiniteGame.md) asks the column left of a repeating one to be a function of the phase on
every component of the game that can hold a play. For `000000001011` at 16 cells one component of 532 nodes fails that
test but passes it on its cyclic classes, which have period 36, three periods of the block. The bit tables of
[BitPhases](BitPhases.md) on the block read three times do not fit the kernel, so this module checks a certificate
whose every condition is local, over a few tens of thousands of nodes.

* `KeyTrie`, `KeyTrie.find`, `KeyTrie.zeros`: finite maps from numbers to numbers, read from the key's bit 0 at the
  root, with the keys of value 0.
* `ClassCert`, `ClassCert.levelOk`, `ClassCert.finalOk`, `ClassCert.Valid`: the certificate. For each width
  `w = 1 .. W`, a height for every node (phase, first `w` cells) whose first `w - 1` cells have height 0 at width
  `w - 1`: every move from height 0 stays at height 0, and every move from a positive height lowers it. On the nodes of
  height 0 at width `W`, a rank and a label: no move lowers the rank, a move from a transient rank raises it, a move
  that keeps a rank that is not transient raises the label by one modulo that rank's modulus, and at such a rank the
  column left of the repeating one is a function of the rank and the label.
* `class_column`: the general soundness. No column of the orbit of a row with a leftmost 1 repeats, from any time on
  and in any rotation, a block with a valid certificate. Along a real row the first `w` cells reach height 0 at every
  width in turn, then the rank settles, the label runs through its residues, and the column left of the repeating one
  is eventually periodic, against `adjacent_columns`.
* `center_not_class`, `class_not_eventuallyWord`: the same for the center column, and in the kit's form.
* `cls000000001011`, `column_not_000000001011`, `center_not_000000001011`, `not_eventually_000000001011`: the
  certificate for `000000001011` at 16 cells, from `computations/class_certificate.py`, and the exclusion of the block
  from every column of every row with a leftmost 1, from the center column, and in the kit's form.

The natural-language argument is `ClassGame.md`, beside this file.
-/

@[expose] public section

-- Sequential elaboration: the kernel checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Rule30Open

open Ruliology.CellularAutomata
open Rule30StripCertificateTable (wordOf)

/-- A finite map from numbers to numbers: `te` is empty, `ts key value` holds one entry, and `tn even odd` holds the
entries of `even` at the keys doubled and those of `odd` at the keys doubled plus one. -/
inductive KeyTrie where
  | te : KeyTrie
  | ts (key value : Nat) : KeyTrie
  | tn (even odd : KeyTrie) : KeyTrie

namespace KeyTrie

/-- The value at a key, 1 where the map has none. -/
def find : KeyTrie → Nat → Nat
  | te, _ => 1
  | ts key value, k => cond (Nat.beq k key) value 1
  | tn even odd, k => cond (Nat.beq (Nat.mod k 2) 0) (find even (Nat.div k 2)) (find odd (Nat.div k 2))

/-- The keys whose value is 0. -/
def zeros : KeyTrie → List Nat
  | te => []
  | ts key value => cond (Nat.beq value 0) [key] []
  | tn even odd => (zeros even).map (fun k => Nat.mul 2 k) ++ (zeros odd).map (fun k => Nat.add (Nat.mul 2 k) 1)

theorem mem_zeros : ∀ (t : KeyTrie) (k : Nat), t.find k = 0 → k ∈ t.zeros
  | te, k, h => absurd h (by simp [find])
  | ts key value, k, h => by
    simp only [find] at h
    cases hk : Nat.beq k key
    · rw [hk] at h
      exact absurd h (by simp)
    · rw [hk] at h
      have e : k = key := Nat.eq_of_beq_eq_true hk
      simp only [Bool.cond_true] at h
      simp [zeros, h, e]
  | tn even odd, k, h => by
    simp only [find] at h
    simp only [zeros, List.mem_append, List.mem_map]
    cases hk : Nat.beq (Nat.mod k 2) 0
    · rw [hk] at h
      have h1 : k % 2 ≠ 0 := Nat.ne_of_beq_eq_false hk
      exact Or.inr ⟨Nat.div k 2, mem_zeros odd _ h, by show 2 * (k / 2) + 1 = k; omega⟩
    · rw [hk] at h
      have h0 : k % 2 = 0 := Nat.eq_of_beq_eq_true hk
      exact Or.inl ⟨Nat.div k 2, mem_zeros even _ h, by show 2 * (k / 2) = k; omega⟩

/-- A bound on every value. -/
def bound : KeyTrie → Nat
  | te => 1
  | ts _ value => max value 1
  | tn even odd => max (bound even) (bound odd)

theorem find_le : ∀ (t : KeyTrie) (k : Nat), t.find k ≤ t.bound
  | te, _ => Nat.le_refl _
  | ts key value, k => by
    simp only [find, bound]
    cases Nat.beq k key
    · exact Nat.le_max_right _ _
    · exact Nat.le_max_left _ _
  | tn even odd, k => by
    simp only [find, bound]
    cases Nat.beq (Nat.mod k 2) 0
    · exact Nat.le_trans (find_le odd _) (Nat.le_max_right _ _)
    · exact Nat.le_trans (find_le even _) (Nat.le_max_left _ _)

/-- A bound on every value of every map of a list. -/
def listBound : List KeyTrie → Nat
  | [] => 1
  | t :: rest => max t.bound (listBound rest)

theorem find_le_listBound : ∀ (l : List KeyTrie) (i k : Nat), (l.getD i te).find k ≤ listBound l
  | [], _, _ => Nat.le_refl _
  | t :: _, 0, k => Nat.le_trans (find_le t k) (Nat.le_max_left _ _)
  | _ :: rest, i + 1, k => Nat.le_trans (find_le_listBound rest i k) (Nat.le_max_right _ _)

end KeyTrie

open KeyTrie

/-- A certificate of the game with cyclic classes for `block`, at the width `W = levels.length`. Entry `w - 1` of
`levels` holds, for each phase, the heights of the nodes of width `w` whose first `w - 1` cells have height 0 at width
`w - 1` (at width 0 every node has height 0). `final` holds, for each phase, the code `rank * base + label` of every
node of height 0 at width `W`; rank `ρ` is transient when bit `ρ` of `transient` is set, its labels run modulo the 8
bits of `mods` from bit `8 ρ`, and the column left of the repeating one at rank `ρ` and label `l` is bit
`ρ * base + l` of `values`. -/
structure ClassCert where
  block : List Bool
  levels : List (List KeyTrie)
  final : List KeyTrie
  base : Nat
  transient : Nat
  mods : Nat
  values : Nat

namespace ClassCert

variable (c : ClassCert)

/-- The block at a phase. -/
def center (φ : Nat) : Bool := bit c.block (φ % c.block.length)

/-- The next phase. -/
def next (φ : Nat) : Nat := Nat.mod (φ + 1) c.block.length

/-- The heights at width `j` and phase `φ`. -/
def tri : Nat → Nat → KeyTrie
  | 0, _ => ts 0 0
  | j + 1, φ => (c.levels.getD j []).getD φ te

/-- A node of width `w` with cells `x`, at a phase where the block reads `cb`, with this phase's heights `here` and the
next phase's `there`: a move from height 0 stays at height 0, a move from a positive height lowers it. -/
def levelNode (w : Nat) (here there : KeyTrie) (cb : Bool) (x : Nat) : Bool :=
  cond (Nat.beq (here.find x) 0)
    (Nat.beq (there.find (GameMask.move w cb false x)) 0 && Nat.beq (there.find (GameMask.move w cb true x)) 0)
    (Nat.blt (there.find (GameMask.move w cb false x)) (here.find x) &&
      Nat.blt (there.find (GameMask.move w cb true x)) (here.find x))

/-- Width `j + 1` at phase `φ`: both extensions of every node of height 0 at width `j` pass `levelNode`. -/
def levelOk (j φ : Nat) : Bool :=
  (c.tri j φ).zeros.all fun p =>
    levelNode (j + 1) (c.tri (j + 1) φ) (c.tri (j + 1) (c.next φ)) (c.center φ) p &&
      levelNode (j + 1) (c.tri (j + 1) φ) (c.tri (j + 1) (c.next φ)) (c.center φ) (Nat.add p (Nat.pow 2 j))

/-- The modulus of the labels at rank `ρ`. -/
def modOf (ρ : Nat) : Nat := GameMask.entry 8 c.mods ρ

/-- A move from rank `ρ` and label `l` to the code `v`: from a transient rank it raises the rank; otherwise it does
not lower the rank, and if it keeps it, it raises the label by one modulo the rank's modulus. -/
def finalMove (ρ l v : Nat) : Bool :=
  cond (GameMask.bitOf c.transient ρ) (Nat.blt ρ (Nat.div v c.base))
    (Nat.ble ρ (Nat.div v c.base) &&
      (!Nat.beq (Nat.div v c.base) ρ || Nat.beq (Nat.mod v c.base) (Nat.mod (l + 1) (c.modOf ρ))))

/-- A node of height 0 at the last width, with cells `x` at phase `φ`, with this phase's codes `here` and the next
phase's `there`: both moves pass `finalMove`, and at a rank that is not transient the modulus is positive and the
column left of the repeating one, `center (φ + 1) xor (center φ || cell 1)`, is the certificate's value. -/
def finalNode (here there : KeyTrie) (φ x : Nat) : Bool :=
  c.finalMove (Nat.div (here.find x) c.base) (Nat.mod (here.find x) c.base)
      (there.find (GameMask.move c.levels.length (c.center φ) false x)) &&
    c.finalMove (Nat.div (here.find x) c.base) (Nat.mod (here.find x) c.base)
      (there.find (GameMask.move c.levels.length (c.center φ) true x)) &&
    (GameMask.bitOf c.transient (Nat.div (here.find x) c.base) ||
      (Nat.blt 0 (c.modOf (Nat.div (here.find x) c.base)) &&
        GameMask.bitOf c.values (Nat.div (here.find x) c.base * c.base + Nat.mod (here.find x) c.base) ==
          xor (c.center (φ + 1)) (c.center φ || GameMask.bitOf x 0)))

/-- The classes at phase `φ`: every node of height 0 at the last width passes `finalNode`. -/
def finalOk (φ : Nat) : Bool :=
  (c.tri c.levels.length φ).zeros.all fun x => c.finalNode (c.final.getD φ te) (c.final.getD (c.next φ) te) φ x

/-- A valid certificate: the block and the widths are not empty, and every width and the classes pass at every
phase. -/
def Valid : Prop :=
  0 < c.block.length ∧ 0 < c.levels.length ∧
    (∀ j φ, j < c.levels.length → φ < c.block.length → c.levelOk j φ = true) ∧
    ∀ φ, φ < c.block.length → c.finalOk φ = true

theorem levelNode_spec {w : Nat} {here there : KeyTrie} {cb : Bool} {x : Nat} (h : levelNode w here there cb x = true)
    (u : Bool) :
    (here.find x = 0 → there.find (GameMask.move w cb u x) = 0) ∧
      (here.find x ≠ 0 → there.find (GameMask.move w cb u x) < here.find x) := by
  unfold levelNode at h
  cases ha : Nat.beq (here.find x) 0
  · have hne : here.find x ≠ 0 := Nat.ne_of_beq_eq_false ha
    rw [ha] at h
    simp only [Bool.cond_false, Bool.and_eq_true, Nat.blt_eq] at h
    refine ⟨fun h0 => absurd h0 hne, fun _ => ?_⟩
    cases u
    · exact h.1
    · exact h.2
  · have he : here.find x = 0 := Nat.eq_of_beq_eq_true ha
    rw [ha] at h
    simp only [Bool.cond_true, Bool.and_eq_true] at h
    refine ⟨fun _ => ?_, fun h0 => absurd he h0⟩
    cases u
    · exact Nat.eq_of_beq_eq_true h.1
    · exact Nat.eq_of_beq_eq_true h.2

theorem finalMove_spec {ρ l v : Nat} (h : c.finalMove ρ l v = true) :
    (GameMask.bitOf c.transient ρ = true → ρ < v / c.base) ∧
      (GameMask.bitOf c.transient ρ = false →
        ρ ≤ v / c.base ∧ (v / c.base = ρ → v % c.base = (l + 1) % c.modOf ρ)) := by
  unfold finalMove at h
  cases ht : GameMask.bitOf c.transient ρ
  · rw [ht] at h
    simp only [Bool.cond_false, Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true', Nat.ble_eq] at h
    refine ⟨fun hf => Bool.noConfusion hf, fun _ => ⟨h.1, fun he => ?_⟩⟩
    rcases h.2 with h2 | h2
    · exact absurd (Nat.beq_eq_true_eq _ _ ▸ he) (by
        intro hb
        have : Nat.beq (Nat.div v c.base) ρ = true := by
          show Nat.beq (v / c.base) ρ = true
          rw [he]
          exact Nat.beq_refl ρ
        rw [this] at h2
        exact Bool.noConfusion h2)
    · exact Nat.eq_of_beq_eq_true h2
  · rw [ht] at h
    simp only [Bool.cond_true, Nat.blt_eq] at h
    exact ⟨fun _ => h, fun hf => Bool.noConfusion hf⟩

theorem finalNode_spec {here there : KeyTrie} {φ x : Nat} (h : c.finalNode here there φ x = true) (u : Bool) :
    c.finalMove (here.find x / c.base) (here.find x % c.base)
        (there.find (GameMask.move c.levels.length (c.center φ) u x)) = true ∧
      (GameMask.bitOf c.transient (here.find x / c.base) = false →
        0 < c.modOf (here.find x / c.base) ∧
          GameMask.bitOf c.values (here.find x / c.base * c.base + here.find x % c.base) =
            xor (c.center (φ + 1)) (c.center φ || GameMask.bitOf x 0)) := by
  unfold finalNode at h
  simp only [Bool.and_eq_true, Bool.or_eq_true, Nat.blt_eq, beq_iff_eq] at h
  refine ⟨?_, fun ht => ?_⟩
  · cases u
    · exact h.1.1
    · exact h.1.2
  · rcases h.2 with h2 | h2
    · exact absurd h2 (by show ¬ GameMask.bitOf c.transient (here.find x / c.base) = true; rw [ht]; decide)
    · exact h2

end ClassCert

/-- Cells `x .. x + n` as a number are cells `x .. x + n - 1` plus cell `x + n` at bit `n`. -/
theorem codeFrom_succ_top (init : Int → Bool) (t : Nat) :
    ∀ (n : Nat) (x : Int), codeFrom init t x (n + 1) = codeFrom init t x n + 2 ^ n * (evolve init t (x + n)).toNat
  | 0, x => by
    show (evolve init t x).toNat + 2 * 0 = 0 + 1 * (evolve init t (x + ((0 : Nat) : Int))).toNat
    rw [show x + ((0 : Nat) : Int) = x by omega]
    omega
  | n + 1, x => by
    show (evolve init t x).toNat + 2 * codeFrom init t (x + 1) (n + 1) =
      ((evolve init t x).toNat + 2 * codeFrom init t (x + 1) n) +
        2 ^ (n + 1) * (evolve init t (x + ((n + 1 : Nat) : Int))).toNat
    rw [codeFrom_succ_top init t n (x + 1), show x + 1 + (n : Int) = x + ((n + 1 : Nat) : Int) by omega, Nat.pow_succ]
    rw [Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm 2 (2 ^ n)]
    omega

/-- A number that stays at 0 once it is 0 and falls while it is not reaches 0 and stays there. -/
theorem descends (f : Nat → Nat) (T : Nat)
    (h : ∀ t, T ≤ t → (f t = 0 → f (t + 1) = 0) ∧ (f t ≠ 0 → f (t + 1) < f t)) :
    ∃ T1, T ≤ T1 ∧ ∀ t, T1 ≤ t → f t = 0 := by
  have reach : ∀ n s, T ≤ s → f s ≤ n → ∃ t, s ≤ t ∧ f t = 0 := by
    intro n
    induction n with
    | zero => exact fun s _ hs => ⟨s, Nat.le_refl _, by omega⟩
    | succ n ih =>
      intro s hs hfs
      by_cases h0 : f s = 0
      · exact ⟨s, Nat.le_refl _, h0⟩
      · obtain ⟨t, ht, hft⟩ := ih (s + 1) (by omega) (by have := (h s hs).2 h0; omega)
        exact ⟨t, by omega, hft⟩
  obtain ⟨T1, hT1, hf⟩ := reach (f T) T (Nat.le_refl _) (Nat.le_refl _)
  refine ⟨T1, hT1, fun t ht => ?_⟩
  have stay : ∀ d, f (T1 + d) = 0 := fun d => by
    induction d with
    | zero => exact hf
    | succ d ih => exact (h (T1 + d) (by omega)).1 ih
  have := stay (t - T1)
  rwa [show T1 + (t - T1) = t by omega] at this

/-- A sequence that repeats with period `p` from `T` on repeats with period `p * q`. -/
theorem periodic_mul {α : Type} (f : Nat → α) (T p : Nat) (h : ∀ t, T ≤ t → f (t + p) = f t) :
    ∀ q t, T ≤ t → f (t + p * q) = f t
  | 0, t, _ => by rw [Nat.mul_zero, Nat.add_zero]
  | q + 1, t, ht => by
    rw [Nat.mul_succ, ← Nat.add_assoc, h (t + p * q) (by omega), periodic_mul f T p h q t ht]

/-- **The game with cyclic classes.** No column of the orbit of a row with a leftmost 1 repeats, from some time on and
in any rotation, a block with a valid certificate. -/
theorem class_column (init : Int → Bool) (m : Int) (hm : init m = true) (hz : ∀ x : Int, x < m → init x = false)
    (c : ClassCert) (hc : c.Valid) (k : Int) (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → evolve init t k = c.center (t + shift)) : False := by
  obtain ⟨hP, hW, hlev, hfin⟩ := hc
  let phase : Nat → Nat := fun t => (t + shift) % c.block.length
  let code : Nat → Nat → Nat := fun j t => codeFrom init t (k + 1) j
  have hphase : ∀ t, phase t < c.block.length := fun t => Nat.mod_lt _ hP
  have hcenter : ∀ t, T ≤ t → evolve init t k = c.center (phase t) := fun t ht => by
    rw [h t ht]
    show bit c.block ((t + shift) % c.block.length) = bit c.block ((t + shift) % c.block.length % c.block.length)
    rw [Nat.mod_mod]
  have hnext : ∀ t, c.next (phase t) = phase (t + 1) := fun t => by
    show ((t + shift) % c.block.length + 1) % c.block.length = (t + 1 + shift) % c.block.length
    rw [mod_succ_mod, show t + 1 + shift = t + shift + 1 by omega]
  have hstep : ∀ j t, T ≤ t →
      code j (t + 1) = GameMask.move j (c.center (phase t)) (evolve init t (k + 1 + j)) (code j t) := fun j t ht => by
    show codeFrom init (t + 1) (k + 1) j = _
    rw [codeFrom_succ, show k + 1 - 1 = k by omega, hcenter t ht, GameMask.move_eq]
  -- every width in turn: from some time on the first `j` cells have height 0
  have hlevels : ∀ j, j ≤ c.levels.length →
      ∃ Tj, T ≤ Tj ∧ ∀ t, Tj ≤ t → (c.tri j (phase t)).find (code j t) = 0 := by
    intro j
    induction j with
    | zero => exact fun _ => ⟨T, Nat.le_refl _, fun t _ => rfl⟩
    | succ j ih =>
      intro hj
      obtain ⟨Tj, hTj, hzero⟩ := ih (by omega)
      have node : ∀ t, Tj ≤ t → ClassCert.levelNode (j + 1) (c.tri (j + 1) (phase t))
          (c.tri (j + 1) (c.next (phase t))) (c.center (phase t)) (code (j + 1) t) = true := by
        intro t ht
        have hall := hlev j (phase t) (by omega) (hphase t)
        have hp := List.all_eq_true.mp hall _ (KeyTrie.mem_zeros _ _ (hzero t ht))
        rw [Bool.and_eq_true] at hp
        show ClassCert.levelNode _ _ _ _ (codeFrom init t (k + 1) (j + 1)) = true
        rw [codeFrom_succ_top]
        cases evolve init t (k + 1 + (j : Int))
        · rw [Bool.toNat_false, Nat.mul_zero, Nat.add_zero]
          exact hp.1
        · rw [Bool.toNat_true, Nat.mul_one]
          exact hp.2
      let f : Nat → Nat := fun t => (c.tri (j + 1) (phase t)).find (code (j + 1) t)
      have hf : ∀ t, Tj ≤ t → (f t = 0 → f (t + 1) = 0) ∧ (f t ≠ 0 → f (t + 1) < f t) := by
        intro t ht
        have e : f (t + 1) = (c.tri (j + 1) (c.next (phase t))).find
            (GameMask.move (j + 1) (c.center (phase t)) (evolve init t (k + 1 + ((j + 1 : Nat) : Int)))
              (code (j + 1) t)) := by
          show (c.tri (j + 1) (phase (t + 1))).find (code (j + 1) (t + 1)) = _
          rw [← hnext t, hstep (j + 1) t (by omega)]
        rw [e]
        exact ClassCert.levelNode_spec (node t ht) _
      obtain ⟨T1, hT1, hT1z⟩ := descends f Tj hf
      exact ⟨T1, by omega, hT1z⟩
  -- the classes on the last width
  obtain ⟨TW, hTW, hzW⟩ := hlevels c.levels.length (Nat.le_refl _)
  let W := c.levels.length
  let v : Nat → Nat := fun t => (c.final.getD (phase t) te).find (code W t)
  have fnode : ∀ t, TW ≤ t →
      c.finalNode (c.final.getD (phase t) te) (c.final.getD (c.next (phase t)) te) (phase t) (code W t) = true := fun t ht =>
    List.all_eq_true.mp (hfin (phase t) (hphase t)) _ (KeyTrie.mem_zeros _ _ (hzW t ht))
  have hv : ∀ t, TW ≤ t → v (t + 1) = (c.final.getD (c.next (phase t)) te).find
      (GameMask.move W (c.center (phase t)) (evolve init t (k + 1 + (W : Int))) (code W t)) := fun t ht => by
    show (c.final.getD (phase (t + 1)) te).find (code W (t + 1)) = _
    rw [← hnext t, hstep W t (by omega)]
  have hmove : ∀ t, TW ≤ t → c.finalMove (v t / c.base) (v t % c.base) (v (t + 1)) = true := fun t ht => by
    rw [hv t ht]
    exact (c.finalNode_spec (fnode t ht) _).1
  let ρ : Nat → Nat := fun t => v t / c.base
  have hmono : ∀ t, TW ≤ t → ρ t ≤ ρ (t + 1) := fun t ht => by
    have hs := c.finalMove_spec (hmove t ht)
    cases htr : GameMask.bitOf c.transient (ρ t)
    · exact (hs.2 htr).1
    · exact Nat.le_of_lt (hs.1 htr)
  have hbound : ∀ t, ρ t ≤ KeyTrie.listBound c.final := fun t =>
    Nat.le_trans (Nat.div_le_self _ _) (KeyTrie.find_le_listBound _ _ _)
  obtain ⟨t1, ht1, hconst⟩ := settles ρ _ hbound _ TW (Nat.le_refl _) hmono
  have stable : GameMask.bitOf c.transient (ρ t1) = false := by
    cases htr : GameMask.bitOf c.transient (ρ t1)
    · rfl
    · have hlt := (c.finalMove_spec (hmove t1 (by omega))).1 htr
      have := hconst (t1 + 1) (by omega)
      exact absurd hlt (by show ¬ ρ t1 < ρ (t1 + 1); omega)
  let M := c.modOf (ρ t1)
  let l : Nat → Nat := fun t => v t % c.base
  have hlab : ∀ t, t1 ≤ t → l (t + 1) = (l t + 1) % M := fun t ht => by
    have hs := c.finalMove_spec (hmove t (by omega))
    have hρ : ρ t = ρ t1 := hconst t ht
    have hρ' : ρ (t + 1) = ρ t1 := hconst (t + 1) (by omega)
    have := (hs.2 (by show GameMask.bitOf c.transient (ρ t) = false; rw [hρ]; exact stable)).2
      (by show ρ (t + 1) = ρ t; rw [hρ, hρ'])
    show v (t + 1) % c.base = (v t % c.base + 1) % c.modOf (ρ t1)
    rw [this]
    show (l t + 1) % c.modOf (ρ t) = _
    rw [hρ]
  have hval : ∀ t, t1 ≤ t → 0 < M ∧ evolve init t (k - 1) = GameMask.bitOf c.values (ρ t1 * c.base + l t) :=
    fun t ht => by
    have hρ : ρ t = ρ t1 := hconst t ht

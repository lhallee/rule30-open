/-- **The center column.** It does not repeat, from any time `T` on and read from any phase, a block with a valid
certificate. -/
theorem center_not_class (c : ClassCert) (hc : c.Valid) (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → Rule30Prize.center t = c.block.getD ((t + shift) % c.block.length) false) : False :=
  class_column single 0 rfl (fun x hx => decide_eq_false (by omega)) c hc 0 T shift fun t ht => by
    rw [evolve_single_center, h t ht]
    show _ = bit c.block ((t + shift) % c.block.length)
    rw [bit_eq_getD]

/-- The same in the kit's form `Rule30StripCertificates.EventuallyWord`. -/
theorem class_not_eventuallyWord (c : ClassCert) (hc : c.Valid) :
    ¬ Rule30StripCertificates.EventuallyWord c.block := by
  have hP : 0 < c.block.length := hc.1
  rintro ⟨T, hT⟩
  refine center_not_class c hc T (c.block.length * T - T) fun t ht => ?_
  rw [← evolve_single_center, evolve_single_eq_cell]
  show Rule30Jen.cell t 0 = _
  have hLT : T ≤ c.block.length * T := Nat.le_mul_of_pos_left T hP
  rw [hT t ht, show t + (c.block.length * T - T) = t - T + c.block.length * T by omega, Nat.add_mul_mod_self_left]


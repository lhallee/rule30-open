/-!
# Traps that pass the tests of reach, refuted by a wider trap of their block

The test of reach of [MissedTraps](MissedTraps.md) asks, in a finite game, whether every node can reach a trap; it
refutes entry into a trap when the nodes that cannot form a set that no move leaves. A set that no move leaves can be
wider than every game searched: another trap of the same block, closed whatever the cells beyond it do. Here, for 48
traps that pass the tests of reach and of halves apart, another trap of their block, wider than the games tested, is
apart from them: no state of it, cut to the narrower width, is a state of the first whose label reads the same phase.
So a right half that starts in the other trap never enters the first, and entry into the first is false. The block
still comes down to entry into one of the two traps.

* `apart_<trap>_closed`: the other trap is closed. `apart_<trap>`: the states of the trap cut to the narrower width, by
  label, as a set of windows of [ReachRefuted](ReachRefuted.md), with `_holds` and `_avoids`.
* `<trap>_not_absorption_apart`: the refutation, by `not_absorption_fwd`.
* `pair_<block>`, `pair_<block>_excludes`: the two traps, and the reduction of the block to entry into one of them, by
  `absorption_some_excludes` of [TrapPairs](TrapPairs.md).

The tables come from `python -m computations.lock_chain --lean-apart-traps`. The natural-language argument is
`ApartTraps.md`, beside this file.
-/

@[expose] public section

-- Sequential elaboration: the kernel checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Rule30Open

open Ruliology.CellularAutomata BitGame

theorem apart_natw0000000001_closed : ten23.closedCheck = true :=
  by decide +kernel

/-- The states of `natw0000000001` cut to 16 cells, by label. -/
def apart_natw0000000001 : WinSet :=
  { b := [false, false, false, false, false, false, false, false, false, true], K := 16,
    sizes := [685, 675, 667, 647, 626, 607, 596, 610, 645, 655],
    rows := [, , , , , , , , , ] }

theorem apart_natw0000000001_holds : apart_natw0000000001.holds natw0000000001 = true := by
  decide +kernel

theorem apart_natw0000000001_avoids : apart_natw0000000001.avoids ten23 = true := by
  decide +kernel

/-- **Entry into `natw0000000001` is false**: the right half of state 0 of `ten23` never enters it. -/
theorem natw0000000001_not_absorption_apart : ¬ natw0000000001.Absorption :=
  not_absorption_fwd _ ten23 apart_natw0000000001 apart_natw0000000001_closed rfl rfl (by decide)
    (by decide) apart_natw0000000001_holds apart_natw0000000001_avoids (by decide)

/-- The two traps of `0000000001`. -/
def pair_0000000001 : List WTrap := [ten23, natw0000000001]

/-- **`0000000001` reduced to entry into one of its two traps.** -/
theorem pair_0000000001_excludes (hA : WTrap.AbsorptionSome pair_0000000001) :
    ¬ Rule30StripCertificates.EventuallyWord
      [false, false, false, false, false, false, false, false, false, true] := by
  refine absorption_some_excludes _ pair_0000000001 ?_ ?_ hA <;>
    simp only [pair_0000000001, List.mem_cons, List.not_mem_nil, or_false] <;> rintro C (rfl | rfl)
  · rfl
  · rfl
  · decide +kernel
  · exact natw0000000001_check


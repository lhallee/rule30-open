/-- **The first wall, from phases 0, 1 and 2.** No finite configuration whose cells `1 .. 119,992` are white has a
center column that repeats `001011111` from phase 0, 1 or 2: the white half enters `trap001011111` at step 119,947 from
phase 2, and one and two steps later from phases 1 and 0, where the block reads white first. -/
theorem white_first_wall (φ : Nat) (hφ : φ < 3) : HighRightW trap001011111.b 119992 φ := by
  obtain rfl | rfl | rfl : φ = 0 ∨ φ = 1 ∨ φ = 2 := by omega
  · refine highRightW_mono ?_ (highRightW_of_entry (T := 2 + 119947) (i := 166) trap001011111 trap001011111_check (by decide)
      (by decide) ⟨2, by decide⟩
      (by rw [rowN_delay trap001011111.b 0 2 2 119947 rfl (by decide), trap001011111_K]; exact nwa_entry))
    rw [trap001011111_K]
    decide
  · refine highRightW_mono ?_ (highRightW_of_entry (T := 1 + 119947) (i := 166) trap001011111 trap001011111_check (by decide)
      (by decide) ⟨1, by decide⟩
      (by rw [rowN_delay trap001011111.b 1 1 2 119947 rfl (by decide), trap001011111_K]; exact nwa_entry))
    rw [trap001011111_K]
    decide
  · refine highRightW_mono ?_ (highRightW_of_entry (T := 119947) (i := 166) trap001011111 trap001011111_check (by decide)
      (by decide) ⟨0, by decide⟩
      (by rw [trap001011111_K]; exact nwa_entry))
    rw [trap001011111_K]
    decide


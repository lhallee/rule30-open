/-!
# Right halves white on their first 91,129 to 201,172 cells enter the walls of period 9

`NineTraps` reduces the blocks `001011111` and `001010011` of period 9 to entry into their walls, traps of 43 and 41
cells. The white right half enters them, but only after `10^5` steps or more. Here the kernel runs the white half in
parts of 16,384 steps (`runDrive`, `part`), each row cut to the cells that can still reach the window (`rowN_mod`, the
light cone), up to its entry: into `trap001011111` at step 119,947 from phase 2 and 201,129 from phase 8, and into
`trap001010011` at step 91,086 from phase 7 and 169,098 from phase 2. By the light cone again, every right half white on
the first `T + K` cells is in the same state at step `T`, and entry then excludes the block for every finite
configuration (`highRightW_of_entry`, with `wtrap_column` of `WordTraps`).

* `HighRightW b B φ`: no finite configuration white on cells `1 .. B` has a center column that repeats `b` from phase
  `φ`.
* `white_first_wall`, `white_first_wall_eight`: `001011111` from phases 0, 1, 2 with `B = 119,992`, and from phase 8
  with `B = 201,172`.
* `white_second_wall`, `white_second_wall_zero`: `001010011` from phases 5, 6, 7 with `B = 91,129`, and from phases
  0, 1, 2 with `B = 169,141`.

The natural-language argument is `NineWhite.md`, beside this file. The rows and parts come from
`python -m computations.lock_chain --lean-white`.
-/

@[expose] public section

-- Sequential elaboration: the kernel checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Rule30Open

open Ruliology.CellularAutomata BitGame
open Rule30Ether Rule30EtherThree Rule30Realization Rule30PeriodTwoSideways

/-- The block `b` read from phase `φ`: the center column of a right half driven by `b` from that phase. -/
def phased (b : List Bool) (φ t : Nat) : Bool := b.getD ((t + φ) % b.length) false

theorem phased_shift (b : List Bool) (φ a : Nat) : (fun t => phased b φ (t + a)) = phased b (φ + a) := by
  funext t
  unfold phased
  rw [show t + a + φ = t + (φ + a) by omega]

theorem rowN_add (c : Nat → Bool) (x0 a : Nat) :
    ∀ n, rowN c x0 (a + n) = rowN (fun t => c (t + a)) (rowN c x0 a) n
  | 0 => rfl
  | n + 1 => by
    show stepN (c (a + n)) (rowN c x0 (a + n)) =
      stepN (c (n + a)) (rowN (fun t => c (t + a)) (rowN c x0 a) n)
    rw [rowN_add c x0 a n, Nat.add_comm a n]

/-- **The light cone.** The first `L` cells after `n` steps depend only on the first `L + n` cells at the start. -/
theorem rowN_mod (c : Nat → Bool) (x L n : Nat) :
    rowN c (x % 2 ^ (L + n)) n % 2 ^ L = rowN c x n % 2 ^ L := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_mod_two_pow, Nat.testBit_mod_two_pow]
  by_cases hi : i < L
  · rw [decide_eq_true hi, Bool.true_and, Bool.true_and, rowN_eq_drv, rowN_eq_drv]
    apply drv_cone
    intro q hq1 hq2
    show (x % 2 ^ (L + n)).testBit (q - 1) = x.testBit (q - 1)
    rw [Nat.testBit_mod_two_pow, decide_eq_true (by omega), Bool.true_and]
  · rw [decide_eq_false hi, Bool.false_and, Bool.false_and]

theorem ble_zero (a : Nat) : Nat.ble 0 a = true := by
  rw [Nat.ble_eq]
  exact Nat.zero_le a

/-- `n` steps of the right half driven by `b` from phase `p`, with each step's row forced by a `Nat.ble 0` test, as in
`WideWindow.runRel`, so that the kernel runs it as a loop. -/
def runDrive (b : List Bool) : Nat → Nat → Nat → Nat
  | 0, _, r => r
  | n + 1, p, r =>
    if Nat.ble 0 (stepN (b.getD (p % b.length) false) r) = true
    then runDrive b n (p + 1) (stepN (b.getD (p % b.length) false) r) else 0

theorem runDrive_eq (b : List Bool) : ∀ n p r, runDrive b n p r = rowN (phased b p) r n
  | 0, _, _ => rfl
  | n + 1, p, r => by
    unfold runDrive
    rw [ite_eq_left (ble_zero _), runDrive_eq b n (p + 1), show n + 1 = 1 + n by omega, rowN_add, phased_shift]
    show _ = rowN (phased b (p + 1)) (stepN (phased b p 0) r) n
    unfold phased
    rw [Nat.zero_add]

/-- **One part of the run.** If `r` is the first `P + d` cells of the run at step `s`, and `d` forced steps from `r`
give `r'` on the first `P` cells, then `r'` is the first `P` cells at step `s + d`. -/
theorem part (b : List Bool) (φ s d s' P Q r r' : Nat) (hs : s' = s + d) (hQ : Q = P + d)
    (hr : rowN (phased b φ) 0 s % 2 ^ Q = r) (h : runDrive b d (φ + s) r % 2 ^ P = r') :
    rowN (phased b φ) 0 s' % 2 ^ P = r' := by
  subst hs hQ
  rw [rowN_add, phased_shift, ← rowN_mod _ _ P d, hr, ← runDrive_eq, h]

/-- No finite configuration whose cells `1 .. B` are white has a center column that repeats `b` from phase `φ`. -/
def HighRightW (b : List Bool) (B φ : Nat) : Prop :=
  ¬ ∃ y : Int → Bool, FinConfig y ∧ (∀ p : Int, 0 < p → p ≤ (B : Int) → y p = false) ∧
    ∀ t, evol y t 0 = phased b φ t

/-- **Entry of the white half travels along the light cone.** If the run of the white half driven by the block of a
checked trap from phase `φ` has its first `K` cells equal to state `i` at step `T`, with the label of the right phase,
then no finite configuration white on cells `1 .. T + K` has a center column that repeats the block from phase `φ`. -/
theorem highRightW_of_entry (C : WTrap) (hC : C.check = true) {φ T i : Nat} (hi : i < C.n)
    (hph : (T + φ) % C.b.length = C.lab i % C.b.length) (hw : ∃ t, phased C.b φ t = true)
    (h : rowN (phased C.b φ) 0 T % 2 ^ C.K = C.st i) : HighRightW C.b (T + C.K) φ := by
  rintro ⟨y, hfin, hR, hc⟩
  obtain ⟨-, hK, -, -, -⟩ := C.facts hC
  have hne : ∃ p, y p = true := by
    refine Classical.byContradiction fun hz => ?_
    have hz' : ∀ p, y p = false := fun p => by
      cases hp : y p
      · rfl
      · exact absurd ⟨p, hp⟩ hz
    obtain ⟨t, ht⟩ := hw
    rw [← hc t, Rule30Coupled.evol_zero hz'] at ht
    exact absurd ht (by decide)
  obtain ⟨lo, hlo, hzero⟩ := Rule30FiniteConfigs.exists_leftmost hfin hne
  have hcen : ∀ t : Nat, 0 ≤ t → evolve y t 0 = col C.b (t + φ) := by
    intro t _
    rw [evolve_eq_evol, hc t]
    unfold phased col
    rw [bit_eq_getD]
  have hdrive : (fun t => evol y t 0) = phased C.b φ := funext hc
  refine wtrap_column C hC y lo hlo hzero 0 0 φ hcen T i (Nat.zero_le _) hi hph ?_
  apply Nat.eq_of_testBit_eq
  intro j
  rw [testBit_codeFrom]
  by_cases hj : j < C.K
  · rw [decide_eq_true hj, Bool.true_and, evolve_eq_evol, show (0 : Int) + 1 + (j : Int) = ((j + 1 : Nat) : Int) by omega,
      Rule30Coupled.right_eq_drv, hdrive, ← h, Nat.testBit_mod_two_pow, decide_eq_true hj, Bool.true_and, rowN_eq_drv]
    apply drv_cone
    intro q hq1 hq2
    rw [hR (q : Int) (by omega) (by omega)]
    exact (Nat.zero_testBit _).symm
  · rw [decide_eq_false hj, Bool.false_and]
    have hlt : C.st i < 2 ^ C.K := Nat.mod_lt _ (Nat.two_pow_pos _)
    exact (Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le hlt (Nat.pow_le_pow_right (by decide) (by omega)))).symm

/-- **The white half from an earlier phase.** If the run from phase `φ` is still white after `a` steps, the run from
phase `φ` at step `a + T` is the run from phase `ψ = φ + a` at step `T`. -/
theorem rowN_delay (b : List Bool) (φ a ψ T : Nat) (hψ : ψ = φ + a) (h : rowN (phased b φ) 0 a = 0) :
    rowN (phased b φ) 0 (a + T) = rowN (phased b ψ) 0 T := by
  rw [rowN_add, phased_shift, h, hψ]

/-- The run starts white. -/
theorem start (b : List Bool) (φ Q : Nat) : rowN (phased b φ) 0 0 % 2 ^ Q = 0 := Nat.zero_mod _

theorem highRightW_mono {b : List Bool} {B B' φ : Nat} (hB : B ≤ B') (h : HighRightW b B φ) :
    HighRightW b B' φ := by
  rintro ⟨y, hfin, hR, hc⟩
  exact h ⟨y, hfin, fun p h1 h2 => hR p h1 (by omega), hc⟩

theorem trap001011111_K : trap001011111.K = 43 := rfl

theorem trap001010011_K : trap001010011.K = 41 := rfl



/-! ### The three words of period four -/

/-- **Every right half white on cells 13 to 750 enters the family under `0001`**, in every phase, whatever its
first twelve cells and its cells beyond 750. -/
theorem twelve_0001 (φ : Nat) (x : Nat → Bool) (hx : ∀ p, 12 < p → p ≤ 750 → x p = false) :
    ∃ a ∈ A0001, ∃ t1, InFamily (drv (fun t => wordAt w0001 (t + φ)) x) a.1 (a.2 + φ) t1 := by
  refine gap_phase ?_
  rcases (show φ % 4 = 0 ∨ φ % 4 = 1 ∨ φ % 4 = 2 ∨ φ % 4 = 3 by omega) with h | h | h | h <;> rw [h]
  · exact twelve_absorption twelveCover0001_0 x hx
  · exact twelve_absorption twelveCover0001_1 x hx
  · exact twelve_absorption twelveCover0001_2 x hx
  · exact twelve_absorption twelveCover0001_3 x hx

/-- **Every right half white on cells 13 to 995 enters the family under `0011`**, in every phase, whatever its
first twelve cells and its cells beyond 995. -/

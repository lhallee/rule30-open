/-! ### No center column repeats the word -/

/-- **No finite configuration whose cells 13 to 750 are white has a center column that repeats `0001`**, in any
phase, whatever its left half, its first twelve cells and its cells beyond 750. -/
theorem twelveRight_0001 (φ : Nat) : GapRight w0001 12 750 φ :=
  gapRight_of_absorption A0001_ok ⟨3, rfl⟩ (twelve_0001 φ)

/-- **No finite configuration whose right half has at most twelve cells has a center column that repeats `0001`.** -/
theorem smallTwelve_0001 (φ : Nat) : SmallRight w0001 12 φ := smallRight_of_gapRight (twelveRight_0001 φ)

/-- **No finite configuration whose cells 13 to 995 are white has a center column that repeats `0011`**, in any
phase, whatever its left half, its first twelve cells and its cells beyond 995. -/
theorem twelveRight_0011 (φ : Nat) : GapRight w0011 12 995 φ :=
  gapRight_of_absorption A0011_ok ⟨3, rfl⟩ (twelve_0011 φ)

/-- **No finite configuration whose right half has at most twelve cells has a center column that repeats `0011`.** -/
theorem smallTwelve_0011 (φ : Nat) : SmallRight w0011 12 φ := smallRight_of_gapRight (twelveRight_0011 φ)

/-- **No finite configuration whose cells 13 to 560 are white has a center column that repeats `0111`**, in any
phase, whatever its left half, its first twelve cells and its cells beyond 560. -/
theorem twelveRight_0111 (φ : Nat) : GapRight w0111 12 560 φ :=

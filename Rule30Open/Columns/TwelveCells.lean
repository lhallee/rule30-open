module

public import Rule30Open.Columns.TenCells

/-!
# Twelve cells: absorption for every right half that is white past its first twelve cells

Every right half of at most twelve cells, driven by a word of period four from any phase, enters the kit's
ether-and-wall family, as [TenCells](TenCells.md) shows for ten. So every right half whose cells `13 .. G` are white
enters, whatever its first twelve cells and whatever lies beyond `G`, with `G = 750`, `995` and `560` for `0001`, `0011`
and `0111` (`twelve_0001`, `twelve_0011`, `twelve_0111`), and no finite configuration with such a right half has a
center column that repeats the word (`twelveRight_0001`, `twelveRight_0011`, `twelveRight_0111`). In particular no
finite configuration whose right half has at most twelve cells does (`smallTwelve_0001`, `smallTwelve_0011`,
`smallTwelve_0111`).

The entries come from `computations/small_halves.py`, 128 halves to a kernel check (`halvesOK` of TenCells), and
`chunks_cover` gathers the 32 chunks of each word and phase.

The natural-language argument is `TwelveCells.md`, beside this file.
-/

@[expose] public section

-- Sequential elaboration: the kernel checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Rule30Open

open Ruliology.CellularAutomata
open Rule30Jen Rule30Realization Rule30Ether Rule30StripCertificates Rule30PeriodTwoSideways

/-- Chunks of 128 halves cover every half below `128 * n`. -/
theorem chunks_cover {w : List Bool} {A : List (Nat × Nat)} {φ G : Nat} {L : List Nat} (n : Nat)
    (h : ∀ i, i < n → halvesOK w A φ G 128 (128 * i) (L.getD i 0) = true) :
    ∀ r, r < 128 * n → ∃ t k, entryOK w A φ G r t k = true := by
  intro r hr
  exact halvesOK_spec _ _ _ (h (r / 128) (by omega)) r (by omega) (by omega)

/-- **Absorption across a white gap after twelve cells.** If every right half below `2 ^ 12` has a passing entry,
every right half whose cells `13 .. G` are white enters the family, whatever lies beyond `G`. -/
theorem twelve_absorption {w : List Bool} {A : List (Nat × Nat)} {φ G : Nat}
    (hcheck : ∀ r, r < 2 ^ 12 → ∃ t k, entryOK w A φ G r t k = true)
    (x : Nat → Bool) (hx : ∀ p, 12 < p → p ≤ G → x p = false) :
    ∃ a ∈ A, ∃ t1, InFamily (drv (fun t => wordAt w (t + φ)) x) a.1 (a.2 + φ) t1 := by
  obtain ⟨r, hr, hxr⟩ := pack_gap 12 G x hx
  obtain ⟨t, k, hok⟩ := hcheck r hr
  obtain ⟨hG, a, ha, hf⟩ := entryOK_spec hok
  exact ⟨a, ha, t, inFamily_of_fast hf fun q h1 h2 => hxr q h1 (by omega)⟩


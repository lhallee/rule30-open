module

public import Rule30Open.Columns.ForcedBasin

/-!
# The forced basin of the period-four family at width 18

`ForcedBasin` at width 18, for the three words. The kernel computes the basin's rounds as there, cut into parts
of at most 16 rounds: each part starts from the stored set where the last one ended and is checked to end at the
next stored set (`ck<word>_18_<i>_ok`), and the last part ends with the counts. `ForcedBasin.basinFrom_add` joins
the parts, so the theorems are about the same set as at widths 14 and 16, the basin after all its rounds. Written by
`python -m computations.forced_basin lean --width 18 --size 16`.

The natural-language argument is `ForcedBasin18.md`, beside this file.
-/

@[expose] public section

namespace Rule30Open

open Ruliology.CellularAutomata Rule30Ether ForcedBasin

set_option Elab.async false

/-- The nodes of rank at most 14. -/
def ck0001_18_1 : Nat :=
  

theorem ck0001_18_1_ok :
    basinFrom w0001 18 (target A0001 18) (target A0001 18) 14 = spread 18 ck0001_18_1 := by
  decide +kernel

/-- The nodes of rank at most 28. -/
def ck0001_18_2 : Nat :=
  

theorem ck0001_18_2_ok :
    basinFrom w0001 18 (target A0001 18) (spread 18 ck0001_18_1) 14 = spread 18 ck0001_18_2 := by
  decide +kernel

theorem counts0001_18 :
    (List.range 4).map (countPhase 18 (basinFrom w0001 18 (target A0001 18) (spread 18 ck0001_18_2) 14)) =
      [21588, 21096, 19829, 18456] := by
  decide +kernel

theorem forcedBasin_0001_18 :
    Covers w0001 A0001 18 42 (basin w0001 A0001 18 42) [21588, 21096, 19829, 18456] :=
  covers_of_counts rfl A0001_ok ⟨3, rfl⟩ (by decide) 42 _ (by
    rw [show basin w0001 A0001 18 42 = basinFrom w0001 18 (target A0001 18) (spread 18 ck0001_18_2) 14 by
      unfold basin
      rw [show 42 = 14 + 14 + 14 from rfl, basinFrom_add, basinFrom_add]
      rw [ck0001_18_1_ok, ck0001_18_2_ok]]
    exact counts0001_18)


/-! ### No center column repeats the word -/

/-- White cells beyond `n` are in particular white on `n + 1 .. B`. -/
theorem smallRight_of_gapRight {w : List Bool} {n B φ : Nat} (h : GapRight w n B φ) : SmallRight w n φ := by
  rintro ⟨y, hfin, hR, hc⟩
  exact h ⟨y, hfin, fun p h1 _ => hR p h1, hc⟩

/-- **No finite configuration whose cells 11 to 562 are white has a center column that repeats `0001`**, in any
phase, whatever its left half, its first ten cells and its cells beyond 562. -/
theorem tenRight_0001 (φ : Nat) : GapRight w0001 10 562 φ :=
  gapRight_of_absorption A0001_ok ⟨3, rfl⟩ (ten_0001 φ)

/-- **No finite configuration whose right half has at most ten cells has a center column that repeats `0001`.** -/
theorem smallTen_0001 (φ : Nat) : SmallRight w0001 10 φ := smallRight_of_gapRight (tenRight_0001 φ)

/-- **No finite configuration whose cells 11 to 654 are white has a center column that repeats `0011`**, in any
phase, whatever its left half, its first ten cells and its cells beyond 654. -/
theorem tenRight_0011 (φ : Nat) : GapRight w0011 10 654 φ :=
  gapRight_of_absorption A0011_ok ⟨3, rfl⟩ (ten_0011 φ)

/-- **No finite configuration whose right half has at most ten cells has a center column that repeats `0011`.** -/
theorem smallTen_0011 (φ : Nat) : SmallRight w0011 10 φ := smallRight_of_gapRight (tenRight_0011 φ)

/-- **No finite configuration whose cells 11 to 371 are white has a center column that repeats `0111`**, in any
phase, whatever its left half, its first ten cells and its cells beyond 371. -/
theorem tenRight_0111 (φ : Nat) : GapRight w0111 10 371 φ :=
  gapRight_of_absorption A0111_ok ⟨3, rfl⟩ (ten_0111 φ)

/-- **No finite configuration whose right half has at most ten cells has a center column that repeats `0111`.** -/
theorem smallTen_0111 (φ : Nat) : SmallRight w0111 10 φ := smallRight_of_gapRight (tenRight_0111 φ)

end Rule30Open

module

public import Rule30Open.Columns.SparseRight

/-!
# Ten cells: absorption for every right half that is white past its first ten cells

Every right half of at most ten cells, driven by a word of period four from any phase, enters the kit's
ether-and-wall family, and entry at step `t` and depth `k` reads only the initial cells `1 .. t + k + 13`
(`SparseRight.inFamily_of_fast`). So every right half whose cells `11 .. G` are white enters, whatever its first ten
cells and whatever lies beyond `G`, with `G = 562`, `654` and `371` for `0001`, `0011` and `0111` (`ten_0001`,
`ten_0011`, `ten_0111`), and no finite configuration with such a right half has a center column that repeats the word
(`tenRight_0001`, `tenRight_0011`, `tenRight_0111`). In particular no finite configuration whose right half has at
most ten cells does (`smallTen_0001`, `smallTen_0011`, `smallTen_0111`).

The entries come from `computations/small_halves.py`, 128 halves to a kernel check (`halvesOK`).

The natural-language argument is `TenCells.md`, beside this file.
-/

@[expose] public section

-- Sequential elaboration: the kernel checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Rule30Open

open Ruliology.CellularAutomata
open Rule30Jen Rule30Realization Rule30Ether Rule30StripCertificates Rule30PeriodTwoSideways

/-- The halves `r, r + 1, ..., r + n - 1` enter at the steps and depths packed in `D`, 17 bits each. -/
def halvesOK (w : List Bool) (A : List (Nat × Nat)) (φ G : Nat) : Nat → Nat → Nat → Bool
  | 0, _, _ => true
  | n + 1, r, D => entryOK w A φ G r (entryAt D / 64) (entryAt D % 64) && halvesOK w A φ G n (r + 1) (D >>> 17)

theorem halvesOK_spec {w : List Bool} {A : List (Nat × Nat)} {φ G : Nat} :
    ∀ n r D, halvesOK w A φ G n r D = true → ∀ h, r ≤ h → h < r + n → ∃ t k, entryOK w A φ G h t k = true
  | 0, r, D, _, h, h1, h2 => absurd h2 (by omega)
  | n + 1, r, D, hok, h, h1, h2 => by
    unfold halvesOK at hok
    rw [Bool.and_eq_true] at hok
    by_cases hr : h = r
    · subst hr; exact ⟨_, _, hok.1⟩
    · exact halvesOK_spec n (r + 1) (D >>> 17) hok.2 h (by omega) (by omega)

/-- **Absorption across a white gap after ten cells.** If every right half below `2 ^ 10` has a passing entry, every
right half whose cells `11 .. G` are white enters the family, whatever lies beyond `G`. -/
theorem ten_absorption {w : List Bool} {A : List (Nat × Nat)} {φ G : Nat}
    (hcheck : ∀ r, r < 2 ^ 10 → ∃ t k, entryOK w A φ G r t k = true)
    (x : Nat → Bool) (hx : ∀ p, 10 < p → p ≤ G → x p = false) :
    ∃ a ∈ A, ∃ t1, InFamily (drv (fun t => wordAt w (t + φ)) x) a.1 (a.2 + φ) t1 := by
  obtain ⟨r, hr, hxr⟩ := pack_gap 10 G x hx
  obtain ⟨t, k, hok⟩ := hcheck r hr
  obtain ⟨hG, a, ha, hf⟩ := entryOK_spec hok
  exact ⟨a, ha, t, inFamily_of_fast hf fun q h1 h2 => hxr q h1 (by omega)⟩

/-- Eight chunks of 128 halves cover every half below `2 ^ 10`. -/
theorem chunks8 {w : List Bool} {A : List (Nat × Nat)} {φ G : Nat} {L : List Nat}
    (h0 : halvesOK w A φ G 128 0 (L.getD 0 0) = true) (h1 : halvesOK w A φ G 128 128 (L.getD 1 0) = true)
    (h2 : halvesOK w A φ G 128 256 (L.getD 2 0) = true) (h3 : halvesOK w A φ G 128 384 (L.getD 3 0) = true)
    (h4 : halvesOK w A φ G 128 512 (L.getD 4 0) = true) (h5 : halvesOK w A φ G 128 640 (L.getD 5 0) = true)
    (h6 : halvesOK w A φ G 128 768 (L.getD 6 0) = true) (h7 : halvesOK w A φ G 128 896 (L.getD 7 0) = true) :
    ∀ r, r < 2 ^ 10 → ∃ t k, entryOK w A φ G r t k = true := by
  intro r hr
  rw [show (2 : Nat) ^ 10 = 1024 by rfl] at hr
  by_cases c0 : r < 128; · exact halvesOK_spec _ _ _ h0 r (by omega) (by omega)
  by_cases c1 : r < 256; · exact halvesOK_spec _ _ _ h1 r (by omega) (by omega)
  by_cases c2 : r < 384; · exact halvesOK_spec _ _ _ h2 r (by omega) (by omega)
  by_cases c3 : r < 512; · exact halvesOK_spec _ _ _ h3 r (by omega) (by omega)
  by_cases c4 : r < 640; · exact halvesOK_spec _ _ _ h4 r (by omega) (by omega)
  by_cases c5 : r < 768; · exact halvesOK_spec _ _ _ h5 r (by omega) (by omega)
  by_cases c6 : r < 896; · exact halvesOK_spec _ _ _ h6 r (by omega) (by omega)
  exact halvesOK_spec _ _ _ h7 r (by omega) (by omega)


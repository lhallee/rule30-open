/-! ### The three words of period four -/

/-- **Every right half white on cells 11 to 562 enters the family under `0001`**, in every phase, whatever its
first ten cells and its cells beyond 562. -/
theorem ten_0001 (φ : Nat) (x : Nat → Bool) (hx : ∀ p, 10 < p → p ≤ 562 → x p = false) :
    ∃ a ∈ A0001, ∃ t1, InFamily (drv (fun t => wordAt w0001 (t + φ)) x) a.1 (a.2 + φ) t1 := by
  refine gap_phase ?_
  rcases (show φ % 4 = 0 ∨ φ % 4 = 1 ∨ φ % 4 = 2 ∨ φ % 4 = 3 by omega) with h | h | h | h <;> rw [h]
  · exact ten_absorption (chunks8 halves0001_0_0 halves0001_0_1 halves0001_0_2 halves0001_0_3 halves0001_0_4 halves0001_0_5 halves0001_0_6 halves0001_0_7) x hx
  · exact ten_absorption (chunks8 halves0001_1_0 halves0001_1_1 halves0001_1_2 halves0001_1_3 halves0001_1_4 halves0001_1_5 halves0001_1_6 halves0001_1_7) x hx
  · exact ten_absorption (chunks8 halves0001_2_0 halves0001_2_1 halves0001_2_2 halves0001_2_3 halves0001_2_4 halves0001_2_5 halves0001_2_6 halves0001_2_7) x hx
  · exact ten_absorption (chunks8 halves0001_3_0 halves0001_3_1 halves0001_3_2 halves0001_3_3 halves0001_3_4 halves0001_3_5 halves0001_3_6 halves0001_3_7) x hx

/-- **Every right half white on cells 11 to 654 enters the family under `0011`**, in every phase, whatever its
first ten cells and its cells beyond 654. -/
theorem ten_0011 (φ : Nat) (x : Nat → Bool) (hx : ∀ p, 10 < p → p ≤ 654 → x p = false) :
    ∃ a ∈ A0011, ∃ t1, InFamily (drv (fun t => wordAt w0011 (t + φ)) x) a.1 (a.2 + φ) t1 := by
  refine gap_phase ?_
  rcases (show φ % 4 = 0 ∨ φ % 4 = 1 ∨ φ % 4 = 2 ∨ φ % 4 = 3 by omega) with h | h | h | h <;> rw [h]
  · exact ten_absorption (chunks8 halves0011_0_0 halves0011_0_1 halves0011_0_2 halves0011_0_3 halves0011_0_4 halves0011_0_5 halves0011_0_6 halves0011_0_7) x hx
  · exact ten_absorption (chunks8 halves0011_1_0 halves0011_1_1 halves0011_1_2 halves0011_1_3 halves0011_1_4 halves0011_1_5 halves0011_1_6 halves0011_1_7) x hx
  · exact ten_absorption (chunks8 halves0011_2_0 halves0011_2_1 halves0011_2_2 halves0011_2_3 halves0011_2_4 halves0011_2_5 halves0011_2_6 halves0011_2_7) x hx
  · exact ten_absorption (chunks8 halves0011_3_0 halves0011_3_1 halves0011_3_2 halves0011_3_3 halves0011_3_4 halves0011_3_5 halves0011_3_6 halves0011_3_7) x hx


module

public import Rule30Open.Columns.FiniteGame
public import Ruliology.CellularAutomata.Rule30StripCertificateTable

/-!
# The finite game in bit masks: 32 more blocks

`FiniteGame` checks a certificate node by node on lists of cells, with ranks in 8 bits. Here a node's cells are one
number, cell `k + 1 + i` at bit `i`, and a move is the kit's bit-mask step `Rule30StripCertificates.stripStep`
(`codeFrom_succ`); ranks take as many bits as they need, in one number for each phase. `GameMask.check` then runs in
the kernel at about a tenth of a millisecond a node, and `mask_column` is `game_column` for these certificates.

`gameMasks` holds certificates for 32 of the 34 primitive blocks of period at most 14 that the game excludes and the
kit does not, each at the least width that works. `center_not_gameBlocks` excludes each of them as the eventual
period of the center column, and `not_eventually_gameBlocks` states the same in the kit's form
`Rule30StripCertificates.EventuallyWord`. The other two blocks, 00000001001111 and 00000000010001, need games of
114,688 and 229,376 nodes and are left out of the build.

The natural-language argument is `GameBlocks.md`, beside this file.
-/

@[expose] public section

namespace Rule30Open

open Ruliology.CellularAutomata
open Rule30StripCertificateTable (wordOf)

/-- Cells `x .. x + n - 1` of the row at time `t` as a number, cell `x + i` at bit `i`. -/
def codeFrom (init : Int → Bool) (t : Nat) (x : Int) : Nat → Nat
  | 0 => 0
  | n + 1 => (evolve init t x).toNat + 2 * codeFrom init t (x + 1) n

theorem codeFrom_lt (init : Int → Bool) (t : Nat) : ∀ (n : Nat) (x : Int), codeFrom init t x n < 2 ^ n
  | 0, _ => Nat.one_pos
  | n + 1, x => by
    have h := codeFrom_lt init t n (x + 1)
    have hb := Bool.toNat_le (evolve init t x)
    show (evolve init t x).toNat + 2 * codeFrom init t (x + 1) n < 2 ^ (n + 1)
    rw [Nat.pow_succ]
    omega

theorem testBit_codeFrom (init : Int → Bool) (t : Nat) : ∀ (n : Nat) (x : Int) (i : Nat),
    (codeFrom init t x n).testBit i = (decide (i < n) && evolve init t (x + i))
  | 0, _, i => by simp [codeFrom]
  | n + 1, x, 0 => by
    show ((evolve init t x).toNat + 2 * codeFrom init t (x + 1) n).testBit 0 = _
    rw [Nat.testBit_zero, show x + ((0 : Nat) : Int) = x by omega]
    cases evolve init t x <;> simp <;> omega
  | n + 1, x, i + 1 => by
    show ((evolve init t x).toNat + 2 * codeFrom init t (x + 1) n).testBit (i + 1) = _
    have hb := Bool.toNat_le (evolve init t x)
    rw [Nat.testBit_succ, show ((evolve init t x).toNat + 2 * codeFrom init t (x + 1) n) / 2 =
      codeFrom init t (x + 1) n by omega, testBit_codeFrom init t n (x + 1) i,
      show x + 1 + (i : Int) = x + ((i + 1 : Nat) : Int) by omega]
    congr 1

/-- One step of the cells, as numbers, is the kit's bit-mask step with the cell left of them and the cell right of
them now. -/
theorem codeFrom_succ (init : Int → Bool) (t n : Nat) (x : Int) :
    codeFrom init (t + 1) x n =
      Rule30StripCertificates.stripStep n (evolve init t (x - 1)) (evolve init t (x + n)) (codeFrom init t x n) := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [testBit_codeFrom]
  by_cases hi : i < n
  · rw [Rule30StripCertificates.testBit_stripStep n _ _ _ (codeFrom_lt init t n x) i hi, decide_eq_true hi,
      Bool.true_and]
    have e1 : (if i = 0 then evolve init t (x - 1) else (codeFrom init t x n).testBit (i - 1)) =
        evolve init t (x + i - 1) := by
      by_cases h0 : i = 0
      · rw [ite_eq_left h0, h0]
        congr 1
        omega
      · rw [ite_eq_right h0, testBit_codeFrom, decide_eq_true (by omega), Bool.true_and]
        congr 1
        omega
    have e2 : (codeFrom init t x n).testBit i = evolve init t (x + i) := by
      rw [testBit_codeFrom, decide_eq_true hi, Bool.true_and]
    have e3 : (if i + 1 = n then evolve init t (x + n) else (codeFrom init t x n).testBit (i + 1)) =
        evolve init t (x + i + 1) := by
      by_cases h1 : i + 1 = n
      · rw [ite_eq_left h1]
        congr 1
        omega
      · rw [ite_eq_right h1, testBit_codeFrom, decide_eq_true (by omega), Bool.true_and]
        congr 1
        omega
    rw [e1, e2, e3]
    rfl
  · rw [decide_eq_false hi, Bool.false_and]
    exact (Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le (Rule30StripCertificates.stripStep_lt _ _ _ _)
      (Nat.pow_le_pow_right (by decide) (by omega)))).symm

/-- A certificate for the game on `width` cells, in bit masks. A node is a phase and its cells as a number `r`; its
rank is the `bits` bits from bit `bits * r` of the phase's entry of `ranks`. Rank `ρ` is transient when bit `ρ` of
`transient` is set, and column `k - 1` at a rank `ρ` that is not and at phase `φ` is bit `ρ * period + φ` of
`values`, as in `GameCert`. -/
structure GameMask where
  block : List Bool
  width : Nat
  bits : Nat
  ranks : List Nat
  transient : Nat
  values : Nat

namespace GameMask

def center (g : GameMask) (phase : Nat) : Bool := bit g.block (phase % g.block.length)

/-- The kit's `stripStep`, written with the `Nat` functions themselves, which the kernel reaches in fewer steps. -/
def move (K : Nat) (c u : Bool) (r : Nat) : Nat :=
  Nat.mod (Nat.xor (Nat.lor (Nat.shiftLeft r 1) (cond c 1 0))
    (Nat.lor (Nat.lor r (Nat.shiftRight r 1)) (Nat.shiftLeft (cond u 1 0) (Nat.sub K 1)))) (Nat.pow 2 K)

theorem move_eq (K : Nat) (c u : Bool) (r : Nat) : move K c u r = Rule30StripCertificates.stripStep K c u r := rfl

/-- The `bits` bits of `ranks` from bit `bits * r`. -/
def entry (bits ranks r : Nat) : Nat := Nat.mod (Nat.shiftRight ranks (Nat.mul bits r)) (Nat.pow 2 bits)

/-- Bit `i` of `n`. -/
def bitOf (n i : Nat) : Bool := Nat.beq (Nat.mod (Nat.shiftRight n i) 2) 1

theorem bitOf_zero (n : Nat) : bitOf n 0 = n.testBit 0 := by
  rw [Nat.testBit_zero]
  show Nat.beq (n % 2) 1 = decide (n % 2 = 1)
  cases h : Nat.beq (n % 2) 1
  · exact (decide_eq_false (Nat.ne_of_beq_eq_false h)).symm
  · exact (decide_eq_true (Nat.eq_of_beq_eq_true h)).symm

/-- The node with cells `r` at a phase where the block reads `c` now and `c'` next, with this phase's ranks `here`
and the next phase's `there`: no move lowers the rank, a move from a transient rank raises it, and at a rank that is
not transient column `k - 1`, `c' xor (c || cell k + 1)`, is the certificate's value. -/
def nodeOk (K bits transient values P phase : Nat) (c c' : Bool) (here there r : Nat) : Bool :=
  let a := entry bits here r
  let b0 := entry bits there (move K c false r)
  let b1 := entry bits there (move K c true r)
  cond (bitOf transient a) (Nat.blt a b0 && Nat.blt a b1)
    (Nat.ble a b0 && Nat.ble a b1 && bitOf values (a * P + phase) == xor c' (c || bitOf r 0))

/-- Every node of the phase whose cells are below `n` passes. -/
def phaseOk (K bits transient values P phase : Nat) (c c' : Bool) (here there : Nat) : Nat → Bool
  | 0 => true
  | n + 1 => nodeOk K bits transient values P phase c c' here there n &&
      phaseOk K bits transient values P phase c c' here there n

/-- The block and the width are not empty, and every node of the game passes. -/
def check (g : GameMask) : Bool :=
  decide (0 < g.block.length) && decide (0 < g.width) && (List.range g.block.length).all fun phase =>
    phaseOk g.width g.bits g.transient g.values g.block.length phase (g.center phase) (g.center (phase + 1))
      (g.ranks.getD phase 0) (g.ranks.getD ((phase + 1) % g.block.length) 0) (2 ^ g.width)

theorem phaseOk_spec {K bits transient values P phase : Nat} {c c' : Bool} {here there : Nat} :
    ∀ {n : Nat}, phaseOk K bits transient values P phase c c' here there n = true →
      ∀ r, r < n → nodeOk K bits transient values P phase c c' here there r = true
  | 0, _, r, hr => absurd hr (Nat.not_lt_zero r)
  | n + 1, h, r, hr => by
    simp only [phaseOk, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.mp hr with hlt | heq
    · exact phaseOk_spec h.2 r hlt
    · exact heq ▸ h.1

/-- A passing node's moves, for either free cell. -/
theorem nodeOk_move {K bits transient values P phase : Nat} {c c' : Bool} {here there r : Nat}
    (h : nodeOk K bits transient values P phase c c' here there r = true) (u : Bool) :
    (bitOf transient (entry bits here r) = true → entry bits here r < entry bits there (move K c u r)) ∧
      entry bits here r ≤ entry bits there (move K c u r) := by
  unfold nodeOk at h
  cases ht : bitOf transient (entry bits here r) with
  | true =>
    simp only [ht, Bool.cond_true, Bool.and_eq_true, Nat.blt_eq] at h
    cases u
    · exact ⟨fun _ => h.1, Nat.le_of_lt h.1⟩
    · exact ⟨fun _ => h.2, Nat.le_of_lt h.2⟩
  | false =>
    simp only [ht, Bool.cond_false, Bool.and_eq_true, Nat.ble_eq] at h
    cases u
    · exact ⟨fun hf => Bool.noConfusion hf, h.1.1⟩
    · exact ⟨fun hf => Bool.noConfusion hf, h.1.2⟩

/-- A passing node at a rank that is not transient shows the certificate's value. -/
theorem nodeOk_value {K bits transient values P phase : Nat} {c c' : Bool} {here there r : Nat}
    (h : nodeOk K bits transient values P phase c c' here there r = true)
    (ht : bitOf transient (entry bits here r) = false) :
    bitOf values (entry bits here r * P + phase) = xor c' (c || bitOf r 0) := by
  unfold nodeOk at h
  simp only [ht, Bool.cond_false, Bool.and_eq_true, beq_iff_eq] at h
  exact h.2

end GameMask

/-- `game_column` for bit-mask certificates: no column of the orbit of a row with a leftmost 1 repeats, from some
time on, a block whose mask passes `GameMask.check`. -/
theorem mask_column (init : Int → Bool) (m : Int) (hm : init m = true) (hz : ∀ x : Int, x < m → init x = false)
    (g : GameMask) (hg : g.check = true) (k : Int) (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → evolve init t k = g.center (t + shift)) : False := by
  simp only [GameMask.check, Bool.and_eq_true, decide_eq_true_eq] at hg
  obtain ⟨⟨hP, hw⟩, hg⟩ := hg
  let phase : Nat → Nat := fun t => (t + shift) % g.block.length
  let code : Nat → Nat := fun t => codeFrom init t (k + 1) g.width
  let ranksAt : Nat → Nat := fun p => g.ranks.getD p 0
  have hcenter : ∀ t, T ≤ t → evolve init t k = g.center (phase t) := fun t ht => by
    rw [h t ht]
    show bit g.block ((t + shift) % g.block.length) = bit g.block ((t + shift) % g.block.length % g.block.length)
    rw [Nat.mod_mod]
  have hnext : ∀ t, g.center (phase t + 1) = g.center (phase (t + 1)) := fun t => by
    show bit g.block (((t + shift) % g.block.length + 1) % g.block.length) =
      bit g.block ((t + 1 + shift) % g.block.length % g.block.length)
    rw [Nat.mod_mod, mod_succ_mod, show t + 1 + shift = t + shift + 1 by omega]
  have hphase : ∀ t, phase (t + 1) = (phase t + 1) % g.block.length := fun t => by
    show (t + 1 + shift) % g.block.length = ((t + shift) % g.block.length + 1) % g.block.length
    rw [mod_succ_mod, show t + 1 + shift = t + shift + 1 by omega]
  have hperiod : ∀ t, phase (t + g.block.length) = phase t := fun t => by
    show (t + g.block.length + shift) % g.block.length = (t + shift) % g.block.length
    rw [show t + g.block.length + shift = t + shift + g.block.length by omega, Nat.add_mod_right]
  have node : ∀ t, GameMask.nodeOk g.width g.bits g.transient g.values g.block.length (phase t)
      (g.center (phase t)) (g.center (phase t + 1)) (ranksAt (phase t))
      (ranksAt ((phase t + 1) % g.block.length)) (code t) = true := fun t =>
    GameMask.phaseOk_spec (List.all_eq_true.mp hg (phase t) (List.mem_range.mpr (Nat.mod_lt _ hP))) (code t)
      (codeFrom_lt init t g.width (k + 1))
  have step : ∀ t, T ≤ t → code (t + 1) =
      GameMask.move g.width (g.center (phase t)) (evolve init t (k + 1 + g.width)) (code t) := fun t ht => by
    show codeFrom init (t + 1) (k + 1) g.width = _
    rw [codeFrom_succ, GameMask.move_eq, show k + 1 - 1 = k by omega, hcenter t ht]
  let R : Nat → Nat := fun t => GameMask.entry g.bits (ranksAt (phase t)) (code t)
  have hR : ∀ t, T ≤ t → R (t + 1) = GameMask.entry g.bits (ranksAt ((phase t + 1) % g.block.length))
      (GameMask.move g.width (g.center (phase t)) (evolve init t (k + 1 + g.width)) (code t)) := fun t ht => by
    show GameMask.entry g.bits (ranksAt (phase (t + 1))) (code (t + 1)) = _
    rw [hphase t, step t ht]
  have rise : ∀ t, T ≤ t → (GameMask.bitOf g.transient (R t) = true → R t < R (t + 1)) ∧ R t ≤ R (t + 1) :=
    fun t ht => by
      rw [hR t ht]
      exact GameMask.nodeOk_move (node t) _
  have bound : ∀ t, R t ≤ 2 ^ g.bits := fun t => Nat.le_of_lt (Nat.mod_lt _ (Nat.two_pow_pos _))
  obtain ⟨t1, ht1, hconst⟩ := settles R _ bound _ T (Nat.le_refl _) fun t ht => (rise t ht).2
  have stable : GameMask.bitOf g.transient (R t1) = false := by
    cases htr : GameMask.bitOf g.transient (R t1) with
    | false => rfl
    | true =>
      have hlt := (rise t1 ht1).1 htr
      rw [hconst (t1 + 1) (by omega)] at hlt
      exact absurd hlt (Nat.lt_irrefl _)
  have left : ∀ t, t1 ≤ t →
      evolve init t (k - 1) = GameMask.bitOf g.values (R t1 * g.block.length + phase t) := fun t ht => by
    have hRt : R t = R t1 := hconst t ht
    have hv := GameMask.nodeOk_value (node t) (by show GameMask.bitOf g.transient (R t) = false; rw [hRt, stable])
    have hv' : GameMask.bitOf g.values (R t1 * g.block.length + phase t) =
        xor (g.center (phase t + 1)) (g.center (phase t) || GameMask.bitOf (code t) 0) := by
      rw [← hRt]
      exact hv
    rw [hv', left_cell init t k, hcenter (t + 1) (by omega), hcenter t (by omega), hnext t]
    show xor (g.center (phase (t + 1))) (g.center (phase t) || evolve init t (k + 1)) =
      xor (g.center (phase (t + 1))) (g.center (phase t) || GameMask.bitOf (codeFrom init t (k + 1) g.width) 0)
    rw [GameMask.bitOf_zero, testBit_codeFrom, decide_eq_true hw, Bool.true_and,
      show k + 1 + ((0 : Nat) : Int) = k + 1 by omega]
  exact adjacent_columns init m hm hz (k - 1) t1 g.block.length hP
    (fun t ht => by rw [left (t + g.block.length) (by omega), left t ht, hperiod t])
    (fun t ht => by
      rw [show k - 1 + 1 = k by omega, hcenter (t + g.block.length) (by omega), hcenter t (by omega), hperiod t])

theorem bit_eq_getD : ∀ (l : List Bool) (i : Nat), bit l i = l.getD i false
  | [], _ => rfl
  | _ :: _, 0 => rfl
  | _ :: rest, i + 1 => by
    rw [List.getD_cons_succ]
    exact bit_eq_getD rest i

/-- The center column does not eventually repeat a block whose mask passes, in the kit's form. -/
theorem mask_not_eventuallyWord (g : GameMask) (hg : g.check = true) :
    ¬ Rule30StripCertificates.EventuallyWord g.block := by
  have hP : 0 < g.block.length := by
    simp only [GameMask.check, Bool.and_eq_true, decide_eq_true_eq] at hg
    exact hg.1.1
  rintro ⟨T, hT⟩
  refine mask_column single 0 rfl (fun x hx => decide_eq_false (by omega)) g hg 0 T
    (g.block.length * T - T) fun t ht => ?_
  rw [evolve_single_eq_cell]
  show Rule30Jen.cell t 0 = bit g.block ((t + (g.block.length * T - T)) % g.block.length)
  have hLT : T ≤ g.block.length * T := Nat.le_mul_of_pos_left T hP
  rw [hT t ht, bit_eq_getD, show t + (g.block.length * T - T) = t - T + g.block.length * T by omega,
    Nat.add_mul_mod_self_left]


/-- The 32 certificates. -/
def gameMasks : List GameMask := [mask00000001, mask00000001011, mask00000001111, mask000000001111, mask000000010111,
    mask0000000001101, mask0000000001111, mask0000000011101, mask0000000011111, mask0000000101011, mask0000101111111,
    mask00000000000101, mask00000000001011, mask00000000001101, mask00000000001111, mask00000000010011,
    mask00000000011011, mask00000000011101, mask00000000011111, mask00000000101011, mask00000000110011,
    mask00000001011011, mask00000001011111, mask00001011111111, mask00010111111111, mask00101011111111,
    mask00101111111111, mask00111111111011, mask00111111111101, mask01011111111111, mask01101111111111,
    mask01110111111111]

/-- The 32 blocks, each as its least rotation: `(n, bits)` is `wordOf n bits`, the `n` binary digits of `bits`. -/
def gameBlocks : List (Nat × Nat) := [(8, 0b00000001), (11, 0b00000001011), (11, 0b00000001111), (12, 0b000000001111),
    (12, 0b000000010111), (13, 0b0000000001101), (13, 0b0000000001111), (13, 0b0000000011101), (13, 0b0000000011111),
    (13, 0b0000000101011), (13, 0b0000101111111), (14, 0b00000000000101), (14, 0b00000000001011),
    (14, 0b00000000001101), (14, 0b00000000001111), (14, 0b00000000010011), (14, 0b00000000011011),
    (14, 0b00000000011101), (14, 0b00000000011111), (14, 0b00000000101011), (14, 0b00000000110011),
    (14, 0b00000001011011), (14, 0b00000001011111), (14, 0b00001011111111), (14, 0b00010111111111),
    (14, 0b00101011111111), (14, 0b00101111111111), (14, 0b00111111111011), (14, 0b00111111111101),
    (14, 0b01011111111111), (14, 0b01101111111111), (14, 0b01110111111111)]

theorem gameMasks_blocks : gameMasks.map GameMask.block = gameBlocks.map fun e => wordOf e.1 e.2 := rfl

theorem gameMasks_check : gameMasks.all GameMask.check = true := by
  simp only [gameMasks, List.all_cons, List.all_nil, Bool.and_true, mask00000001_check, mask00000001011_check,
    mask00000001111_check, mask000000001111_check, mask000000010111_check, mask0000000001101_check,
    mask0000000001111_check, mask0000000011101_check, mask0000000011111_check, mask0000000101011_check,
    mask0000101111111_check, mask00000000000101_check, mask00000000001011_check, mask00000000001101_check,
    mask00000000001111_check, mask00000000010011_check, mask00000000011011_check, mask00000000011101_check,
    mask00000000011111_check, mask00000000101011_check, mask00000000110011_check, mask00000001011011_check,
    mask00000001011111_check, mask00001011111111_check, mask00010111111111_check, mask00101011111111_check,
    mask00101111111111_check, mask00111111111011_check, mask00111111111101_check, mask01011111111111_check,
    mask01101111111111_check, mask01110111111111_check]

theorem mem_gameMasks {e : Nat × Nat} (he : e ∈ gameBlocks) : ∃ g ∈ gameMasks, g.block = wordOf e.1 e.2 := by
  have hm : wordOf e.1 e.2 ∈ gameMasks.map GameMask.block := by
    rw [gameMasks_blocks]
    exact List.mem_map_of_mem (f := fun e : Nat × Nat => wordOf e.1 e.2) he
  exact List.mem_map.mp hm

/-- Official form: **the center column does not repeat any of the 32 blocks from some time on**, in any
rotation. -/
theorem center_not_gameBlocks (e : Nat × Nat) (he : e ∈ gameBlocks) (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → Rule30Prize.center t = (wordOf e.1 e.2).getD ((t + shift) % e.1) false) : False := by
  obtain ⟨g, hg, hb⟩ := mem_gameMasks he
  refine mask_column single 0 rfl (fun x hx => decide_eq_false (by omega)) g
    (List.all_eq_true.mp gameMasks_check g hg) 0 T shift fun t ht => ?_
  rw [evolve_single_center, h t ht]
  show _ = bit g.block ((t + shift) % g.block.length)
  rw [bit_eq_getD, hb, Rule30StripCertificateTable.wordOf_length]

/-- The same in the kit's form: none of the 32 blocks is an `EventuallyWord` of the center column. -/
theorem not_eventually_gameBlocks (e : Nat × Nat) (he : e ∈ gameBlocks) :
    ¬ Rule30StripCertificates.EventuallyWord (wordOf e.1 e.2) := by
  obtain ⟨g, hg, hb⟩ := mem_gameMasks he
  rw [← hb]
  exact mask_not_eventuallyWord g (List.all_eq_true.mp gameMasks_check g hg)


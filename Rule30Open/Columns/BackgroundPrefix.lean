/-- **The background of period 10 in the 25 traps of `TenTraps`.** For each trap, each aligned column of `tenRing`
and each label, no finite configuration whose cells `1 .. K` are the background right of that column has a center
column that repeats the trap's block from the phase the column reads. -/
theorem ten_background_prefix : ∀ x ∈ tenBackground, ∀ p ∈ x.2.1, ∀ l < tenRing.length,
    ∃ φ, readsAt x.1.b tenRing p l φ = true ∧ PrefixRightW x.1.b (bgWin 155 tenRing p l x.1.K) x.1.K φ :=
  background_prefix_of tenBackground
    (fun x hx => List.all_eq_true.1 tenTraps_check x.1 (by rw [← tenBackground_traps]; exact List.mem_map_of_mem hx))
    (by decide +kernel) tenBackground_ok

/-- **The background of period 12 on 138 cells in 36 traps of `TwelveTraps`**, those carried from `000110110011`. -/
theorem twelve_background_prefix : ∀ x ∈ twelveBackground, ∀ p ∈ x.2.1, ∀ l < twelveRing.length,
    ∃ φ, readsAt x.1.b twelveRing p l φ = true ∧ PrefixRightW x.1.b (bgWin 138 twelveRing p l x.1.K) x.1.K φ :=
  background_prefix_of twelveBackground
    (fun x hx => List.all_eq_true.1 twelveTraps_check x.1 (by
      have h := List.mem_map_of_mem (f := Prod.fst) hx
      rw [twelveBackground_traps] at h
      exact List.mem_of_mem_drop (List.mem_of_mem_take h)))
    (by decide +kernel) twelveBackground_ok

/-- **The background of period 14 on 728 cells in the 101 traps of `FourteenTraps`.** -/

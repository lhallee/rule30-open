module

public import Rule30Open.Columns.TenGap
public import Rule30Open.Columns.TwelveTraps
public import Rule30Open.Columns.FourteenTraps

/-!
# Every right half that begins with the background beside its column is in the carried trap from step 0

The walls of periods 10, 12 and 14 that `TenTraps`, `TwelveTraps` and `FourteenTraps` carry lie on chains periodic from
the wall's own column: the columns from it leftward are a background periodic in time and space, on a ring of 155, 138
and 728 cells. The background's window beside the wall's column is a state of the wall, so beside every column of the
background that repeats a block and is aligned with the block's distance along the chain, the background's window is a
state of the block's carried trap. A right half driven by the block whose first cells are that window is in the trap
from step 0, whatever its other cells: every truncation of the background, long enough, followed by any word.

* `ringStep`, `ringOK`: one step of Rule 30 on a ring, and the check that a list of rows is a background of Rule 30,
  each row stepping to the next. `tenRing_ok`, `twelveRing_ok`, `fourteenRing_ok`: the three rings.
* `bgWin`, `readsAt`, `bgOK`: the background's window beside a column, the block a column reads, and the check that the
  window is a state of a trap at the phase the column reads.
* `prefixRightW_of_bg`: no finite configuration whose cells `1 .. K` are such a window has a center column that repeats
  the block from that phase (`PrefixRightW` of [TenGap](TenGap.md)).
* `ten_background_prefix`, `twelve_background_prefix`, `fourteen_background_prefix`: this for the 25 traps of
  `TenTraps`, the 36 of `TwelveTraps` carried from the wall `000110110011`, and the 101 of `FourteenTraps`, beside every
  aligned column of their rings and from every label.

The data come from `python -m computations.background_prefix --lean-prefix`. The natural-language argument is
`BackgroundPrefix.md`, beside this file.
-/

@[expose] public section

-- Sequential elaboration: the kernel checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Rule30Open

open Ruliology.CellularAutomata BitGame
open Rule30Ether Rule30EtherThree Rule30Realization Rule30PeriodTwoSideways

/-- One step of Rule 30 on a ring of `q` cells, bit `p` the cell at position `p` from the left: each cell becomes its
left neighbor xor (itself or its right neighbor), cyclically. -/
def ringStep (q r : Nat) : Nat :=
  (((r <<< 1) ||| (r >>> (q - 1))) % 2 ^ q) ^^^ (r ||| ((r >>> 1) ||| ((r % 2) <<< (q - 1))))

/-- Row `l` of a list of rows, the index taken modulo its length. -/
def rowAt (rs : List Nat) (l : Nat) : Nat := rs.getD (l % rs.length) 0

/-- The rows `rs` of a ring of `q` cells are a background of Rule 30, periodic in time with period their number: each
row has `q` cells and steps to the next, the last to the first. -/
def ringOK (q : Nat) (rs : List Nat) : Bool :=
  Nat.blt 0 rs.length && Nat.blt 1 q && (List.range rs.length).all fun l =>
    Nat.blt (rowAt rs l) (2 ^ q) && Nat.beq (ringStep q (rowAt rs l)) (rowAt rs (l + 1))

/-- The background right of the cell at position `p` at label `l`, cells `1 .. k`: bit `j` is the cell at position
`p + 1 + j`, cyclically (`k` at most twice the ring). -/
def bgWin (q : Nat) (rs : List Nat) (p l k : Nat) : Nat :=
  ((rowAt rs l ||| (rowAt rs l <<< q) ||| (rowAt rs l <<< (2 * q))) >>> (p + 1)) % 2 ^ k

/-- The cell at position `p` reads the block `b` at phase `φ` from label `l` on, for the `m` labels of the rows. -/
def readsAt (b : List Bool) (rs : List Nat) (p l φ : Nat) : Bool :=
  (List.range rs.length).all fun k => Nat.testBit (rowAt rs (l + k)) p == b.getD ((φ + k) % b.length) false

/-- Entry `(j, l)` of a packed code: 16 bits, the phase in the low 4 and a state's index above them. -/
def bgEntry (m code j l : Nat) : Nat := (code >>> (16 * (j * m + l))) % 2 ^ 16

/-- For each position `p` of the list (the `j`-th) and each label `l`, entry `(j, l)` of the code gives a phase `φ` and
a state `i`: the column at position `p` reads the trap's block at phase `φ` from label `l`, and the background right of
it at label `l` is state `i`, whose label reads that phase. -/
def bgOK (q : Nat) (rs : List Nat) (C : WTrap) (ps : List Nat) (code : Nat) : Bool :=
  Nat.ble C.K (2 * q) && (List.range ps.length).all fun j => (List.range rs.length).all fun l =>
    Nat.blt (bgEntry rs.length code j l / 16) C.n &&
      readsAt C.b rs (ps.getD j 0) l (bgEntry rs.length code j l % 16) &&
      Nat.beq (bgEntry rs.length code j l % 16 % C.b.length) (C.lab (bgEntry rs.length code j l / 16) % C.b.length) &&
      Nat.beq (bgWin q rs (ps.getD j 0) l C.K) (C.st (bgEntry rs.length code j l / 16))

/-- A block with a black letter is black at some step from every phase. -/
theorem phased_black {b : List Bool} {j : Nat} (hj : j < b.length) (hb : b.getD j false = true) (φ : Nat) :
    ∃ t, phased b φ t = true := by
  have hl : 0 < b.length := by omega
  refine ⟨j + b.length - φ % b.length, ?_⟩
  unfold phased
  have h1 := Nat.mod_lt φ hl
  have h2 := Nat.mod_add_div φ b.length
  have key : j + b.length - φ % b.length + φ = j + b.length * (φ / b.length + 1) := by
    rw [Nat.mul_add, Nat.mul_one]
    generalize φ % b.length = a at h1 h2 ⊢
    generalize b.length * (φ / b.length) = k at h2 ⊢
    omega
  rw [key, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hj]
  exact hb

/-- **A right half that begins with the background is in the trap from step 0.** For each position `p` of the list
and each label `l`, the column there reads the block at some phase `φ`, and no finite configuration whose cells
`1 .. K` are the background right of it at label `l` has a center column that repeats the block from phase `φ`. -/
theorem prefixRightW_of_bg {q : Nat} {rs : List Nat} (C : WTrap) (hC : C.check = true) {ps : List Nat} {code : Nat}
    (hok : bgOK q rs C ps code = true) (hw : ∀ φ, ∃ t, phased C.b φ t = true) {p : Nat} (hp : p ∈ ps) {l : Nat}
    (hl : l < rs.length) : ∃ φ, readsAt C.b rs p l φ = true ∧ PrefixRightW C.b (bgWin q rs p l C.K) C.K φ := by
  obtain ⟨j, hj, rfl⟩ := List.getElem_of_mem hp
  unfold bgOK at hok
  rw [Bool.and_eq_true] at hok
  have h := List.all_eq_true.1 (List.all_eq_true.1 hok.2 j (List.mem_range.2 hj)) l (List.mem_range.2 hl)
  simp only [Bool.and_eq_true, Nat.blt_eq, Nat.beq_eq] at h
  obtain ⟨⟨⟨hi, hread⟩, hph⟩, hwin⟩ := h
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj, Option.getD_some] at hread hwin
  refine ⟨_, hread, ?_⟩
  have hrun : rowN (phased C.b (bgEntry rs.length code j l % 16)) (bgWin q rs ps[j] l C.K) 0 % 2 ^ C.K =
      C.st (bgEntry rs.length code j l / 16) := by
    show bgWin q rs ps[j] l C.K % 2 ^ C.K = _
    rw [hwin]
    unfold WTrap.st
    exact Nat.mod_mod _ _
  have := prefixRightW_of_entry C hC (T := 0) hi (by rw [Nat.zero_add]; exact hph) (hw _) hrun
  rwa [Nat.zero_add] at this

/-- A list of traps with their positions and codes: each trap is checked, its block ends with a black letter, and
each passes `bgOK`. Then `prefixRightW_of_bg` holds for each. -/
theorem background_prefix_of {q : Nat} {rs : List Nat} (L : List (WTrap × List Nat × Nat))
    (hc : ∀ x ∈ L, x.1.check = true)
    (hb : L.all (fun x => Nat.blt 0 x.1.b.length && x.1.b.getD (x.1.b.length - 1) false) = true)
    (hok : L.all (fun x => bgOK q rs x.1 x.2.1 x.2.2) = true) :
    ∀ x ∈ L, ∀ p ∈ x.2.1, ∀ l < rs.length,
      ∃ φ, readsAt x.1.b rs p l φ = true ∧ PrefixRightW x.1.b (bgWin q rs p l x.1.K) x.1.K φ := by
  intro x hx p hp l hl
  have hbx := List.all_eq_true.1 hb x hx
  simp only [Bool.and_eq_true, Nat.blt_eq] at hbx
  exact prefixRightW_of_bg x.1 (hc x hx) (List.all_eq_true.1 hok x hx)
    (phased_black (j := x.1.b.length - 1) (by omega) hbx.2) hp hl


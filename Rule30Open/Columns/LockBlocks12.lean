/-- The 23 blocks of period 12 that neither the game at width 14 nor the kit excludes and whose game at width 13 has
locked windows that every window can be steered into, as entries `Steered`. -/
def steered12 : List Steered := [
    steer_000000001011, steer_000000010001, steer_000000011101, steer_000000110011, steer_000001001101,
    steer_000001101011, steer_000010010001, steer_000010101001, steer_000011011011, steer_000011111111,
    steer_000100111101, steer_000101011111, steer_000101101011, steer_000111001101, steer_001001101111,
    steer_001011011111, steer_001011111011, steer_001100111111, steer_001110111101, steer_001111111101,
    steer_010101010111, steer_010111111011, steer_011101111111]

/-- Every check passes. -/
theorem steered12_check : ∀ e ∈ steered12, e.check = true := by
  intro e he
  simp only [steered12, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with
    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl
  · exact steer_000000001011_check
  · exact steer_000000010001_check
  · exact steer_000000011101_check
  · exact steer_000000110011_check
  · exact steer_000001001101_check
  · exact steer_000001101011_check
  · exact steer_000010010001_check
  · exact steer_000010101001_check
  · exact steer_000011011011_check
  · exact steer_000011111111_check
  · exact steer_000100111101_check
  · exact steer_000101011111_check
  · exact steer_000101101011_check
  · exact steer_000111001101_check
  · exact steer_001001101111_check
  · exact steer_001011011111_check
  · exact steer_001011111011_check
  · exact steer_001100111111_check
  · exact steer_001110111101_check
  · exact steer_001111111101_check
  · exact steer_010101010111_check
  · exact steer_010111111011_check
  · exact steer_011101111111_check
/-- **The 23 blocks**: once the center column repeats the block of an entry of `steered12` from time `T`, read
from phase `shift`, column 14 does not read the entry's sequence from any time `t₀ ≥ T`. -/
theorem center_lock_steered12 (e : Steered) (he : e ∈ steered12) (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → Rule30Prize.center t =
      (Rule30StripCertificateTable.wordOf e.period e.bits).getD ((t + shift) % e.period) false) (t0 : Nat)
    (ht0 : T ≤ t0) : ∃ i, i < e.len ∧ Rule30Jen.cell (t0 + i) 14 ≠ e.seq.testBit i :=
  center_lock_steered e (steered12_check e he) T shift h t0 ht0

/-- **The sufficient condition**: if column 14 reads the sequence of an entry of `steered12` at arbitrarily late
times, the center column does not eventually repeat the entry's block. -/
theorem not_eventually_steered12 (e : Steered) (he : e ∈ steered12)
    (hw : ∀ N, ∃ t0, N ≤ t0 ∧ ∀ i, i < e.len → Rule30Jen.cell (t0 + i) 14 = e.seq.testBit i) :
    ¬ Rule30StripCertificates.EventuallyWord (Rule30StripCertificateTable.wordOf e.period e.bits) :=
  not_eventually_steered e (steered12_check e he) hw

end Rule30Open

    (hz : ∀ x : Int, x < m → init x = false) (k : Int) (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → evolve init t k = (wordOf 13 0b0001011111011).getD ((t + shift) % 13) false) : False :=
  class_column init m hm hz cls0001011111011 cls0001011111011_valid k T shift fun t ht => by
    rw [h t ht]
    show _ = bit (wordOf 13 0b0001011111011) ((t + shift) % (wordOf 13 0b0001011111011).length)
    rw [bit_eq_getD, Rule30StripCertificateTable.wordOf_length]


module

public import Rule30Open.Columns.NineWhite
public import Rule30Open.Columns.TenTraps

/-!
# Every right half white on its cells 9 to 3,058 enters the edge of the background of period 10

`TenTraps` reduces $0000010001$ to entry into its wall `ten0`, a trap of 16 cells. Every right half with support in
cells 1 to 8, driven from each of the 10 phases, enters it by step 3,042. Here the kernel runs those 2,560 halves to
their entry, and the light cone carries each entry to every half that agrees with it on its first `T + 16` cells, as
`NineWhite` does for the white half: no finite configuration whose cells 9 to 3,058 are white has a center column that
repeats the block from any phase.

* `PrefixRightW b r B φ`, `prefixRightW_of_entry`: no finite configuration whose cells `1 .. B` read the bits of `r` has
  a center column repeating `b` from phase `φ`, once the run of `r` is in a state of a checked trap at step
  `B - K`.
* `GapRightW b n B φ`, `gapEntriesOk`, `gapRightW_of_entries`: the same for every configuration white on cells
  `n + 1 .. B`, from a checked entry for each of the `2 ^ n` halves of at most `n` cells.
* `ten_gap`: `0000010001` with `n = 8` and `B = 3,058`, from every phase; `ten_white`: every configuration white on
  cells 1 to 90.

The natural-language argument is `TenGap.md`, beside this file. The entries come from
`python -m computations.lock_chain --lean-ten-gap`.
-/

@[expose] public section

-- Sequential elaboration: the kernel checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Rule30Open

open Ruliology.CellularAutomata BitGame
open Rule30Ether Rule30EtherThree Rule30Realization Rule30PeriodTwoSideways

/-- No finite configuration whose cells `1 .. B` read the bits of `r` has a center column that repeats `b` from phase
`φ`. -/
def PrefixRightW (b : List Bool) (r B φ : Nat) : Prop :=
  ¬ ∃ y : Int → Bool, FinConfig y ∧ (∀ p : Nat, 1 ≤ p → p ≤ B → y (p : Int) = r.testBit (p - 1)) ∧
    ∀ t, evol y t 0 = phased b φ t

/-- **Entry travels along the light cone**, from any start. If the run of the half `r` driven by the block of a checked
trap from phase `φ` has its first `K` cells equal to state `i` at step `T`, with the label of the right phase, then no
finite configuration whose cells `1 .. T + K` read `r` has a center column that repeats the block from phase `φ`. -/
theorem prefixRightW_of_entry (C : WTrap) (hC : C.check = true) {r φ T i : Nat} (hi : i < C.n)
    (hph : (T + φ) % C.b.length = C.lab i % C.b.length) (hw : ∃ t, phased C.b φ t = true)
    (h : rowN (phased C.b φ) r T % 2 ^ C.K = C.st i) : PrefixRightW C.b r (T + C.K) φ := by
  rintro ⟨y, hfin, hR, hc⟩
  obtain ⟨-, hK, -, -, -⟩ := C.facts hC
  have hne : ∃ p, y p = true := by
    refine Classical.byContradiction fun hz => ?_
    have hz' : ∀ p, y p = false := fun p => by
      cases hp : y p
      · rfl
      · exact absurd ⟨p, hp⟩ hz
    obtain ⟨t, ht⟩ := hw
    rw [← hc t, Rule30Coupled.evol_zero hz'] at ht
    exact absurd ht (by decide)
  obtain ⟨lo, hlo, hzero⟩ := Rule30FiniteConfigs.exists_leftmost hfin hne
  have hcen : ∀ t : Nat, 0 ≤ t → evolve y t 0 = col C.b (t + φ) := by
    intro t _
    rw [evolve_eq_evol, hc t]
    unfold phased col
    rw [bit_eq_getD]
  have hdrive : (fun t => evol y t 0) = phased C.b φ := funext hc
  refine wtrap_column C hC y lo hlo hzero 0 0 φ hcen T i (Nat.zero_le _) hi hph ?_
  apply Nat.eq_of_testBit_eq
  intro j
  rw [testBit_codeFrom]
  by_cases hj : j < C.K
  · rw [decide_eq_true hj, Bool.true_and, evolve_eq_evol, show (0 : Int) + 1 + (j : Int) = ((j + 1 : Nat) : Int) by omega,
      Rule30Coupled.right_eq_drv, hdrive, ← h, Nat.testBit_mod_two_pow, decide_eq_true hj, Bool.true_and, rowN_eq_drv]
    apply drv_cone
    intro q hq1 hq2
    exact hR q hq1 (by omega)
  · rw [decide_eq_false hj, Bool.false_and]
    have hlt : C.st i < 2 ^ C.K := Nat.mod_lt _ (Nat.two_pow_pos _)
    exact (Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le hlt (Nat.pow_le_pow_right (by decide) (by omega)))).symm

/-- No finite configuration whose cells `n + 1 .. B` are white has a center column that repeats `b` from phase `φ`. -/
def GapRightW (b : List Bool) (n B φ : Nat) : Prop :=
  ¬ ∃ y : Int → Bool, FinConfig y ∧ (∀ p : Int, (n : Int) < p → p ≤ (B : Int) → y p = false) ∧
    ∀ t, evol y t 0 = phased b φ t

/-- Entry `r` of the list, the step `T` and the state `i` of the half `r`: the state has the label of the phase at step
`T`, `T + K` is at most `B`, and the run of `r` from phase `φ` is in the state at step `T`. -/
def gapEntriesOk (C : WTrap) (φ B : Nat) (es : List (Nat × Nat)) : Bool :=
  (List.range es.length).all fun r =>
    Nat.blt (es.getD r (0, 0)).2 C.n &&
      Nat.beq (((es.getD r (0, 0)).1 + φ) % C.b.length) (C.lab (es.getD r (0, 0)).2 % C.b.length) &&
      Nat.ble ((es.getD r (0, 0)).1 + C.K) B &&
      Nat.beq (runDrive C.b (es.getD r (0, 0)).1 φ r % 2 ^ C.K) (C.st (es.getD r (0, 0)).2)

/-- **Entry across a white gap.** If every half of at most `n` cells has a checked entry, every finite configuration
whose cells `n + 1 .. B` are white is excluded. -/
theorem gapRightW_of_entries (C : WTrap) (hC : C.check = true) {φ n B : Nat} {es : List (Nat × Nat)}
    (hlen : es.length = 2 ^ n) (hok : gapEntriesOk C φ B es = true) (hw : ∃ t, phased C.b φ t = true) :
    GapRightW C.b n B φ := by
  rintro ⟨y, hfin, hR, hc⟩
  obtain ⟨r, hr, hyr⟩ := pack_gap n B (fun p => y (p : Int)) fun p h1 h2 => hR p (by omega) (by omega)
  have he := List.all_eq_true.1 hok r (List.mem_range.2 (hlen ▸ hr))
  simp only [Bool.and_eq_true, Nat.blt_eq, Nat.beq_eq, Nat.ble_eq] at he
  obtain ⟨⟨⟨hi, hph⟩, hB⟩, hrun⟩ := he
  rw [runDrive_eq] at hrun
  exact prefixRightW_of_entry C hC hi hph hw hrun ⟨y, hfin, fun p h1 h2 => hyr p h1 (by omega), hc⟩

/-- The white half is the half `0`. -/
theorem highRightW_of_prefix {b : List Bool} {B φ : Nat} (h : PrefixRightW b 0 B φ) : HighRightW b B φ := by
  rintro ⟨y, hfin, hR, hc⟩
  exact h ⟨y, hfin, fun p h1 h2 => by rw [hR (p : Int) (by omega) (by omega), Nat.zero_testBit], hc⟩


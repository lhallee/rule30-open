  decide

/-- **Entry excludes $00010001011$.** If every finitely supported right half driven by the block enters
`nat00010001011`, the center column does not eventually repeat the block. -/
theorem not_eventually_00010001011_of_trap (hA : nat00010001011.Absorption) :
    ¬ Rule30StripCertificates.EventuallyWord [false, false, false, true, false, false, false, true, false, true, true] :=
  absorption_excludes nat00010001011 nat00010001011_check hA


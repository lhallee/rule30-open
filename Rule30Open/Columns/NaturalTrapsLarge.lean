/-!
# A trap of 61,857 states for the block $00010001011$ of period 11, checked in parts

Driven by $00010001011$ for 12,000 steps, the white right half and each of the 30 random halves of 64 cells of the
natural scan end inside one closed set of windows of 30 cells on which column 1 is fixed at the white phases, with the
phase counted modulo 22: the closure of their windows under both values of the cell beyond. It is the one trap of that
scan, at periods 10 to 12, that [NaturalTraps](NaturalTraps.md) leaves out. Its packed numbers have about two million
bits each, so they are written in pieces of 65,536 bits, which Lean reads in seconds where one literal takes minutes,
and the check runs in parts of 1,024 states, one kernel check each, which keeps the kernel's tables of one part in
memory at a time.

* `allRangeT`, `allRangeT_spec`, `allBelowT_of_forall`, `allRange_cover`: a check over a range of states, and parts
  that cover a range give the check over it.
* `nat00010001011`, `nat00010001011_check`: the trap, passing the check of [WordTraps](WordTraps.md).
* `not_eventually_00010001011_of_trap`: if every finitely supported right half driven by the block enters it, the center
  column does not eventually repeat the block.

The trap and its parts come from `python -m computations.lock_chain --lean-large`. The natural-language argument is
`NaturalTrapsLarge.md`, beside this file.
-/

@[expose] public section

-- Sequential elaboration: the kernel checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Rule30Open

open Ruliology.CellularAutomata

/-- `p` holds at `lo + c - 1, …, lo`, walked from the top as `Rule30EtherThree.allBelowT` walks its range. -/
def allRangeT (p : Nat → Bool) (lo : Nat) : Nat → Bool
  | 0 => true
  | c + 1 => p (lo + c) && allRangeT p lo c

theorem allRangeT_spec {p : Nat → Bool} {lo : Nat} :
    ∀ {c}, allRangeT p lo c = true → ∀ i, lo ≤ i → i < lo + c → p i = true
  | 0, _, i, _, h2 => absurd h2 (by omega)
  | c + 1, h, i, h1, h2 => by
    rw [allRangeT, Bool.and_eq_true] at h
    by_cases hin : i < lo + c
    · exact allRangeT_spec h.2 i h1 hin
    · rw [show i = lo + c by omega]
      exact h.1

theorem allBelowT_of_forall {p : Nat → Bool} :
    ∀ {n}, (∀ i, i < n → p i = true) → Rule30EtherThree.allBelowT p n = true
  | 0, _ => rfl
  | n + 1, h => by
    rw [Rule30EtherThree.allBelowT, Bool.and_eq_true]
    exact ⟨h n (by omega), allBelowT_of_forall (fun i hi => h i (by omega))⟩

/-- Parts of `c` from `0` to `c q` and a last one of `r` cover the range below `c q + r`. -/
theorem allRange_cover {p : Nat → Bool} {c q r : Nat} (hc : 0 < c)
    (h : ∀ k, k < q → allRangeT p (c * k) c = true) (hr : allRangeT p (c * q) r = true) :
    ∀ i, i < c * q + r → p i = true := by
  intro i hi
  by_cases hq : i < c * q
  · have hk : i / c < q := (Nat.div_lt_iff_lt_mul hc).mpr (by rw [Nat.mul_comm]; exact hq)
    have h1 : c * (i / c) ≤ i := Nat.mul_div_le i c
    have h2 : i < c * (i / c) + c := by
      have := Nat.div_add_mod i c
      have := Nat.mod_lt i hc
      omega
    exact allRangeT_spec (h (i / c) hk) i h1 h2
  · exact allRangeT_spec hr i (by omega) hi


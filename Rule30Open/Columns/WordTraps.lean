module

public import Rule30Open.Columns.LockBlocks
public import Ruliology.CellularAutomata.Rule30EtherThree

/-!
# Labelled traps for a block of any period, and traps for blocks of period 2, 3, 5, 6, 7 and 9

The kit checks a labelled trap for `001` (`Rule30EtherThree.PTrap`, `t001`): states of the cells next to the center,
each with a time label modulo a multiple of 3, closed under both values of the cell beyond them, with the cell beside
the center a function of the label at the white phases. Here the same check is written for a block of any period and
proved sound for every column of every row with a leftmost 1.

* `WTrap`, `WTrap.check`: a block `b`, a width `K`, labels modulo a multiple `m` of the period, and packed tables of
  windows, labels and successors, as the kit packs `t001`.
* `wtrap_invariant`, `wtrap_column`: once column `k` repeats `b` and the window of the `K` cells right of it is a state
  with the label of the right phase, it stays in the trap, so column `k - 1` repeats with period `m` beside column `k`,
  which Jen's theorem on adjacent columns rules out.
* `center_wtrap`, `WTrap.Absorption`, `absorption_excludes`: the same for the center column of the single cell, and
  entry of every finitely supported right half driven by `b`, in the form of the kit's `AbsorptionT`, excludes `b` as a
  tail of the center column, in the kit's form `EventuallyWord`.
* `trap01`, `trap001fifteen`, `trap01111`, `trap001011`, `trap0011101`, `trap001011101`, with their kernel checks:
  traps for `01` (period 2, 19 cells, labels modulo 8), `001` (52 cells, modulo 15, beside the kit's `t001`), `01111`
  (period 5, 107 cells, modulo 20), `001011` (period 6, 29 cells, modulo 12), `0011101` (period 7, 35 cells, modulo
  14) and `001011101` (period 9, 30 cells, modulo 18). Each is the locked window of a block with a long run of 1s,
  carried leftward through columns the rule determines; the one for `01` is the kit's ether-and-wall family read so.
* `not_eventually_01_of_absorption`, `not_eventually_001_of_absorption_fifteen`, `not_eventually_01111_of_absorption`,
  `not_eventually_001011_of_absorption`, `not_eventually_0011101_of_absorption`,
  `not_eventually_001011101_of_absorption`: the reductions.

The natural-language argument is `WordTraps.md`, beside this file.
-/

@[expose] public section

namespace Rule30Open

open Ruliology.CellularAutomata BitGame

/-- A labelled trap for the block `b`, packed as the kit packs `t001`: state `i < n` has window `st i` (`K` bits, cell
`x` at bit `x - 1`), label `lab i` (below `m`, `lb` bits) and successors `nxt i z` (`ib` bits); the block reads phase
`lab i` modulo its period, and at a white phase the first cell is bit `lab i` of `u`. -/
structure WTrap where
  b : List Bool
  K : Nat
  m : Nat
  n : Nat
  lb : Nat
  ib : Nat
  u : Nat
  R : Nat
  L : Nat
  S : Nat

namespace WTrap

variable (C : WTrap)

def st (i : Nat) : Nat := (C.R >>> (C.K * i)) % 2 ^ C.K
def lab (i : Nat) : Nat := (C.L >>> (C.lb * i)) % 2 ^ C.lb
def nxt (i : Nat) (z : Bool) : Nat := (C.S >>> (C.ib * (2 * i + z.toNat))) % 2 ^ C.ib

/-- The move of state `i` under the value `z` of the cell beyond is state `nxt i z`, one label later. -/
def edgeOK (i : Nat) (z : Bool) : Bool :=
  decide (C.nxt i z < C.n) &&
  (C.st (C.nxt i z) == GameMask.move C.K (col C.b (C.lab i)) z (C.st i)) &&
  (C.lab (C.nxt i z) == (C.lab i + 1) % C.m)

def nodeOK (i : Nat) : Bool :=
  decide (C.lab i < C.m) &&
  (col C.b (C.lab i) || ((C.st i).testBit 0 == C.u.testBit (C.lab i))) &&
  C.edgeOK i false && C.edgeOK i true

/-- **The check**, evaluated by the kernel for a concrete trap. -/
def check : Bool :=
  decide (0 < C.b.length) && decide (0 < C.K) && decide (0 < C.m) && decide (C.m % C.b.length = 0) &&
    Rule30EtherThree.allBelowT C.nodeOK C.n

theorem facts (hC : C.check = true) :
    0 < C.b.length ∧ 0 < C.K ∧ 0 < C.m ∧ C.m % C.b.length = 0 ∧ ∀ i, i < C.n → C.nodeOK i = true := by
  unfold check at hC
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hC
  exact ⟨hC.1.1.1.1, hC.1.1.1.2, hC.1.1.2, hC.1.2, Rule30EtherThree.allBelowT_spec hC.2⟩

theorem step (hC : C.check = true) {i : Nat} (hi : i < C.n) (z : Bool) :
    C.nxt i z < C.n ∧ C.st (C.nxt i z) = GameMask.move C.K (col C.b (C.lab i)) z (C.st i) ∧
      C.lab (C.nxt i z) = (C.lab i + 1) % C.m ∧ C.lab i < C.m ∧
      (col C.b (C.lab i) = false → (C.st i).testBit 0 = C.u.testBit (C.lab i)) := by
  have h := (C.facts hC).2.2.2.2 i hi
  unfold nodeOK edgeOK at h
  simp only [Bool.and_eq_true, decide_eq_true_eq, Bool.or_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨hl, hu⟩, ⟨⟨f0, f1⟩, f2⟩⟩, ⟨⟨t0, t1⟩, t2⟩⟩ := h
  refine ⟨?_, ?_, ?_, hl, fun hw => ?_⟩
  · cases z
    · exact f0
    · exact t0
  · cases z
    · exact f1
    · exact t1
  · cases z
    · exact f2
    · exact t2
  · rcases hu with hu | hu
    · rw [hw] at hu
      exact absurd hu (by decide)
    · exact hu

/-- Labels advance with the phase: two times whose phases agree with two labels stay in step, modulo the period. -/
theorem phase (hC : C.check = true) (x l s : Nat) (h : x % C.b.length = l % C.b.length) :
    (x + s) % C.b.length = (l + s) % C.m % C.b.length := by
  obtain ⟨_, _, _, hm, _⟩ := C.facts hC
  rw [Nat.mod_mod_of_dvd _ (Nat.dvd_of_mod_eq_zero hm), Nat.add_mod, h, ← Nat.add_mod]

end WTrap

/-- **The window stays in the trap.** If column `k` repeats the block from `T` and at `t₁ ≥ T` the window of the `K`
cells right of it is state `i`, with the label of the right phase, then `s` steps later it is a state whose label is
`s` more, modulo `m`. -/
theorem wtrap_invariant (C : WTrap) (hC : C.check = true) (init : Int → Bool) (k : Int) (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → evolve init t k = col C.b (t + shift))
    (t1 i : Nat) (ht1 : T ≤ t1) (hi : i < C.n) (hph : (t1 + shift) % C.b.length = C.lab i % C.b.length)
    (hw : codeFrom init t1 (k + 1) C.K = C.st i) :
    ∀ s, ∃ j, j < C.n ∧ codeFrom init (t1 + s) (k + 1) C.K = C.st j ∧ C.lab j = (C.lab i + s) % C.m := by
  have hli : C.lab i < C.m := (C.step hC hi false).2.2.2.1
  intro s
  induction s with
  | zero => exact ⟨i, hi, hw, by rw [Nat.add_zero, Nat.mod_eq_of_lt hli]⟩
  | succ s ih =>
    obtain ⟨j, hj, hwj, hlj⟩ := ih
    have hcol : evolve init (t1 + s) k = col C.b (C.lab j) := by
      rw [h (t1 + s) (by omega)]
      unfold col
      congr 1
      rw [hlj, show t1 + s + shift = (t1 + shift) + s by omega]
      exact C.phase hC _ _ _ hph
    obtain ⟨hnj, hst, hlab, -, -⟩ := C.step hC hj (evolve init (t1 + s) (k + 1 + (C.K : Int)))
    refine ⟨C.nxt j (evolve init (t1 + s) (k + 1 + (C.K : Int))), hnj, ?_, ?_⟩
    · rw [show t1 + (s + 1) = t1 + s + 1 by omega, codeFrom_succ, show k + 1 - 1 = k by omega, hwj, hst,
        GameMask.move_eq, ← hcol]
    · rw [hlab, hlj, Nat.mod_add_mod, Nat.add_assoc]

/-- **Entering a trap is impossible.** In the orbit of a row with a leftmost 1, if column `k` repeats the block from
`T` and at some `t₁ ≥ T` the window of the `K` cells right of it is a state of a checked trap with the label of the
right phase, then column `k + 1` at the white phases is a function of the label, so column `k - 1` repeats with period
`m` beside column `k`, which Jen's theorem on adjacent columns rules out. -/
theorem wtrap_column (C : WTrap) (hC : C.check = true) (init : Int → Bool) (mm : Int) (hm : init mm = true)
    (hz : ∀ x : Int, x < mm → init x = false) (k : Int) (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → evolve init t k = col C.b (t + shift))
    (t1 i : Nat) (ht1 : T ≤ t1) (hi : i < C.n) (hph : (t1 + shift) % C.b.length = C.lab i % C.b.length)
    (hw : codeFrom init t1 (k + 1) C.K = C.st i) : False := by
  obtain ⟨-, hK, hm0, hmP, -⟩ := C.facts hC
  have inv := wtrap_invariant C hC init k T shift h t1 i ht1 hi hph hw
  -- column `k + 1` at the white phases is a function of the label
  have key : ∀ t, t1 ≤ t → evolve init t k = false →
      evolve init t (k + 1) = C.u.testBit ((C.lab i + (t - t1)) % C.m) := by
    intro t ht hwt
    obtain ⟨j, hj, hwj, hlj⟩ := inv (t - t1)
    rw [show t1 + (t - t1) = t by omega] at hwj
    have hcol : evolve init t k = col C.b (C.lab j) := by
      rw [h t (by omega)]
      unfold col
      congr 1
      rw [hlj, show t + shift = (t1 + shift) + (t - t1) by omega]
      exact C.phase hC _ _ _ hph
    obtain ⟨-, -, -, -, hu⟩ := C.step hC hj false
    rw [← hlj, ← hu (by rw [← hcol]; exact hwt), ← hwj, testBit_codeFrom, decide_eq_true hK, Bool.true_and,
      show k + 1 + ((0 : Nat) : Int) = k + 1 by omega]
  -- column `k` repeats with period `m`
  have hper : ∀ t, T ≤ t → evolve init (t + C.m) k = evolve init t k := by
    intro t ht
    rw [h (t + C.m) (by omega), h t ht]
    unfold col
    obtain ⟨q, hq⟩ := Nat.dvd_of_mod_eq_zero hmP
    rw [hq, show t + C.b.length * q + shift = (t + shift) + C.b.length * q by omega, Nat.add_mul_mod_self_left]
  -- and so does column `k - 1`, from `t₁` on
  have hleft : ∀ t, t1 ≤ t → evolve init (t + C.m) (k - 1) = evolve init t (k - 1) := by
    intro t ht
    rw [left_cell init (t + C.m) k, left_cell init t k, show t + C.m + 1 = t + 1 + C.m by omega,
      hper (t + 1) (by omega), hper t (by omega)]
    cases hwt : evolve init t k
    · rw [key (t + C.m) (by omega) (by rw [hper t (by omega)]; exact hwt), key t ht hwt,
        show C.lab i + (t + C.m - t1) = (C.lab i + (t - t1)) + C.m * 1 by omega, Nat.add_mul_mod_self_left]
    · rfl
  exact adjacent_columns init mm hm hz (k - 1) t1 C.m hm0 hleft
    (fun t ht => by rw [show k - 1 + 1 = k by omega]; exact hper t (by omega))

/-- **The center column of the single cell.** If it repeats the block from `T`, read from phase `shift`, the cells
`1, …, K` are not a state of a checked trap with the label of the right phase at any time `t₁ ≥ T`. -/
theorem center_wtrap (C : WTrap) (hC : C.check = true) (T shift : Nat)
    (h : ∀ t : Nat, T ≤ t → Rule30Prize.center t = C.b.getD ((t + shift) % C.b.length) false)
    (t1 i : Nat) (ht1 : T ≤ t1) (hi : i < C.n) (hph : (t1 + shift) % C.b.length = C.lab i % C.b.length) :
    codeFrom single t1 1 C.K ≠ C.st i := fun hw =>
  wtrap_column C hC single 0 rfl (fun x hx => decide_eq_false (by omega)) 0 T shift
    (fun t ht => by rw [evolve_single_center, h t ht]; unfold col; rw [bit_eq_getD]) t1 i ht1 hi hph
    (by rw [show (0 : Int) + 1 = 1 by rfl]; exact hw)

/-- **Entry into the trap** (a `Prop`, in the form of the kit's `AbsorptionT`): every finitely supported right half
driven by the block, from any phase, eventually has its first `K` cells in a state of the trap with the label of the
right phase. -/
def WTrap.Absorption (C : WTrap) : Prop :=
  ∀ (x : Nat → Bool) (n : Nat), (∀ p, n < p → x p = false) → ∀ φ : Nat,
    ∃ t1 i, i < C.n ∧ (t1 + φ) % C.b.length = C.lab i % C.b.length ∧
      Rule30EtherThree.EncF (Rule30Ether.drv (fun t => C.b.getD ((t + φ) % C.b.length) false) x) C.K t1 0 (C.st i)

/-- **Entry into a checked trap excludes the block** as a tail of the center column, for every transient, in the kit's
form `Rule30StripCertificates.EventuallyWord`. -/
theorem absorption_excludes (C : WTrap) (hC : C.check = true) (hA : C.Absorption) :
    ¬ Rule30StripCertificates.EventuallyWord C.b := by
  rintro ⟨T, hT⟩
  obtain ⟨hP, hK, -, -, -⟩ := C.facts hC
  have hc : (fun t => Rule30Jen.cell (T + t) 0) = (fun t => C.b.getD ((t + 0) % C.b.length) false) := by
    funext t
    rw [hT (T + t) (by omega)]
    congr 2
    omega
  have hfin : ∀ p, T < p → (fun p : Nat => Rule30Jen.cell T (p : Int)) p = false :=
    fun p hp => Rule30Diagonals.cell_eq_false_of_gt T p (by omega)
  obtain ⟨t1, i, hi, hph, hr⟩ := hA (fun p => Rule30Jen.cell T (p : Int)) T hfin 0
  rw [← hc] at hr
  have hcode : codeFrom single (T + t1) 1 C.K = C.st i := by
    apply Nat.eq_of_testBit_eq
    intro j
    rw [testBit_codeFrom, evolve_single_eq_cell]
    by_cases hj : j < C.K
    · rw [decide_eq_true hj, Bool.true_and, hr.2 j hj, show 0 + 1 + j = j + 1 by omega,
        ← Rule30Ether.cell_eq_drv T t1 (j + 1)]
      congr 1
      omega
    · rw [decide_eq_false hj, Bool.false_and]
      exact (Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le hr.1 (Nat.pow_le_pow_right (by decide) (by omega)))).symm
  have hLT : T ≤ C.b.length * T := Nat.le_mul_of_pos_left T hP
  refine center_wtrap C hC T (C.b.length * T - T) (fun t ht => ?_) (T + t1) i (by omega) hi ?_ hcode
  · rw [← evolve_single_center, evolve_single_eq_cell]
    show Rule30Jen.cell t 0 = _
    rw [hT t ht, show t + (C.b.length * T - T) = t - T + C.b.length * T by omega, Nat.add_mul_mod_self_left]
  · rw [← hph, show T + t1 + (C.b.length * T - T) = t1 + 0 + C.b.length * T by omega, Nat.add_mul_mod_self_left]


/-- **`01`, period 2, reduced to entry into a trap** of 19 cells with labels modulo 8. -/
theorem not_eventually_01_of_absorption (hA : trap01.Absorption) :
    ¬ Rule30StripCertificates.EventuallyWord [false, true] :=
  absorption_excludes trap01 trap01_check hA

/-- **`01111`, period 5, reduced to entry into a trap** of 107 cells with labels modulo 20. -/
theorem not_eventually_01111_of_absorption (hA : trap01111.Absorption) :
    ¬ Rule30StripCertificates.EventuallyWord [false, true, true, true, true] :=
  absorption_excludes trap01111 trap01111_check hA

/-- **`001011111`, period 9, reduced to entry into a trap that driven halves enter**: the trap of 43 cells with labels
modulo 9 is the closure of a true window of a right half driven by `001011111`, which enters it. -/
theorem not_eventually_001011111_of_absorption (hA : trap001011111.Absorption) :
    ¬ Rule30StripCertificates.EventuallyWord [false, false, true, false, true, true, true, true, true] :=
  absorption_excludes trap001011111 trap001011111_check hA

/-- **`001011`, period 6, reduced to entry into a trap**: if every finitely supported right half driven by `001011`
enters `trap001011`, the center column does not eventually repeat `001011`. -/
theorem not_eventually_001011_of_absorption (hA : trap001011.Absorption) :
    ¬ Rule30StripCertificates.EventuallyWord [false, false, true, false, true, true] :=
  absorption_excludes trap001011 trap001011_check hA

/-- **`0011101`, period 7, reduced to entry into a trap.** -/
theorem not_eventually_0011101_of_absorption (hA : trap0011101.Absorption) :
    ¬ Rule30StripCertificates.EventuallyWord [false, false, true, true, true, false, true] :=
  absorption_excludes trap0011101 trap0011101_check hA

/-- **`001011101`, period 9, reduced to entry into a trap.** -/
theorem not_eventually_001011101_of_absorption (hA : trap001011101.Absorption) :
    ¬ Rule30StripCertificates.EventuallyWord [false, false, true, false, true, true, true, false, true] :=
  absorption_excludes trap001011101 trap001011101_check hA

/-- **`001` reduced to entry into a second trap**, with labels modulo 15 where the kit's `t001` has 21. -/
theorem not_eventually_001_of_absorption_fifteen (hA : trap001fifteen.Absorption) :
    ¬ Rule30StripCertificates.EventuallyWord [false, false, true] :=
  absorption_excludes trap001fifteen trap001fifteen_check hA


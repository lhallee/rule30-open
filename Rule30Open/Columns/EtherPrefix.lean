/-! ### No center column repeats the word -/

/-- No finite configuration whose right half is the ether aligned by one of `A`, truncated anywhere and followed by a
word of at most four cells, has a center column that repeats `w` from phase `φ`. -/
def PrefixRight (w : List Bool) (A : List (Nat × Nat)) (φ : Nat) : Prop :=
  ¬ ∃ y : Int → Bool, FinConfig y ∧
    (∃ a ∈ A, ∃ K u, u < 16 ∧ ∀ p : Nat, 1 ≤ p → y (p : Int) = prefixHalf a.1 ((a.2 + φ) % 4) K u p) ∧
      ∀ t, evol y t 0 = wordAt w (t + φ)

/-- **No finite configuration whose right half is a truncated aligned ether followed by a word of at most four cells
has a center column that repeats `0001`**, in any phase and whatever its left half. -/
theorem prefixRight_0001 (φ : Nat) : PrefixRight w0001 A0001 φ := by
  rintro ⟨y, hfin, ⟨a, ha, K, u, hu, hy⟩, hc⟩
  obtain ⟨b, hb, t1, hF⟩ := etherPrefix_0001 φ ha K u hu
  have e : drv (fun t => wordAt w0001 (t + φ)) (fun p => y (p : Int)) =
      drv (fun t => wordAt w0001 (t + φ)) (prefixHalf a.1 ((a.2 + φ) % 4) K u) :=
    funext fun t => funext fun p => drv_congr (fun q hq => hy q hq) t p
  exact no_finite_of_family (A0001_ok b hb) φ hfin hc ⟨3, rfl⟩ t1 (by rw [e]; exact hF)


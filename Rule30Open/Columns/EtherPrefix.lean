module

public import Rule30Open.Columns.SparseRight

/-!
# Truncated ether: every right half that is the aligned ether up to a cell, then a short word, enters the family

The pure ether, aligned with the center's word, is a right half that never enters the kit's ether-and-wall family, and
in the absorption census it is the only infinite half seen to stay out. Its truncations do enter: for each word of
least period four, each of its alignments and every phase, the right half that is the aligned ether on cells `1 .. K`,
then any word of at most four cells, then white, enters the family, for every `K` (`etherPrefix_0001`,
`etherPrefix_0011`, `etherPrefix_0111`). So no finite configuration with such a right half has a center column that
repeats the word, whatever its left half (`prefixRight_0001`, `prefixRight_0011`, `prefixRight_0111`).

Seven more columns of ether in front of a half delay nothing (`shift7_drv`, `shift7_family`): if a half enters the
family at step `T` and its column 1 has been the ether's at every step before `T`, then the half behind seven ether
columns enters at the same step, seven columns deeper, and its column 1 is again the ether's. So finitely many kernel
checks, one base per residue of the truncation point modulo 7 and a direct check of every shorter truncation, give
entry for every truncation point (`prefix_absorption`). The bases lie at most 50 cells deep and enter by step 222, the
shorter truncations by step 688.

The natural-language argument is `EtherPrefix.md`, beside this file.
-/

@[expose] public section

namespace Rule30Open

open Ruliology.CellularAutomata
open Rule30Jen Rule30Realization Rule30Ether Rule30StripCertificates Rule30PeriodTwoSideways

/-! ### Seven columns of ether in front -/

/-- The right half `x` behind seven columns of the ether: columns `1 .. 7` are the ether columns `j0 + 1 .. j0 + 7` at
phase `s`, and column `p + 7` is column `p` of `x`. -/
def shift7 (j0 s : Nat) (x : Nat → Bool) (p : Nat) : Bool := if p ≤ 7 then ether (j0 + p) s else x (p - 7)

/-- **Seven columns of ether in front change nothing behind them**, while column 1 of the original half stays the
ether's: the front seven columns stay the ether, and the rest is the original half moved seven columns right. -/
theorem shift7_drv {c x : Nat → Bool} {j0 s T : Nat} (hc : ∀ t, c t = ether j0 (t + s))
    (hclean : ∀ t, t < T → drv c x t 1 = ether (j0 + 1) (t + s)) :
    ∀ t, t ≤ T → (∀ p, p ≤ 7 → drv c (shift7 j0 s x) t p = ether (j0 + p) (t + s)) ∧
      ∀ p, drv c (shift7 j0 s x) t (p + 7) = drv c x t p
  | 0, _ => by
    have front : ∀ p, p ≤ 7 → drv c (shift7 j0 s x) 0 p = ether (j0 + p) (0 + s) := by
      intro p hp
      rcases Nat.eq_zero_or_pos p with h0 | h0
      · subst h0; rw [drv_col0, hc, Nat.add_zero]
      · rw [drv_init _ _ _ h0]
        unfold shift7
        rw [ite_eq_left hp, Nat.zero_add]
    refine ⟨front, fun p => ?_⟩
    rcases Nat.eq_zero_or_pos p with h0 | h0
    · subst h0
      rw [Nat.zero_add, front 7 (Nat.le_refl 7), drv_col0, hc]
      exact ether_congr (by omega) rfl
    · rw [drv_init _ _ _ (by omega), drv_init _ _ _ h0]
      unfold shift7
      rw [ite_eq_right (by omega), Nat.add_sub_cancel]
  | t + 1, hT => by
    obtain ⟨hA, hB⟩ := shift7_drv hc hclean t (by omega)
    have front : ∀ p, p ≤ 7 → drv c (shift7 j0 s x) (t + 1) p = ether (j0 + p) (t + 1 + s) := by
      intro p hp
      rcases Nat.eq_zero_or_pos p with h0 | h0
      · subst h0; rw [drv_col0, hc]; rfl
      · obtain ⟨q, rfl⟩ : ∃ q, p = q + 1 := ⟨p - 1, by omega⟩
        show rule (drv c (shift7 j0 s x) t q) (drv c (shift7 j0 s x) t (q + 1))
            (drv c (shift7 j0 s x) t (q + 2)) = _
        have h3 : drv c (shift7 j0 s x) t (q + 2) = ether (j0 + (q + 2)) (t + s) := by
          by_cases hq : q + 2 ≤ 7
          · exact hA (q + 2) hq
          · rw [show q + 2 = 1 + 7 by omega, hB 1, hclean t (by omega)]
            exact ether_congr (by omega) rfl
        rw [hA q (by omega), hA (q + 1) hp, h3, show t + 1 + s = (t + s) + 1 by omega,
          ether_rule (j0 + (q + 1)) (t + s)]
        rw [ether_congr (j := j0 + q) (j' := j0 + (q + 1) + 6) (φ := t + s) (φ' := t + s) (by omega) rfl,
          show j0 + (q + 2) = j0 + (q + 1) + 1 by omega]
    refine ⟨front, fun p => ?_⟩
    rcases Nat.eq_zero_or_pos p with h0 | h0
    · subst h0
      rw [Nat.zero_add, front 7 (Nat.le_refl 7), drv_col0, hc]
      exact ether_congr (by omega) rfl
    · obtain ⟨q, rfl⟩ : ∃ q, p = q + 1 := ⟨p - 1, by omega⟩
      show rule (drv c (shift7 j0 s x) t (q + 7)) (drv c (shift7 j0 s x) t (q + 1 + 7))
          (drv c (shift7 j0 s x) t (q + 2 + 7)) = rule (drv c x t q) (drv c x t (q + 1)) (drv c x t (q + 2))
      rw [hB q, hB (q + 1), hB (q + 2)]

/-- **Entry survives seven columns of ether in front**, seven columns deeper, and so does the clean column 1. -/
theorem shift7_family {c x : Nat → Bool} {j0 s T : Nat} (hc : ∀ t, c t = ether j0 (t + s))
    (hclean : ∀ t, t < T → drv c x t 1 = ether (j0 + 1) (t + s)) (hF : InFamily (drv c x) j0 s T) :
    InFamily (drv c (shift7 j0 s x)) j0 s T ∧
      ∀ t, t < T → drv c (shift7 j0 s x) t 1 = ether (j0 + 1) (t + s) := by
  obtain ⟨k, hk, hE, hW⟩ := hF
  have h := shift7_drv hc hclean
  obtain ⟨hA, hB⟩ := h T (Nat.le_refl T)
  refine ⟨⟨k + 7, by omega, fun p hp1 hpk => ?_, ?_⟩, fun t ht => (h t (by omega)).1 1 (by omega)⟩
  · by_cases hp : p ≤ 7
    · exact hA p hp
    · obtain ⟨q, rfl⟩ : ∃ q, p = q + 7 := ⟨p - 7, by omega⟩
      rw [hB q, hE q (by omega) (by omega)]
      exact ether_congr (by omega) rfl
  · have e : rowOf (drv c (shift7 j0 s x)) T (k + 7) 13 = rowOf (drv c x) T k 13 := by
      unfold rowOf
      apply seg_congr
      intro i _
      rw [show k + 7 + i + 1 = (k + i + 1) + 7 by omega, hB]
    rw [e]
    exact hW

/-- `m` times seven columns of ether in front. -/
def shiftN (j0 s : Nat) : Nat → (Nat → Bool) → Nat → Bool
  | 0, x => x
  | m + 1, x => shift7 j0 s (shiftN j0 s m x)

theorem shiftN_family {c x : Nat → Bool} {j0 s T : Nat} (hc : ∀ t, c t = ether j0 (t + s))
    (hclean : ∀ t, t < T → drv c x t 1 = ether (j0 + 1) (t + s)) (hF : InFamily (drv c x) j0 s T) :
    ∀ m, InFamily (drv c (shiftN j0 s m x)) j0 s T ∧
      ∀ t, t < T → drv c (shiftN j0 s m x) t 1 = ether (j0 + 1) (t + s)
  | 0 => ⟨hF, hclean⟩
  | m + 1 => by
    obtain ⟨hF', hclean'⟩ := shiftN_family hc hclean hF m
    exact shift7_family hc hclean' hF'

/-! ### The truncated ether -/

/-- The ether columns `j0 + 1 .. j0 + K` at phase `ψ` on cells `1 .. K`, then the word `u` (bit `i` at cell
`K + 1 + i`), white beyond. -/
def prefixHalf (j0 ψ K u : Nat) (p : Nat) : Bool := if p ≤ K then ether (j0 + p) ψ else u.testBit (p - K - 1)

theorem shiftN_prefix (j0 ψ K u : Nat) :
    ∀ m p, 1 ≤ p → shiftN j0 ψ m (prefixHalf j0 ψ K u) p = prefixHalf j0 ψ (K + 7 * m) u p
  | 0, p, _ => by rw [Nat.mul_zero, Nat.add_zero]; rfl
  | m + 1, p, hp => by
    show shift7 j0 ψ (shiftN j0 ψ m (prefixHalf j0 ψ K u)) p = _
    unfold shift7
    by_cases h7 : p ≤ 7
    · rw [ite_eq_left h7]
      unfold prefixHalf
      rw [ite_eq_left (by omega)]
    · rw [ite_eq_right h7, shiftN_prefix j0 ψ K u m (p - 7) (by omega)]
      unfold prefixHalf
      by_cases hK : p ≤ K + 7 * (m + 1)
      · rw [ite_eq_left (by omega), ite_eq_left hK]
        exact ether_congr (by omega) rfl
      · rw [ite_eq_right (by omega), ite_eq_right hK]
        congr 1
        omega

/-- The packed truncated ether, valid for `K ≤ 64`, `j0 < 7` and `ψ < 4`. -/
def packHalf (j0 ψ K u : Nat) : Nat := (etherWords.getD j0 []).getD ψ 0 % 2 ^ K ||| (u <<< K)

theorem testBit_packHalf {j0 ψ K u : Nat} (hj0 : j0 < 7) (hψ : ψ < 4) (hK : K ≤ 64) (i : Nat) :
    (packHalf j0 ψ K u).testBit i = prefixHalf j0 ψ K u (i + 1) := by
  unfold packHalf prefixHalf
  rw [Nat.testBit_or, Nat.testBit_mod_two_pow, Nat.testBit_shiftLeft]
  by_cases hi : i < K
  · rw [decide_eq_true hi, decide_eq_false (by omega), Bool.true_and, Bool.false_and, Bool.or_false,
      etherWords_spec j0 hj0 ψ hψ i (by omega), ite_eq_left (by omega)]
  · rw [decide_eq_false hi, decide_eq_true (by omega), Bool.false_and, Bool.true_and, Bool.false_or,
      ite_eq_right (by omega)]
    congr 1
    omega

/-- Column 1 of the packed half is the ether column `j0 + 1` at every step before `T`. -/
def cleanCheck (c : Nat → Bool) (j0 ψ x0 : Nat) : Nat → Bool
  | 0 => true
  | n + 1 => cleanCheck c j0 ψ x0 n && ((Rule30EtherThree.rowN c x0 n).testBit 0 == ether (j0 + 1) (n + ψ))

theorem cleanCheck_spec {c : Nat → Bool} {j0 ψ x0 : Nat} :
    ∀ T, cleanCheck c j0 ψ x0 T = true → ∀ t, t < T → (Rule30EtherThree.rowN c x0 t).testBit 0 = ether (j0 + 1) (t + ψ)
  | 0, _, _, ht => absurd ht (by omega)
  | T + 1, h, t, ht => by
    unfold cleanCheck at h
    rw [Bool.and_eq_true, beq_iff_eq] at h
    by_cases htT : t = T
    · subst htT; exact h.2
    · exact cleanCheck_spec T h.1 t (by omega)

/-- A base: the packed half is in the family for the alignment `j0` itself at step `T` and depth `k`, with column 1
the ether's at every step before. -/
def baseOK (w : List Bool) (φ j0 ψ x0 T k : Nat) : Bool :=
  fastFamily (Rule30EtherThree.rowN (fun t => wordAt w (t + φ)) x0 T) j0 ψ T k &&
    cleanCheck (fun t => wordAt w (t + φ)) j0 ψ x0 T

/-- The truncations at `K, K + 1, ...`, `n` of them, enter at the steps and depths packed in `D`, 17 bits an entry,
through any alignment. -/
def directN (w : List Bool) (A : List (Nat × Nat)) (φ j0 ψ u : Nat) : Nat → Nat → Nat → Bool
  | 0, _, _ => true
  | n + 1, K, D => entryOK w A φ 4096 (packHalf j0 ψ K u) (entryAt D / 64) (entryAt D % 64) &&
      directN w A φ j0 ψ u n (K + 1) (D >>> 17)

/-- The truncations at `K, K + 1, ...`, `n` of them, are bases at the steps and depths packed in `D`. -/
def basesN (w : List Bool) (φ j0 ψ u : Nat) : Nat → Nat → Nat → Bool
  | 0, _, _ => true
  | n + 1, K, D => baseOK w φ j0 ψ (packHalf j0 ψ K u) (entryAt D / 64) (entryAt D % 64) &&
      basesN w φ j0 ψ u n (K + 1) (D >>> 17)

/-- One tail word `u`: `B` in the low 6 bits of `D`, then the direct entries of the truncations `0 .. B - 1`, then the
bases at `B .. B + 6`. -/
def tailOK (w : List Bool) (A : List (Nat × Nat)) (φ j0 ψ u D : Nat) : Bool :=
  Nat.ble (D % 64 + 7) 64 && directN w A φ j0 ψ u (D % 64) 0 (D >>> 6) &&
    basesN w φ j0 ψ u 7 (D % 64) (D >>> (6 + 17 * (D % 64)))

/-- `tailOK` for the tail words `u, u + 1, ...`, one packed number each. -/
def tailsOK (w : List Bool) (A : List (Nat × Nat)) (φ j0 ψ : Nat) : Nat → List Nat → Bool
  | _, [] => true
  | u, D :: rest => tailOK w A φ j0 ψ u D && tailsOK w A φ j0 ψ (u + 1) rest

theorem directN_spec {w : List Bool} {A : List (Nat × Nat)} {φ j0 ψ u : Nat} :
    ∀ n K0 D, directN w A φ j0 ψ u n K0 D = true →
      ∀ K, K0 ≤ K → K < K0 + n → ∃ t k, entryOK w A φ 4096 (packHalf j0 ψ K u) t k = true
  | 0, _, _, _, K, h1, h2 => absurd h2 (by omega)
  | n + 1, K0, D, h, K, h1, h2 => by
    unfold directN at h
    rw [Bool.and_eq_true] at h
    by_cases hK : K = K0
    · subst hK; exact ⟨_, _, h.1⟩
    · exact directN_spec n (K0 + 1) (D >>> 17) h.2 K (by omega) (by omega)

theorem basesN_spec {w : List Bool} {φ j0 ψ u : Nat} :
    ∀ n K0 D, basesN w φ j0 ψ u n K0 D = true →
      ∀ K, K0 ≤ K → K < K0 + n → ∃ T k, baseOK w φ j0 ψ (packHalf j0 ψ K u) T k = true
  | 0, _, _, _, K, h1, h2 => absurd h2 (by omega)
  | n + 1, K0, D, h, K, h1, h2 => by
    unfold basesN at h
    rw [Bool.and_eq_true] at h
    by_cases hK : K = K0
    · subst hK; exact ⟨_, _, h.1⟩
    · exact basesN_spec n (K0 + 1) (D >>> 17) h.2 K (by omega) (by omega)

theorem tailOK_spec {w : List Bool} {A : List (Nat × Nat)} {φ j0 ψ u D : Nat} (h : tailOK w A φ j0 ψ u D = true) :
    ∃ B, B + 7 ≤ 64 ∧ (∀ K, K < B → ∃ t k, entryOK w A φ 4096 (packHalf j0 ψ K u) t k = true) ∧
      ∀ K, B ≤ K → K < B + 7 → ∃ T k, baseOK w φ j0 ψ (packHalf j0 ψ K u) T k = true := by
  unfold tailOK at h
  simp only [Bool.and_eq_true] at h
  obtain ⟨⟨hB, hd⟩, hb⟩ := h
  exact ⟨D % 64, Nat.le_of_ble_eq_true hB, fun K hK => directN_spec _ 0 _ hd K (by omega) (by omega),
    fun K h1 h2 => basesN_spec 7 _ _ hb K h1 h2⟩

theorem tailsOK_spec {w : List Bool} {A : List (Nat × Nat)} {φ j0 ψ : Nat} :
    ∀ (L : List Nat) (u0 u : Nat), tailsOK w A φ j0 ψ u0 L = true → u0 ≤ u → u < u0 + L.length →
      tailOK w A φ j0 ψ u (L.getD (u - u0) 0) = true
  | [], _, _, _, h1, h2 => absurd h2 (by simp; omega)
  | D :: rest, u0, u, h, h1, h2 => by
    unfold tailsOK at h
    rw [Bool.and_eq_true] at h
    by_cases hu : u = u0
    · subst hu; simpa using h.1
    · have e := tailsOK_spec rest (u0 + 1) u h.2 (by omega) (by simp at h2; omega)
      rw [show u - u0 = (u - (u0 + 1)) + 1 by omega]
      simpa using e

/-- **Every truncation of the aligned ether, followed by the word `u`, enters the family**, given the direct checks
below `B` and a base for each residue modulo 7 at `B .. B + 6`. -/
theorem prefix_absorption {w : List Bool} {A : List (Nat × Nat)} {φ j0 s u D : Nat}
    (hal : aligned w j0 s = true) (hA : (j0, s) ∈ A) (hj0 : j0 < 7)
    (htail : tailOK w A φ j0 ((s + φ) % 4) u D = true) (K : Nat) :
    ∃ a ∈ A, ∃ t1, InFamily (drv (fun t => wordAt w (t + φ)) (prefixHalf j0 ((s + φ) % 4) K u)) a.1 (a.2 + φ) t1 := by
  obtain ⟨B, hlen, hd, hb⟩ := tailOK_spec htail
  have hψ : (s + φ) % 4 < 4 := Nat.mod_lt _ (by omega)
  have hpack : ∀ K, K ≤ 64 → ∀ q, 1 ≤ q →
      prefixHalf j0 ((s + φ) % 4) K u q = (packHalf j0 ((s + φ) % 4) K u).testBit (q - 1) := by
    intro K hK q hq
    rw [testBit_packHalf hj0 hψ hK, show q - 1 + 1 = q by omega]
  by_cases hsmall : K < B
  · obtain ⟨t, k, h⟩ := hd K hsmall
    obtain ⟨-, a, ha, hf⟩ := entryOK_spec h
    exact ⟨a, ha, t, inFamily_of_fast hf fun q hq1 _ => hpack K (by omega) q hq1⟩
  -- a base in the residue class of `K`, then seven columns of ether at a time
  have hc : ∀ t, (fun t => wordAt w (t + φ)) t = ether j0 (t + (s + φ) % 4) := by
    intro t
    show wordAt w (t + φ) = _
    rw [← aligned_spec hal (t + φ)]
    exact ether_congr rfl (by omega)
  obtain ⟨T, k, hbase⟩ := hb (B + (K - B) % 7) (by omega) (by omega)
  unfold baseOK at hbase
  rw [Bool.and_eq_true] at hbase
  obtain ⟨hfam, hclean⟩ := hbase
  have hagree := hpack (B + (K - B) % 7) (by omega)
  have hF := inFamily_of_fast hfam fun q hq1 _ => hagree q hq1
  have hcl : ∀ t, t < T → drv (fun t => wordAt w (t + φ)) (prefixHalf j0 ((s + φ) % 4)
      (B + (K - B) % 7) u) t 1 = ether (j0 + 1) (t + (s + φ) % 4) := by
    intro t ht
    rw [drv_congr (fun q hq => hagree q hq) t 1, ← Rule30EtherThree.rowN_eq_drv]
    exact cleanCheck_spec T hclean t ht
  obtain ⟨hF', -⟩ := shiftN_family hc hcl hF ((K - B) / 7)
  have e : drv (fun t => wordAt w (t + φ)) (shiftN j0 ((s + φ) % 4) ((K - B) / 7)
      (prefixHalf j0 ((s + φ) % 4) (B + (K - B) % 7) u)) =
      drv (fun t => wordAt w (t + φ)) (prefixHalf j0 ((s + φ) % 4) K u) := by
    funext t p
    refine drv_congr (fun q hq => ?_) t p
    rw [shiftN_prefix j0 _ _ u _ q hq]
    congr 1
    omega
  rw [e] at hF'
  exact ⟨(j0, s), hA, T, inFamily_phase (by omega) hF'⟩

/-- `prefix_absorption` for a tail word read from a checked list. -/
theorem prefix_of_tails {w : List Bool} {A : List (Nat × Nat)} {φ j0 s : Nat} {L : List Nat}
    (hal : aligned w j0 s = true) (hA : (j0, s) ∈ A) (hj0 : j0 < 7) (hL : tailsOK w A φ j0 ((s + φ) % 4) 0 L = true)
    (hlen : L.length = 16) (K u : Nat) (hu : u < 16) :
    ∃ b ∈ A, ∃ t1, InFamily (drv (fun t => wordAt w (t + φ)) (prefixHalf j0 ((s + φ) % 4) K u)) b.1 (b.2 + φ) t1 := by
  have h := tailsOK_spec L 0 u hL (Nat.zero_le u) (by omega)
  rw [Nat.sub_zero] at h
  exact prefix_absorption hal hA hj0 h K


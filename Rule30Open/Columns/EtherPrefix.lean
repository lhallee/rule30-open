/-! ### The three words of period four -/

/-- **Every truncation of the aligned ether, followed by a word of at most four cells, enters the family under
`0001`**, for each of its alignments and in every phase. -/
theorem etherPrefix_0001 (φ : Nat) {a : Nat × Nat} (ha : a ∈ A0001) (K u : Nat) (hu : u < 16) :
    ∃ b ∈ A0001, ∃ t1, InFamily (drv (fun t => wordAt w0001 (t + φ)) (prefixHalf a.1 ((a.2 + φ) % 4) K u))
      b.1 (b.2 + φ) t1 := by
  rw [show (a.2 + φ) % 4 = (a.2 + φ % 4) % 4 by omega]
  refine gap_phase ?_
  have hal := A0001_ok a ha
  simp only [A0001, List.mem_cons, List.not_mem_nil, or_false] at ha
  rcases ha with rfl | rfl <;>
    rcases (show φ % 4 = 0 ∨ φ % 4 = 1 ∨ φ % 4 = 2 ∨ φ % 4 = 3 by omega) with h | h | h | h <;> rw [h]
  · exact prefix_of_tails hal (by decide) (by decide) tails0001_5_0_ok rfl K u hu
  · exact prefix_of_tails hal (by decide) (by decide) tails0001_5_1_ok rfl K u hu
  · exact prefix_of_tails hal (by decide) (by decide) tails0001_5_2_ok rfl K u hu
  · exact prefix_of_tails hal (by decide) (by decide) tails0001_5_3_ok rfl K u hu
  · exact prefix_of_tails hal (by decide) (by decide) tails0001_6_0_ok rfl K u hu
  · exact prefix_of_tails hal (by decide) (by decide) tails0001_6_1_ok rfl K u hu
  · exact prefix_of_tails hal (by decide) (by decide) tails0001_6_2_ok rfl K u hu
  · exact prefix_of_tails hal (by decide) (by decide) tails0001_6_3_ok rfl K u hu


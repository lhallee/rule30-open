/-- The rank of a window in the image chain at `W = 14`, read from the bitmaps `rankBit0`, ...: the largest `i ≤ 20`
with the window in the image of every window under `i` double steps. -/
def rank14 (c : Nat) : Nat := (rank14Bit0.testBit c).toNat +
  2 * (rank14Bit1.testBit c).toNat +
  4 * (rank14Bit2.testBit c).toNat +
  8 * (rank14Bit3.testBit c).toNat +
  16 * (rank14Bit4.testBit c).toNat

/-- The limit set at `W = 14`: the windows of rank `20`. -/
def inE14 (c : Nat) : Bool := decide (c < 2 ^ 14) && decide (20 ≤ rank14 c)

/-- Every double step raises the rank by one, up to `20`. -/
def rankStep14 (c : Nat) : Bool :=
  decide (min (rank14 c + 1) 20 ≤ rank14 (chanStep2 14 c false false)) &&
  decide (min (rank14 c + 1) 20 ≤ rank14 (chanStep2 14 c false true)) &&
  decide (min (rank14 c + 1) 20 ≤ rank14 (chanStep2 14 c true false)) &&
  decide (min (rank14 c + 1) 20 ≤ rank14 (chanStep2 14 c true true))


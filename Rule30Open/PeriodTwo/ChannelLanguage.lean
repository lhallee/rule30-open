/-- Every window of `W = 14` columns passes `rankStep14`, checked in 16 pieces of 1024 windows. -/
theorem rank14_all : ∀ c, c < 2 ^ 14 → rankStep14 c = true :=
  allFrom_pieces (e := 4) (d := 10) fun k hk =>
    match k, hk with
    | 0, _ => rank14_ok0
    | 1, _ => rank14_ok1
    | 2, _ => rank14_ok2
    | 3, _ => rank14_ok3
    | 4, _ => rank14_ok4
    | 5, _ => rank14_ok5
    | 6, _ => rank14_ok6
    | 7, _ => rank14_ok7
    | 8, _ => rank14_ok8
    | 9, _ => rank14_ok9
    | 10, _ => rank14_ok10
    | 11, _ => rank14_ok11
    | 12, _ => rank14_ok12
    | 13, _ => rank14_ok13
    | 14, _ => rank14_ok14
    | 15, _ => rank14_ok15
    | n + 16, h => absurd h (by rw [show 2 ^ 4 = 16 from rfl]; omega)

/-- The windows of the limit set, as one bitmap. -/
def eMask14 : Nat := orFrom (fun c => if inE14 c then 2 ^ c else 0) 0 14

/-- The double steps of the windows of the limit set, as one bitmap. -/
def eImage14 : Nat := orFrom (fun c => if inE14 c then 2 ^ chanStep2 14 c false false |||
  2 ^ chanStep2 14 c false true ||| 2 ^ chanStep2 14 c true false ||| 2 ^ chanStep2 14 c true true else 0) 0 14

/-- Every window of the limit set is a double step of one of its windows. -/
theorem back14_ok : (eImage14 == eMask14) = true := by decide +kernel

theorem rankStep14_spec {c : Nat} (hc : c < 2 ^ 14) (x1 x2 : Bool) :
    min (rank14 c + 1) 20 ≤ rank14 (chanStep2 14 c x1 x2) := by
  have h := rank14_all c hc
  simp only [rankStep14, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := h
  cases x1 <;> cases x2 <;> assumption

theorem rank14_reach : ∀ (s c : Nat), Reach 14 s c → min s 20 ≤ rank14 c
  | 0, _, _ => by simp
  | s + 1, c, h => by
    obtain ⟨q, x1, x2, hq, rfl⟩ := reach_last h
    have ih := rank14_reach s q hq
    rw [← chanStep2_mod]
    have hr : min s 20 ≤ rank14 (q % 2 ^ 14) := by
      rcases Nat.eq_zero_or_pos s with hs | hs
      · simp [hs]
      · rwa [Nat.mod_eq_of_lt (reach_lt hs hq)]
    have := rankStep14_spec (Nat.mod_lt q (Nat.two_pow_pos _)) x1 x2
    omega

theorem inE14_back {c : Nat} (h : inE14 c = true) :
    ∃ q x1 x2, inE14 q = true ∧ c = chanStep2 14 q x1 x2 := by
  have hc : c < 2 ^ 14 := by simp only [inE14, Bool.and_eq_true, decide_eq_true_eq] at h; exact h.1
  have hm : eMask14.testBit c = true := by
    unfold eMask14
    refine orFrom_of (Nat.zero_le _) (by omega) ?_
    simp only [h, ite_true, Nat.testBit_two_pow_self]
  have e := back14_ok
  rw [beq_iff_eq] at e
  rw [← e] at hm
  obtain ⟨q, -, -, hq⟩ := orFrom_spec hm
  by_cases hE : inE14 q = true
  · simp only [hE, ite_true, Nat.testBit_or, Bool.or_eq_true, Nat.testBit_two_pow, decide_eq_true_eq] at hq
    rcases hq with ((h1 | h1) | h1) | h1
    · exact ⟨q, false, false, hE, h1.symm⟩
    · exact ⟨q, false, true, hE, h1.symm⟩
    · exact ⟨q, true, false, hE, h1.symm⟩
    · exact ⟨q, true, true, hE, h1.symm⟩
  · simp [hE] at hq

theorem inE14_reach : ∀ (n c : Nat), inE14 c = true → Reach 14 n c
  | 0, c, _ => reach_zero _ c
  | n + 1, c, h => by
    obtain ⟨q, x1, x2, hq, rfl⟩ := inE14_back h
    exact reach_step (inE14_reach n q hq) x1 x2

end ChannelLanguage

open ChannelLanguage

/-- **The limit set at `W = 14` is explicit**: a window is in it exactly when it is one of the windows of rank `20`
in the bitmaps. -/
theorem channel14_limit (c : Nat) : InLimit 14 c ↔ inE14 c = true := by
  constructor
  · intro h
    have hr := rank14_reach 20 c (h 20)
    simp only [inE14, Bool.and_eq_true, decide_eq_true_eq]
    exact ⟨reach_lt (by omega) (h 20), by simpa using hr⟩
  · intro h n
    exact inE14_reach n c h

/-- **Every right half enters the limit set at `W = 14` by the white step `20`**, finite or not, and stays. -/
theorem channel14_entry (R : Nat → Bool) (s : Nat) (hs : 20 ≤ s) : inE14 (chanWin 14 R (2 * s + 1)) = true := by
  have hr := rank14_reach s _ (chanWin_reach 14 R s)
  simp only [inE14, Bool.and_eq_true, decide_eq_true_eq]
  exact ⟨chanWin_lt _ _ _, by omega⟩

/-- **`Q01Right 14` with the explicit limit set**: the hypothesis of `cq01_of_q01Right` at `W = 14` is a statement
about paths in the `inE14` windows. -/
theorem q01Right14_iff : Q01Right 14 ↔ ∀ L : Nat → Bool, FinSupp L → InX L →
    ¬ ∃ (s0 : Nat) (w : Nat → Nat), ∀ s, s0 ≤ s → inE14 (w s) = true ∧
      (∃ x1 x2, w (s + 1) = chanStep2 14 (w s) x1 x2) ∧ (w s).testBit 0 = !zrow L (2 * s + 1) 1 := by
  simp only [Q01Right, channel14_limit]

end Rule30Open

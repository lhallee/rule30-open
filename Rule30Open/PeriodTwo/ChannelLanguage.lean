module

public import Ruliology.CellularAutomata.Rule30PeriodTwoSideways
public import Ruliology.CellularAutomata.Rule30EtherThreeReach

/-!
# Period two from one statement about left halves: the exact right channel

Drive a right half `R` with the alternating column (the kit's `altCol`, black at the even steps) and read its columns
`1..W` at the odd times `2 s + 1`, the white steps of the center, as a number (`chanWin`, bit `i` is column `i + 1`).
Two steps later the window is a double step of it (`chanStep2`), for the two values that column `W + 1` takes at the
two steps, which the window does not determine. A window is in the *limit set* (`InLimit W`) when it ends paths of
double steps of every length. Column `1` at the white steps is the kit's `u R`, whose complement is the sequence of
free bits of the one left row `Psi R` that keeps the center alternating against `R`.

* `chanWin_reach`, `exists_entry`: there is an `N`, for each `W`, such that the window of every right half, finite or
  not, lies in the limit set at every white step `s ≥ N`. The windows of `W` columns are finitely many, so the sets of
  ends of paths of length `n`, which decrease with `n`, stop decreasing.
* `Q01Right W`: no finitely supported constrained start `L` of the zero-boundary left half has, from some white step
  `s0` on, free bits whose complement is column `1` along a path of double steps inside the limit set. It follows from
  the kit's `Q01` (`q01Right_of_q01`), which excludes every finitely supported constrained start.
* `cq01_of_q01Right`: for every `W ≥ 1`, `Q01Right W` implies the kit's `CQ01`, so
  `no_eventual_period_two_of_q01Right`: the center column of the single cell is not eventually of period two. No entry
  hypothesis on the right half is needed: every right half is in the limit set from step `N` on.
* At `W = 14` the limit set is explicit: `channel14_limit` says it is the set `inE14` of `2436` windows, the windows
  of rank `20` in the image chain, whose ranks the module lists as bitmaps; `channel14_entry` says that every right
  half has its window in it from the white step `20` on; and `q01Right14_iff` states `Q01Right 14` with this set. The
  kernel checks that every double step raises the rank by one up to `20` (`rank14_all`, in `16` pieces of `1024`
  windows) and that the windows of rank `20` are exactly the double steps of windows of rank `20` (`back14_ok`).

The natural-language argument is `ChannelLanguage.md`, beside this file.
-/

@[expose] public section

-- Sequential elaboration: the kernel checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Rule30Open

open Ruliology.CellularAutomata
open Rule30ZeroBoundary Rule30PeriodTwoSideways Rule30PeriodTwoCoupled Rule30Ether Rule30StripCertificates
  Rule30Jen Rule30EtherThree

namespace ChannelLanguage

/-! ### Windows as numbers and the double step -/

/-- One step of a window of the columns `1..W`, coded as a number (bit `i` is column `i + 1`; only the bits below `W`
count): `a` is column `0` and `x` column `W + 1`. -/
def chanStep (W : Nat) (a x : Bool) (c : Nat) : Nat :=
  stepN a (c % 2 ^ W ||| x.toNat <<< W) % 2 ^ W

/-- The double step from a white step of the center: column `0` is white, then black, and `x1`, `x2` are the two
values of column `W + 1`. -/
def chanStep2 (W c : Nat) (x1 x2 : Bool) : Nat :=
  chanStep W true x2 (chanStep W false x1 c)

/-- The code of the columns `1..n` of a row `f`. -/
def chanCode : Nat → (Nat → Bool) → Nat
  | 0, _ => 0
  | n + 1, f => (f 1).toNat + 2 * chanCode n (fun p => f (p + 1))

theorem testBit_chanCode : ∀ (n : Nat) (f : Nat → Bool) (i : Nat),
    (chanCode n f).testBit i = (decide (i < n) && f (i + 1))
  | 0, f, i => by simp [chanCode]
  | n + 1, f, 0 => by
    simp only [chanCode]
    cases h : f 1 <;> simp [Nat.testBit_zero] <;> omega
  | n + 1, f, i + 1 => by
    simp only [chanCode]
    have e : ((f 1).toNat + 2 * chanCode n (fun p => f (p + 1))) / 2 = chanCode n (fun p => f (p + 1)) := by
      cases f 1 <;> simp <;> omega
    rw [Nat.testBit_succ, e, testBit_chanCode n _ i]
    simp

theorem chanCode_lt : ∀ (n : Nat) (f : Nat → Bool), chanCode n f < 2 ^ n
  | 0, _ => by simp [chanCode]
  | n + 1, f => by
    have h := chanCode_lt n (fun p => f (p + 1))
    have hb : (f 1).toNat ≤ 1 := Bool.toNat_le _
    simp only [chanCode, Nat.pow_succ]
    omega

theorem testBit_pad (W c j : Nat) (x : Bool) (hj : j ≤ W) :
    (c % 2 ^ W ||| x.toNat <<< W).testBit j = if j < W then c.testBit j else x := by
  rw [Nat.testBit_or, Nat.testBit_mod_two_pow, Nat.testBit_shiftLeft, testBit_toNat]
  by_cases h : j < W
  · simp [h, show ¬ (W ≤ j) by omega]
  · have : j = W := by omega
    subst this
    simp

theorem chanStep_lt (W : Nat) (a x : Bool) (c : Nat) : chanStep W a x c < 2 ^ W :=
  Nat.mod_lt _ (Nat.two_pow_pos W)

theorem chanStep2_lt (W c : Nat) (x1 x2 : Bool) : chanStep2 W c x1 x2 < 2 ^ W := chanStep_lt _ _ _ _

theorem chanStep_mod (W : Nat) (a x : Bool) (c : Nat) : chanStep W a x (c % 2 ^ W) = chanStep W a x c := by
  unfold chanStep; rw [Nat.mod_mod]

theorem chanStep2_mod (W c : Nat) (x1 x2 : Bool) : chanStep2 W (c % 2 ^ W) x1 x2 = chanStep2 W c x1 x2 := by
  unfold chanStep2; rw [chanStep_mod]

/-- **One step of the row is one step of its code.** -/
theorem chanCode_drv_succ (W : Nat) (c R : Nat → Bool) (t : Nat) :
    chanCode W (drv c R (t + 1)) = chanStep W (c t) (drv c R t (W + 1)) (chanCode W (drv c R t)) := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [testBit_chanCode]
  unfold chanStep
  rw [Nat.testBit_mod_two_pow]
  by_cases hi : i < W
  · simp only [hi, decide_true, Bool.true_and]
    rw [testBit_stepN, testBit_pad W _ (i - 1) _ (by omega), testBit_pad W _ i _ (by omega),
      testBit_pad W _ (i + 1) _ (by omega)]
    show rule (drv c R t i) (drv c R t (i + 1)) (drv c R t (i + 2)) = _
    have l : (if i = 0 then c t else if i - 1 < W then (chanCode W (drv c R t)).testBit (i - 1)
        else drv c R t (W + 1)) = drv c R t i := by
      by_cases h0 : i = 0
      · subst h0; simp [drv_col0]
      · rw [ite_eq_right h0, ite_eq_left (by omega : i - 1 < W), testBit_chanCode, decide_eq_true (by omega : i - 1 < W),
          Bool.true_and, show i - 1 + 1 = i by omega]
    have m : (if i < W then (chanCode W (drv c R t)).testBit i else drv c R t (W + 1)) = drv c R t (i + 1) := by
      rw [ite_eq_left hi, testBit_chanCode, decide_eq_true hi, Bool.true_and]
    have r : (if i + 1 < W then (chanCode W (drv c R t)).testBit (i + 1) else drv c R t (W + 1)) =
        drv c R t (i + 2) := by
      by_cases h1 : i + 1 < W
      · rw [ite_eq_left h1, testBit_chanCode, decide_eq_true h1, Bool.true_and]
      · rw [ite_eq_right h1, show W + 1 = i + 2 by omega]
    rw [l, m, r]
  · simp [hi]

/-- The window of `R`: its columns `1..W` driven by the alternating column, at time `t`, as a number. -/
def chanWin (W : Nat) (R : Nat → Bool) (t : Nat) : Nat := chanCode W (drv altCol R t)

theorem chanWin_lt (W : Nat) (R : Nat → Bool) (t : Nat) : chanWin W R t < 2 ^ W := chanCode_lt _ _

/-- From an odd time, the window two steps later is a double step of the window. -/
theorem chanWin_step2 (W : Nat) (R : Nat → Bool) (t : Nat) (ht : t % 2 = 1) :
    chanWin W R (t + 2) = chanStep2 W (chanWin W R t) (drv altCol R t (W + 1)) (drv altCol R (t + 1) (W + 1)) := by
  have a1 : altCol t = false := by unfold altCol; simp [ht]
  have a2 : altCol (t + 1) = true := by unfold altCol; simp; omega
  unfold chanWin chanStep2
  rw [chanCode_drv_succ, chanCode_drv_succ, a1, a2]

/-- Bit `0` of the window is column `1`. -/
theorem chanWin_col1 {W : Nat} (hW : 1 ≤ W) (R : Nat → Bool) (t : Nat) :
    (chanWin W R t).testBit 0 = drv altCol R t 1 := by
  unfold chanWin
  rw [testBit_chanCode, decide_eq_true (by omega : 0 < W), Bool.true_and]

/-! ### The limit set -/

/-- `c` ends a path of `n` double steps. -/
def Reach (W n c : Nat) : Prop :=
  ∃ p : Nat → Nat, p n = c ∧ ∀ i, i < n → ∃ x1 x2, p (i + 1) = chanStep2 W (p i) x1 x2

/-- **The limit set**: the windows that end paths of double steps of every length. -/
def InLimit (W c : Nat) : Prop := ∀ n, Reach W n c

theorem reach_zero (W c : Nat) : Reach W 0 c := ⟨fun _ => c, rfl, fun _ h => absurd h (Nat.not_lt_zero _)⟩

theorem reach_step {W n c : Nat} (h : Reach W n c) (x1 x2 : Bool) : Reach W (n + 1) (chanStep2 W c x1 x2) := by
  obtain ⟨p, hp, hs⟩ := h
  refine ⟨fun i => if i ≤ n then p i else chanStep2 W c x1 x2, ite_eq_right (by omega), fun i hi => ?_⟩
  by_cases h : i < n
  · obtain ⟨y1, y2, e⟩ := hs i h
    exact ⟨y1, y2, by
      show (if i + 1 ≤ n then p (i + 1) else _) = chanStep2 W (if i ≤ n then p i else _) y1 y2
      rw [ite_eq_left (show i + 1 ≤ n by omega), ite_eq_left (show i ≤ n by omega)]; exact e⟩
  · have : i = n := by omega
    subst this
    exact ⟨x1, x2, by
      show (if i + 1 ≤ i then p (i + 1) else _) = chanStep2 W (if i ≤ i then p i else _) x1 x2
      rw [ite_eq_right (show ¬ (i + 1 ≤ i) by omega), ite_eq_left (Nat.le_refl i), hp]⟩

theorem reach_last {W n c : Nat} (h : Reach W (n + 1) c) :
    ∃ q x1 x2, Reach W n q ∧ c = chanStep2 W q x1 x2 := by
  obtain ⟨p, hp, hs⟩ := h
  obtain ⟨x1, x2, e⟩ := hs n (by omega)
  exact ⟨p n, x1, x2, ⟨p, rfl, fun i hi => hs i (by omega)⟩, by rw [← hp, e]⟩

theorem reach_pred {W n c : Nat} (h : Reach W (n + 1) c) : Reach W n c := by
  obtain ⟨p, hp, hs⟩ := h
  exact ⟨fun i => p (i + 1), hp, fun i hi => hs (i + 1) (by omega)⟩

theorem reach_le {W m n c : Nat} (hmn : m ≤ n) (h : Reach W n c) : Reach W m c := by
  induction n with
  | zero => rwa [Nat.le_zero.1 hmn]
  | succ n ih =>
    rcases Nat.lt_or_ge m (n + 1) with hm | hm
    · exact ih (by omega) (reach_pred h)
    · rwa [show m = n + 1 by omega]

theorem reach_lt {W n c : Nat} (hn : 1 ≤ n) (h : Reach W n c) : c < 2 ^ W := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  obtain ⟨q, x1, x2, -, rfl⟩ := reach_last h
  exact chanStep2_lt _ _ _ _

/-- The ends of paths of `N` double steps are in the limit set, for some `N`: finitely many windows each leave the
decreasing sets of ends at some length, or never. -/
theorem exists_stable (W : Nat) : ∃ N, 1 ≤ N ∧ ∀ c, Reach W N c → InLimit W c := by
  have key : ∀ M, ∃ N, 1 ≤ N ∧ ∀ c, c < M → (∃ n, ¬ Reach W n c) → ¬ Reach W N c := by
    intro M
    induction M with
    | zero => exact ⟨1, Nat.le_refl _, fun c hc => absurd hc (Nat.not_lt_zero _)⟩
    | succ M ih =>
      obtain ⟨N, hN1, hN⟩ := ih
      by_cases hM : ∃ n, ¬ Reach W n M
      · obtain ⟨n, hn⟩ := hM
        refine ⟨max N n, Nat.le_trans hN1 (Nat.le_max_left _ _), fun c hc hex hr => ?_⟩
        rcases Nat.lt_or_ge c M with h | h
        · exact hN c h hex (reach_le (Nat.le_max_left _ _) hr)
        · rw [show c = M by omega] at hr
          exact hn (reach_le (Nat.le_max_right _ _) hr)
      · refine ⟨N, hN1, fun c hc hex hr => ?_⟩
        rcases Nat.lt_or_ge c M with h | h
        · exact hN c h hex hr
        · rw [show c = M by omega] at hex
          exact hM hex
  obtain ⟨N, hN1, hN⟩ := key (2 ^ W)
  refine ⟨N, hN1, fun c hr n => ?_⟩
  have hc : c < 2 ^ W := reach_lt hN1 hr
  exact Classical.byContradiction fun hn => hN c hc ⟨n, hn⟩ hr

/-- The window of `R` at the white step `s` ends a path of `s` double steps. -/
theorem chanWin_reach (W : Nat) (R : Nat → Bool) (s : Nat) : Reach W s (chanWin W R (2 * s + 1)) := by
  refine ⟨fun i => chanWin W R (2 * i + 1), rfl, fun i _ => ?_⟩
  refine ⟨drv altCol R (2 * i + 1) (W + 1), drv altCol R (2 * i + 1 + 1) (W + 1), ?_⟩
  show chanWin W R (2 * (i + 1) + 1) = chanStep2 W (chanWin W R (2 * i + 1)) _ _
  rw [show 2 * (i + 1) + 1 = 2 * i + 1 + 2 by omega]
  exact chanWin_step2 W R (2 * i + 1) (by omega)

/-- **Entry into the limit set.** For each `W` there is an `N` such that every right half, finite or not, has its
window in the limit set at every white step `s ≥ N`. -/
theorem exists_entry (W : Nat) : ∃ N, ∀ (R : Nat → Bool) (s : Nat), N ≤ s → InLimit W (chanWin W R (2 * s + 1)) := by
  obtain ⟨N, -, hN⟩ := exists_stable W
  exact ⟨N, fun R s hs => hN _ (reach_le hs (chanWin_reach W R s))⟩

/-! ### The hypothesis on the left half -/

/-- **`Q01Right W`**: no finitely supported constrained start `L` of the zero-boundary left half has, from some white
step `s0` on, the complement of its free bits equal to column `1` along a path of double steps inside the limit set of
the windows of `W` columns. -/
def Q01Right (W : Nat) : Prop := ∀ L : Nat → Bool, FinSupp L → InX L →
  ¬ ∃ (s0 : Nat) (w : Nat → Nat), ∀ s, s0 ≤ s → InLimit W (w s) ∧
    (∃ x1 x2, w (s + 1) = chanStep2 W (w s) x1 x2) ∧ (w s).testBit 0 = !zrow L (2 * s + 1) 1

end ChannelLanguage

open ChannelLanguage

/-- **`Q01` implies `Q01Right W`** for every `W`. -/
theorem q01Right_of_q01 (hQ : Q01) (W : Nat) : Q01Right W := fun L hL hX _ => hQ L hL hX

/-- **The left row against any right half.** Under `Q01Right W` with `W ≥ 1`, the one left row `Psi R` that keeps the
center alternating against a right half `R`, finite or not, has infinitely many black cells. -/
theorem not_finSupp_Psi_of_q01Right {W : Nat} (hW : 1 ≤ W) (h : Q01Right W) (R : Nat → Bool) :
    ¬ FinSupp (Psi R) := by
  intro hfin
  obtain ⟨N, hN⟩ := exists_entry W
  refine h (Psi R) hfin (Psi_inX R) ⟨N, fun s => chanWin W R (2 * s + 1), fun s hs => ⟨hN R s hs, ?_, ?_⟩⟩
  · refine ⟨drv altCol R (2 * s + 1) (W + 1), drv altCol R (2 * s + 1 + 1) (W + 1), ?_⟩
    show chanWin W R (2 * (s + 1) + 1) = _
    rw [show 2 * (s + 1) + 1 = 2 * s + 1 + 2 by omega]
    exact chanWin_step2 W R (2 * s + 1) (by omega)
  · rw [chanWin_col1 hW, Psi_free, Bool.not_not]

/-- **Period two from `Q01Right`.** For every `W ≥ 1`, `Q01Right W` implies the kit's `CQ01`. -/
theorem cq01_of_q01Right {W : Nat} (hW : 1 ≤ W) (h : Q01Right W) : CQ01 :=
  CQ01_iff_Psi.2 fun R _ => not_finSupp_Psi_of_q01Right hW h R

/-- **The single cell.** Under `Q01Right W` with `W ≥ 1`, the center column of the single black cell is not
eventually of period two. -/
theorem no_eventual_period_two_of_q01Right {W : Nat} (hW : 1 ≤ W) (h : Q01Right W) :
    ¬ ∃ T0, ∀ t, T0 ≤ t → Rule30Prize.center (t + 2) = Rule30Prize.center t :=
  no_eventual_period_two_of_CQ01 (cq01_of_q01Right hW h)

/-! ### The limit set at `W = 14`, by the kernel -/

namespace ChannelLanguage

/-- `p` holds at every number of `[lo, lo + 2 ^ d)`, split in halves so that the recursion is `d` deep. -/
def allFrom (p : Nat → Bool) (lo : Nat) : Nat → Bool
  | 0 => p lo
  | d + 1 => allFrom p lo d && allFrom p (lo + 2 ^ d) d

theorem allFrom_spec {p : Nat → Bool} : ∀ {lo d : Nat}, allFrom p lo d = true →
    ∀ c, lo ≤ c → c < lo + 2 ^ d → p c = true
  | lo, 0, h, c, h1, h2 => by
    rw [show c = lo by simp at h2; omega]; exact h
  | lo, d + 1, h, c, h1, h2 => by
    simp only [allFrom, Bool.and_eq_true] at h
    rw [Nat.pow_succ] at h2
    rcases Nat.lt_or_ge c (lo + 2 ^ d) with hc | hc
    · exact allFrom_spec h.1 c h1 hc
    · exact allFrom_spec h.2 c hc (by omega)

/-- The bitwise or of `g c` over `[lo, lo + 2 ^ d)`. -/
def orFrom (g : Nat → Nat) (lo : Nat) : Nat → Nat
  | 0 => g lo
  | d + 1 => orFrom g lo d ||| orFrom g (lo + 2 ^ d) d

theorem orFrom_spec {g : Nat → Nat} {b : Nat} : ∀ {lo d : Nat}, (orFrom g lo d).testBit b = true →
    ∃ c, lo ≤ c ∧ c < lo + 2 ^ d ∧ (g c).testBit b = true
  | lo, 0, h => ⟨lo, Nat.le_refl _, by simp, h⟩
  | lo, d + 1, h => by
    simp only [orFrom, Nat.testBit_or, Bool.or_eq_true] at h
    rcases h with h | h
    · obtain ⟨c, h1, h2, h3⟩ := orFrom_spec h
      exact ⟨c, h1, by rw [Nat.pow_succ]; omega, h3⟩
    · obtain ⟨c, h1, h2, h3⟩ := orFrom_spec h
      exact ⟨c, by omega, by rw [Nat.pow_succ]; omega, h3⟩

theorem orFrom_of {g : Nat → Nat} {b : Nat} : ∀ {lo d c : Nat}, lo ≤ c → c < lo + 2 ^ d →
    (g c).testBit b = true → (orFrom g lo d).testBit b = true
  | lo, 0, c, h1, h2, h => by
    rw [show c = lo by simp at h2; omega] at h; exact h
  | lo, d + 1, c, h1, h2, h => by
    simp only [orFrom, Nat.testBit_or, Bool.or_eq_true]
    rw [Nat.pow_succ] at h2
    rcases Nat.lt_or_ge c (lo + 2 ^ d) with hc | hc
    · exact Or.inl (orFrom_of h1 hc h)
    · exact Or.inr (orFrom_of hc (by omega) h)

theorem allFrom_pieces {p : Nat → Bool} {e d : Nat} (h : ∀ k, k < 2 ^ e → allFrom p (k * 2 ^ d) d = true) :
    ∀ c, c < 2 ^ (e + d) → p c = true := by
  intro c hc
  have hd : 0 < 2 ^ d := Nat.two_pow_pos d
  have hk : c / 2 ^ d < 2 ^ e := by
    apply Nat.div_lt_of_lt_mul
    rw [← Nat.pow_add, Nat.add_comm]
    exact hc
  have h1 := Nat.div_add_mod c (2 ^ d)
  have h2 := Nat.mod_lt c hd
  rw [Nat.mul_comm] at h1
  exact allFrom_spec (h _ hk) c (by omega) (by omega)

